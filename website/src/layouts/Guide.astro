---
import Base from "./Base.astro";
import "../styles/guide.css";
import { chapters, neighbours, parts } from "../lib/guide/chapters";

interface Props {
  slug: string;
  /** What the reader will be able to do after the chapter: three lines at most. */
  outcomes: string[];
}

const { slug, outcomes } = Astro.props;
const { index, chapter, previous, next } = neighbours(slug);
const number = (i: number) => String(i + 1).padStart(2, "0");
---

<Base title={`${chapter.title} · Guide airtty`} description={chapter.question} lang="fr">
  <div class="guide">
    <header class="top">
      <div class="top-inner">
        <a class="mark" href="/guide/">air<span class="c">tty</span> <span class="slash">/</span> guide</a>
        <p class="where"><span>{number(index)}</span> / {String(chapters.length).padStart(2, "0")}</p>
        <a class="site" href="/">Le site</a>
      </div>
      <div class="progress" style={`--done: ${(index + 1) / chapters.length}`} aria-hidden="true"></div>
    </header>

    <div class="shell">
      <nav class="toc" aria-label="Chapitres du guide">
        <details open>
          <summary>Chapitres</summary>
          <a class="home" href="/guide/">Sommaire</a>
          {
            parts.map((part) => (
              <div class="part">
                <p>{part}</p>
                <ol>
                  {chapters.map((item, i) =>
                    item.part === part ? (
                      <li><a href={`/guide/${item.slug}/`} aria-current={item.slug === slug ? "page" : undefined} class:list={{ read: i < index }} > <span class="n">{number(i)}</span> {item.title} </a></li>
                    ) : null,
                  )}
                </ol>
              </div>
            ))
          }
        </details>
      </nav>

      <article>
        <header class="head">
          <p class="kicker">Chapitre {number(index)} · {chapter.part}</p>
          <h1>{chapter.title}</h1>
          <p class="question">{chapter.question}</p>
          <div class="after">
            <p>À la fin de ce chapitre, tu sauras :</p>
            <ul>{outcomes.map((outcome) => <li set:html={outcome} />)}</ul>
            <p class="minutes">{chapter.minutes} min de lecture</p>
          </div>
        </header>

        <slot />

        <nav class="pager" aria-label="Chapitre précédent et suivant">
          {
            previous ? (
              <a class="prev" href={`/guide/${previous.slug}/`}>
                <span>← Précédent</span>
                {previous.title}
              </a>
            ) : (
              <a class="prev" href="/guide/">
                <span>← Sommaire</span>Le guide
              </a>
            )
          }
          {
            next && (
              <a class="next" href={`/guide/${next.slug}/`}>
                <span>Suivant →</span>
                {next.title}
              </a>
            )
          }
        </nav>
      </article>
    </div>
  </div>
</Base>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: rgb(7 11 18 / 0.8);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .top-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: calc(1180px + 2 * var(--gutter));
    height: 54px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    font-size: 0.82rem;
  }

  .mark {
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .slash {
    color: var(--dim);
    font-weight: 400;
  }

  .where {
    margin-left: auto;
    color: var(--dim);
  }

  .where span {
    color: var(--paper);
  }

  .site {
    color: var(--mist);
    text-decoration: none;
  }

  .progress {
    height: 2px;
    background: linear-gradient(90deg, var(--client), var(--server)) 0 0 / calc(var(--done) * 100%) 100% no-repeat;
  }

  .toc {
    position: sticky;
    top: 54px;
    align-self: start;
    max-height: calc(100vh - 54px);
    padding: 40px 0 24px;
    overflow-y: auto;
    font-size: 0.8rem;
    scrollbar-width: thin;
  }

  summary {
    display: none;
  }

  .home {
    display: block;
    margin-bottom: 18px;
    color: var(--mist);
    text-decoration: none;
  }

  .part + .part {
    margin-top: 20px;
  }

  .part p {
    margin-bottom: 6px;
    color: var(--dim);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .part ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .part a {
    display: flex;
    gap: 10px;
    padding: 5px 10px;
    border-left: 1px solid var(--rule);
    color: var(--mist);
    line-height: 1.45;
    text-decoration: none;
  }

  .part a:hover {
    color: var(--paper);
  }

  .n {
    color: var(--dim);
  }

  .part a.read .n {
    color: var(--client);
  }

  .part a[aria-current="page"] {
    border-left: 2px solid var(--client);
    padding-left: 9px;
    color: var(--paper);
    background: linear-gradient(90deg, var(--client-soft), transparent);
  }

  .head {
    padding-bottom: 8px;
  }

  .kicker {
    color: var(--client);
    font: 400 0.78rem / 1.5 var(--mono);
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
  }

  .question {
    margin-top: 16px;
    color: var(--mist);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .after {
    margin-top: 28px;
    padding: 16px 20px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: rgb(255 255 255 / 0.02);
    font-size: 0.92rem;
  }

  .after > p:first-child {
    color: var(--mist);
  }

  .after ul {
    margin: 6px 0 0;
  }

  .minutes {
    margin-top: 10px;
    color: var(--dim);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 72px;
  }

  .pager a {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    color: var(--paper);
    font: 500 0.95rem / 1.4 var(--mono);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .pager a:hover {
    border-color: var(--client);
    background: var(--client-soft);
  }

  .pager span {
    color: var(--dim);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 900px) {
    .toc {
      position: static;
      max-height: none;
      padding: 16px 0 0;
    }

    summary {
      display: block;
      padding: 10px 14px;
      border: 1px solid var(--rule-strong);
      border-radius: 8px;
      color: var(--mist);
      cursor: pointer;
    }

    details[open] summary {
      margin-bottom: 16px;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .next {
      grid-column: 1;
    }
  }
</style>

<script>
  // On a phone the chapter list starts closed: the article comes first.
  if (matchMedia("(max-width: 900px)").matches) {
    document.querySelector(".toc details")?.removeAttribute("open");
  }
</script>
