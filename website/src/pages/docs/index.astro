---
// The entry of the documentation: every section and page, in the order of the sidebar.
import { getCollection } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { href, sections } from "../../lib/docs/nav";
import { name } from "../../lib/product";

const entries = new Map((await getCollection("docs")).map((entry) => [entry.id, entry.data]));
---

<Docs
  title="Documentation"
  description={`How to build, run and ship terminal apps with ${name}: concepts, guides and a reference checked against the code.`}
>
  <p>
    Start with the first steps, then read the concepts in order: each leans on the ones before
    it. The guides take one task each; the reference lists what the code defines, and links
    to it.
  </p>
  <p>
    Already using luciole? <a href={href("reference/releases")}>Releases and upgrades</a> gives the
    current version and how to move an app to a new one.
  </p>
  {
    sections.map((section) => (
      <section class="overview-section">
        <h2>{section.title}</h2>
        <p class="summary">{section.summary}</p>
        <dl>
          {section.pages.map((page) => (
            <>
              <dt>
                <a href={href(page)}>{entries.get(page)?.title ?? page}</a>
              </dt>
              <dd>{entries.get(page)?.description}</dd>
            </>
          ))}
        </dl>
      </section>
    ))
  }
</Docs>

<style>
  .overview-section dl {
    display: grid;
    grid-template-columns: minmax(12ch, max-content) minmax(0, 1fr);
    gap: 8px 28px;
    margin: 0;
  }

  .overview-section dt {
    font: 500 0.92rem / 1.6 var(--mono);
  }

  .overview-section dd {
    margin: 0;
    color: var(--mist);
    font-size: 0.95rem;
  }

  .summary {
    color: var(--mist);
  }

  @media (max-width: 560px) {
    .overview-section dl {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .overview-section dd {
      margin-bottom: 12px;
    }
  }
</style>
