---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServerSide from "../components/ServerSide.astro";
import Uses from "../components/Uses.astro";
import Start from "../components/Start.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="airtty: build terminal apps with React"
  description="An experimental framework for terminal apps in React. React Server Components render on a server; a native terminal client keeps typing and scrolling local. Coding-agent interfaces, code review, document readers."
  image="/og.png"
>
  <Header />
  <main>
    <Hero />
    <ServerSide />
    <Uses />
    <Start />
  </main>
  <Footer />
</Base>
