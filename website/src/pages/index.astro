---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Wire from "../components/Wire.astro";
import Apps from "../components/Apps.astro";
import Ship from "../components/Ship.astro";
import Trust from "../components/Trust.astro";
import Toolbox from "../components/Toolbox.astro";
import Limits from "../components/Limits.astro";
import Start from "../components/Start.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="airtty: terminal apps, built like web apps"
  description="An open-source React Server Components framework for the terminal: Server-rendered pages, a native terminal Client, one binary, open over SSH or by URL."
>
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <Wire />
    <Apps />
    <Ship />
    <Trust />
    <Toolbox />
    <Limits />
    <Start />
  </main>
  <Footer />
</Base>
