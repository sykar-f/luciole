---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServerSide from "../components/ServerSide.astro";
import Anywhere from "../components/Anywhere.astro";
import Start from "../components/Start.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="luciole: React Server Components in your terminal"
  description="An experimental framework that splits a React terminal app in two: Server Components render next to your data, a native terminal Client keeps every key and scroll local. Local, over SSH, from a URL or in a web page."
  image="/og.png"
>
  <Header />
  <main id="main">
    <Hero />
    <ServerSide />
    <Anywhere />
    <Start />
  </main>
  <Footer />
</Base>
