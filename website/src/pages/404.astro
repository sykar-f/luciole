---
// A page that does not exist: the mascot with its lantern almost off (design/mascot/,
// out/still-404.png), and the ways back.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Not found · luciole" description="This page does not exist." hidden>
  <Header />
  <main class="section">
    <div class="wrap notfound">
      <img class="mascot" src="/mascot/still-404.png" width="258" height="339" alt="" />
      <div>
        <p class="label">404</p>
        <h1>Nothing lit here.</h1>
        <p class="lede">This page does not exist, or not anymore.</p>
        <div class="next">
          <a class="button primary" href="/">Back home</a>
          <a class="button" href="/docs/">Docs</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }

  .mascot {
    image-rendering: pixelated;
  }

  h1 {
    margin: 4px 0;
    font: 600 2rem / 1.2 var(--mono);
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 760px) {
    .notfound {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }

    .mascot {
      align-self: center;
      width: 172px;
      height: 226px;
    }
  }
</style>
