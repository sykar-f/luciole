---
// One source, the targets `airtty build` makes of it: a list on the left, and on the right
// a frame that draws each one where it runs. Every scene is the same drawing: the client
// (a terminal, as the icon of the code section draws one) at the same place on the left, the
// server (its cylinder) on the right, never moving from one scene to the next. Only what
// changes with the target changes: the frame around what shares a machine, the link
// between the two sides (solid on one machine, dashed across the network), and one detail
// below. A target built two ways (the web page) shows both in turn, on a slide twice as
// long. It moves on by itself, the list following, and stops while the reader points at it
// or picks one. The commands and the facts are those docs/ gives (README,
// DISTRIBUTION.md, WEB.md).

// What holds the client: a computer, the executable, a browser. With a `host`, the frame
// holds the client alone and the server is drawn on that host.
type Frame = "machine" | "file" | "browser";
type View = {
  command: string;
  what: string;
  frame: Frame;
  // The host the server runs on, when not with the client.
  host?: string;
  // The link between the two sides, as the drawing names it; `remote` when it crosses a network.
  link: { name: string; remote?: boolean };
  // The one line under the drawing, when the view has one; `signed` puts the bundle before it.
  note?: string;
  signed?: boolean;
};
type Target = {
  id: "local" | "binary" | "ssh" | "url" | "web";
  name: string;
  label: string;
  views: [View] | [View, View];
};
const targets: Target[] = [
  {
    id: "local",
    name: "Local",
    label: "The client and the server on your machine, joined by a unix socket",
    views: [
      {
        command: "airtty ./notes",
        what: "both sides on your machine, over a private socket",
        frame: "machine",
        link: { name: "unix socket" },
        note: "no port opened, no network",
      },
    ],
  },
  {
    id: "binary",
    name: "One executable",
    label: "The client and the server in one executable, one file per OS and architecture",
    views: [
      {
        command: "airtty build --compile",
        what: "per OS and architecture, nothing to install",
        frame: "file",
        link: { name: "unix socket" },
      },
    ],
  },
  {
    id: "ssh",
    name: "Over SSH",
    label: "The client on your machine, the server on build-box, joined over SSH",
    views: [
      {
        command: "notes --on build-box",
        what: "the server next to the data, every key answered here",
        frame: "machine",
        host: "build-box",
        link: { name: "ssh", remote: true },
        note: "installed on the host when needed",
      },
    ],
  },
  {
    id: "url",
    name: "From a URL",
    label: "The client on your machine, the server at notes.example.com, joined over HTTPS",
    views: [
      {
        command: "airtty https://notes.example.com",
        what: "the generic client fetches the app over HTTPS",
        frame: "machine",
        host: "notes.example.com",
        link: { name: "https", remote: true },
        note: "signed bundle, checked before it runs",
        signed: true,
      },
    ],
  },
  {
    id: "web",
    name: "In a web page",
    label:
      "The client in a browser tab, the server either in the same tab, joined by postMessage, or at notes.example.com, joined over HTTPS",
    views: [
      {
        command: "airtty build --web-local",
        what: "a static site, the server in a Web Worker",
        frame: "browser",
        link: { name: "postMessage" },
        note: "static files, data kept in the browser",
      },
      {
        command: "airtty build --web",
        what: "or the page calls your server over HTTPS",
        frame: "browser",
        host: "notes.example.com",
        link: { name: "https", remote: true },
        note: "the server serves the page too",
      },
    ],
  },
];

// The files --compile makes, one per target.
const platforms = [
  ["darwin", "arm64"],
  ["darwin", "x64"],
  ["linux", "arm64"],
  ["linux", "x64"],
];

// A view of two plays in its half of the slide.
const phase = (target: Target, j: number) => (target.views.length > 1 ? `phase-${j}` : undefined);
// A target of two views gets a slide twice as long.
const slide = (target: Target) => (target.views.length > 1 ? "--slide: 9s" : undefined);
---

<section class="section" id="anywhere" aria-labelledby="anywhere-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">run</p>
      <h2 id="anywhere-title">One source. Five places to run it.</h2>
      <p class="lede">
        The same <code>app/</code> folder builds into a local app, a single executable, a client for a
        server you reach over SSH or HTTPS, and a static web page. Your code does not change: only
        where each side runs.
      </p>
    </div>

    <div class="show away" data-show>
      <div class="side">
        <ol class="ways" role="tablist" aria-label="Where it runs">
          {
            targets.map((target, i) => (
              <li>
                <button
                  type="button"
                  role="tab"
                  id={`way-${target.id}`}
                  aria-controls={`scene-${target.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-way={target.id}
                  style={slide(target)}
                >
                  <span class="name">{target.name}</span>
                  <span class="views">
                    {target.views.map((view, j) => (
                      <span class:list={["view", phase(target, j)]}>
                        <code class="command">
                          <span aria-hidden="true">$ </span>
                          {view.command}
                        </code>
                        <span class="what">{view.what}</span>
                      </span>
                    ))}
                  </span>
                  <span class="progress" aria-hidden="true" />
                  {target.views.length > 1 && <span class="half" aria-hidden="true" />}
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="square">
        {
          targets.map((target, i) => (
            <div
              class="scene"
              role="tabpanel"
              id={`scene-${target.id}`}
              aria-labelledby={`way-${target.id}`}
              data-scene={target.id}
              style={slide(target)}
              hidden={i !== 0}
            >
              <svg viewBox="0 60 400 300" role="img" aria-label={target.label}>
                {target.views.map((view, j) => {
                  // The client's frame spans the whole drawing, or its left part when the
                  // server is on a host of its own.
                  const w = view.host ? 170 : 360;
                  const mid = 20 + w / 2;
                  return (
                    <g class={phase(target, j)} aria-hidden="true">
                      <g class="vary">
                        {/* What changes: the frame around what shares a machine. */}
                        {view.frame === "machine" && (
                          <>
                            <text class="t" x="20" y="88">your machine</text>
                            <rect class="n" x="20" y="100" width={w} height="178" rx="8" />
                            <rect class="n faint" x="27" y="107" width={w - 14} height="164" rx="3" />
                            <path class="n" d={`M${mid - 13} 278 L${mid - 17} 296 H${mid + 17} L${mid + 13} 278`} />
                            <rect class="n" x={mid - 38} y="296" width="76" height="6" rx="3" />
                          </>
                        )}
                        {view.frame === "file" && (
                          <>
                            <text class="t" x="20" y="88">./notes</text>
                            <path class="n" d="M20 100 H352 L380 128 V278 H20 Z M352 100 V128 H380" />
                          </>
                        )}
                        {view.frame === "browser" && (
                          <>
                            <rect class="n" x="20" y="62" width={w} height="216" rx="8" />
                            <path class="n" d={`M20 100 H${20 + w}`} />
                            <circle class="n" cx="34" cy="81" r="3" />
                            <circle class="n" cx="45" cy="81" r="3" />
                            <circle class="n" cx="56" cy="81" r="3" />
                            <rect class="n" x="68" y="72" width={w - 56} height="18" rx="9" />
                            <text class="t tiny" x={40 + w / 2} y="84.5" text-anchor="middle">notes.example.com</text>
                          </>
                        )}
                        {view.host && (
                          <>
                            {/* A tower: a bay and its lights on top, a grille below, on its feet. */}
                            <text class="t" x="244" y="88">{view.host}</text>
                            <rect class="n" x="244" y="100" width="136" height="198" rx="5" />
                            <rect class="n" x="258" y="112" width="74" height="9" rx="2" />
                            <circle class="n dot" cx="346" cy="116.5" r="2.5" />
                            <circle class="n" cx="358" cy="116.5" r="2.5" />
                            <path class="n faint" d="M270 278 H354 M270 286 H354" />
                            <path class="n" d="M258 298 v5 h14 v-5 M352 298 v5 h14 v-5" />
                          </>
                        )}

                        {/* The link: its name on it, dashed when it crosses a network. */}
                        <path class:list={["p", { dash: view.link.remote }]} d="M178 190 H268" />
                        <path class="p" d="M183 185 l-5 5 5 5 M263 185 l5 5 -5 5" />
                        <text class="tp" x="223" y="180" text-anchor="middle">{view.link.name}</text>
                        {view.link.remote && (
                          <path class="p" d="M217 199 h12 v10 h-12 Z M220 199 v-3 a3 3 0 0 1 6 0 v3" />
                        )}

                        {/* The detail under the drawing. */}
                        {view.frame === "file" &&
                          platforms.map(([os, arch], k) => {
                            const x = 19 + k * 92;
                            return (
                              <>
                                <path class="n" d={`M${x} 306 H${x + 76} L${x + 86} 316 V350 H${x} Z M${x + 76} 306 V316 H${x + 86}`} />
                                <text class="t" x={x + 40} y="325" text-anchor="middle">{os}</text>
                                <text class="t" x={x + 40} y="340" text-anchor="middle">{arch}</text>
                              </>
                            );
                          })}
                        {view.signed && (
                          <>
                            <path class="p" d="M50 318 L62 312 L74 318 V332 L62 338 L50 332 Z M50 318 L62 324 L74 318 M62 324 V338" />
                            <circle class="c" cx="76" cy="335" r="6" />
                            <path class="c" d="M73 335 l2 2 3.5 -4" />
                            <text class="t" x="92" y="332">{view.note}</text>
                          </>
                        )}
                        {view.note && !view.signed && (
                          <text class="t" x="200" y="332" text-anchor="middle">{view.note}</text>
                        )}
                      </g>
                    </g>
                  );
                })}

                {/* What never changes: the two sides, where they always are. */}
                <g class="still" aria-hidden="true">
                  <rect class="c" x="36" y="138" width="136" height="104" rx="5" />
                  <path class="c" d="M36 154 H172" />
                  <circle class="c" cx="46" cy="146" r="2.2" />
                  <circle class="c" cx="55" cy="146" r="2.2" />
                  <circle class="c" cx="64" cy="146" r="2.2" />
                  <path class="c" d="M46 166 l5 4.5 -5 4.5 M58 170.5 H96" />
                  <path class="c faint" d="M46 186 H150 M46 199 H126 M46 212 H140" />
                  <path class="c" d="M46 224 l5 4.5 -5 4.5" />
                  <rect class="cursor" x="58" y="224" width="7" height="10" rx="1" />
                  <text class="tc" x="104" y="264" text-anchor="middle">client</text>

                  <ellipse class="s" cx="312" cy="150" rx="38" ry="10" />
                  <path class="s" d="M274 150 V230 a38 10 0 0 0 76 0 V150 M274 190 a38 10 0 0 0 76 0" />
                  <text class="ts" x="312" y="264" text-anchor="middle">server</text>
                </g>
              </svg>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // The active way's bar fills (--slide); when it is full, the next way. Pausing the bar
  // pauses the slides; a pick restarts it there. With reduced motion, nothing moves by
  // itself.
  const show = document.querySelector<HTMLElement>("[data-show]");
  if (show) {
    const tabs = [...show.querySelectorAll<HTMLButtonElement>("[data-way]")];
    const pick = (tab: HTMLButtonElement, focus = false) => {
      for (const each of tabs) {
        const on = each === tab;
        each.setAttribute("aria-selected", String(on));
        each.tabIndex = on ? 0 : -1;
      }
      for (const scene of show.querySelectorAll<HTMLElement>("[data-scene]"))
        scene.hidden = scene.dataset.scene !== tab.dataset.way;
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => pick(tab));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        if (next) pick(next, true);
      });
      tab.querySelector(".progress")?.addEventListener("animationend", () => {
        const next = tabs[(i + 1) % tabs.length];
        if (next) pick(next);
      });
    });
    // Out of view, nothing moves: the reader arrives at the first way, not mid-way.
    new IntersectionObserver((entries) => {
      show.classList.toggle("away", !entries.some((entry) => entry.isIntersecting));
    }).observe(show);
    // Paused while the pointer is over it or the keyboard moves in it, as a carousel does;
    // a click leaves the focus on the way without holding it once the pointer leaves.
    const update = () =>
      show.classList.toggle("held", show.matches(":hover") || !!show.querySelector(":focus-visible"));
    // Read once the pointer or the focus has settled: during the event, :hover may lag.
    for (const event of ["pointerenter", "pointerleave", "focusin", "focusout"])
      show.addEventListener(event, () => setTimeout(update));
  }
</script>

<style>
  /* The ways on the left, the square on the right: the list says what, the square where. */
  .show {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .side {
    display: grid;
    gap: 16px;
  }


  .ways {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  /* A way: its name, the line that builds it, what it gives. The chosen one lit, its bar
     filling while its slide shows. */
  .ways button {
    position: relative;
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 16px 16px 18px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: none;
    color: var(--mist);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ways button:hover {
    color: var(--paper);
  }

  .ways [aria-selected="true"] {
    background: var(--panel);
    color: var(--paper);
  }

  .name {
    font: 600 var(--step-1) / 1.35 var(--mono);
  }

  .name::before {
    content: "  " / "";
    white-space: pre;
  }

  [aria-selected="true"] .name::before {
    content: "▸ " / "";
    color: var(--dominant);
  }

  .command {
    padding: 0;
    background: none;
    color: inherit;
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  .command span {
    color: var(--dim);
  }

  .what {
    font: 400 0.88rem / 1.5 var(--sans);
  }

  /* A way built two ways: both lines in one place, each shown in its half of the slide. */
  .views {
    display: grid;
  }

  .view {
    display: grid;
    grid-area: 1 / 1;
    gap: 4px;
  }

  .phase-1 {
    opacity: 0;
  }

  [aria-selected="true"] .phase-0,
  .scene .phase-0 {
    animation: phase-0 var(--slide, 4.5s) linear forwards;
  }

  [aria-selected="true"] .phase-1,
  .scene .phase-1 {
    animation: phase-1 var(--slide, 4.5s) linear forwards;
  }

  .held :is(.phase-0, .phase-1),
  .away :is(.phase-0, .phase-1) {
    animation-play-state: paused;
  }

  @keyframes phase-0 {
    0%,
    48% {
      opacity: 1;
    }
    52%,
    100% {
      opacity: 0;
    }
  }

  @keyframes phase-1 {
    0%,
    48% {
      opacity: 0;
    }
    52%,
    100% {
      opacity: 1;
    }
  }

  .progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--dominant);
  }

  [aria-selected="true"] .progress {
    animation: fill var(--slide, 4.5s) linear forwards;
  }

  .held [aria-selected="true"] .progress,
  .away [aria-selected="true"] .progress {
    animation-play-state: paused;
  }

  /* The middle of a slide of two views, where the second begins: a notch in the bar. */
  .half {
    display: none;
    position: absolute;
    bottom: -1px;
    left: 50%;
    width: 3px;
    height: 2px;
    background: var(--night);
  }

  [aria-selected="true"] .half {
    display: block;
  }

  @keyframes fill {
    to {
      width: 100%;
    }
  }

  /* The frame: one scene at a time, drawn large, in the proportions of the drawing. */
  .square {
    display: grid;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: color-mix(in srgb, var(--panel) 60%, transparent);
  }

  .scene {
    display: grid;
    align-content: center;
    grid-area: 1 / 1;
    padding: clamp(8px, 2.5vw, 32px);
    color: var(--mist);
    font: 400 0.82rem / 1.4 var(--mono);
  }

  /* The two sides stay put from one scene to the next; only what changes arrives. */
  .scene .vary {
    animation: arrive 0.4s ease-out;
  }

  @keyframes arrive {
    from {
      opacity: 0;
    }
  }

  /* The drawings: the medium in plain strokes, the client's part in its colour, the
     server's in its own, with the cue that is not colour (dashes where hues are near).
     Colour names a side and nothing else: every other word is in the neutrals. */
  .scene svg {
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    font-family: var(--mono);
  }

  .scene .n {
    stroke: var(--mist);
  }

  .scene .dot {
    fill: var(--mist);
  }

  .scene .p {
    stroke: var(--paper);
  }

  .scene .c {
    stroke: var(--client);
  }

  /* The terminal's cursor, blinking as one does. */
  .scene .cursor {
    fill: var(--client);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .scene .s {
    stroke: var(--server);
    stroke-dasharray: var(--server-dash, none);
  }

  .scene .faint {
    opacity: 0.45;
  }

  .scene .dash {
    stroke-dasharray: 4 5;
  }

  .scene text {
    stroke: none;
    font-size: 12px;
  }

  .scene .tiny {
    font-size: 10px;
  }

  .scene .t {
    fill: var(--mist);
  }

  .scene .tp {
    fill: var(--paper);
    font-weight: 500;
  }

  .scene .tc {
    fill: var(--client);
  }

  .scene .ts {
    fill: var(--server);
  }


  /* Still: the chosen way stays until the reader picks another. */
  @media (prefers-reduced-motion: reduce) {
    [aria-selected="true"] .progress,
    .scene .vary,
    .scene .cursor,
    [aria-selected="true"] :is(.phase-0, .phase-1),
    .scene :is(.phase-0, .phase-1) {
      animation: none;
    }
  }

  /* Narrow: the square first, where the eye is when the list below moves it on. */
  @media (max-width: 900px) {
    .show {
      grid-template-columns: 1fr;
    }

    .square {
      order: -1;
    }
  }
</style>
