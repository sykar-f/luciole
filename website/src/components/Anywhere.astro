---
// One source, the targets `airtty build` makes of it: a list on the left, and on the right
// a square that shows each one where it runs, the same Notes screen (a real capture,
// scripts/capture.py) in every one. It moves on by itself, the list following, and stops
// while the reader points at it or picks one. The commands are those docs/ gives (README,
// DISTRIBUTION.md, WEB.md).


type Target = {
  id: "local" | "binary" | "ssh" | "url" | "web";
  name: string;
  command: string;
  what: string;
};
const targets: Target[] = [
  { id: "local", name: "Local", command: "airtty ./notes", what: "both sides on your machine, over a private socket" },
  { id: "binary", name: "One executable", command: "airtty build --compile", what: "per OS and architecture, nothing to install" },
  { id: "ssh", name: "Over SSH", command: "notes --on build-box", what: "server next to the data, keys stay here" },
  { id: "url", name: "From a URL", command: "airtty https://notes.example.com", what: "the generic client runs the signed bundle" },
  { id: "web", name: "In a web page", command: "airtty build --web-local", what: "a static site, the server in a Web Worker" },
];
---

<section class="section" id="anywhere" aria-labelledby="anywhere-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">run</p>
      <h2 id="anywhere-title">One source. Five places to run it.</h2>
      <p class="lede">
        The same <code>app/</code> folder builds into a local app, a single executable, a client for a
        server you reach over SSH or HTTPS, and a static web page. Your code does not change: only
        where each side runs.
      </p>
    </div>

    <div class="show away" data-show>
      <div class="side">
        <p class="source">
          <span class="dim">examples/notes</span> <span aria-hidden="true">→</span> <code
            ><span class="dim">$ </span>airtty build</code
          >
        </p>
        <ol class="ways" role="tablist" aria-label="Where it runs">
          {
            targets.map((target, i) => (
              <li>
                <button
                  type="button"
                  role="tab"
                  id={`way-${target.id}`}
                  aria-controls={`scene-${target.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-way={target.id}
                >
                  <span class="name">{target.name}</span>
                  <code class="command">
                    <span aria-hidden="true">$ </span>
                    {target.command}
                  </code>
                  <span class="what">{target.what}</span>
                  <span class="progress" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="square">
        {
          targets.map((target, i) => (
            <div
              class="scene"
              role="tabpanel"
