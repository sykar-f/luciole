---
// What people build with it, one example each, live in the page: the chosen one runs
// while the section is near the viewport, the others show their capture. One at a time,
// wide enough to be read, picked by radio buttons; without a script, the captures.
import { existsSync, readdirSync } from "node:fs";
import { join } from "node:path";
import LiveTerminal from "./LiveTerminal.astro";
import { examples, type ExampleKey } from "../lib/examples";
import { frame } from "../lib/frames";
import { source } from "../lib/links";

const uses: { use: string; key: ExampleKey; line: string }[] = [
  { use: "Coding-agent interface", key: "coder", line: "A session on Claude Code, Codex, pi or opencode, with its diffs and approvals in your terminal." },
  { use: "Code review", key: "forge", line: "Pull requests, coloured diffs, line comments and live CI logs." },
  { use: "Document reader", key: "mdreader", line: "A folder of Markdown in two panes, reloaded when a file changes." },
];

// What each demo loads, beyond the web runtime the hero already brought (scripts/demo.ts):
// fetched ahead, at the browser's leisure, so a pick starts at once. Source maps and the
// seed of a demo that has none are not there; without `bun run demo`, nothing is.
const demos = join(process.cwd(), "public/demo");
const ahead = uses.flatMap(({ key }) => {
  const demo = examples[key].demo;
  if (!demo || !existsSync(join(demos, demo))) return [];
  return readdirSync(join(demos, demo), { recursive: true, withFileTypes: true })
    .filter((entry) => entry.isFile())
    .map((entry) => `/demo/${demo}/${join(entry.parentPath, entry.name).slice(demos.length + demo.length + 2)}`);
});
---

<section class="section" id="build" aria-labelledby="build-title" data-uses>
  <template data-ahead>
    {ahead.map((href) => <link rel="prefetch" href={href} />)}
  </template>
  <div class="wrap">
    <div class="section-head">
      <p class="label">build</p>
      <h2 id="build-title">What you can build.</h2>
    </div>
    <div class="showcase">
      <div class="picks" role="radiogroup" aria-label="Examples">
        {
          uses.map(({ use, key, line }, i) => (
            <label class="pick">
              <input type="radio" name="use" value={key} id={`use-${key}`} checked={i === 0} />
              <span class="use">{use}</span>
              <span class="line">{line}</span>
            </label>
          ))
        }
      </div>
      <div class="panels">
      {
        uses.map(({ key }) => ({ key, example: examples[key] })).map(({ key, example }) => (
          <div class="panel" data-use={key}>
            <div class="live-wrap">
              <LiveTerminal demo={example.demo ?? key} frame={frame(example.frame)} script={example.script} boot="manual" />
              <p class="starting" role="status">
                <span class="spinner" aria-hidden="true" /><span class="word">Loading the live demo</span>
              </p>
            </div>
            <div class="under">
              <p class="run">
                <code>
                  <span aria-hidden="true">$ </span>
                  {example.run}
                </code>
              </p>
              {example.scripted && <p class="scripted">{example.scripted}</p>}
              <p class="links">
                <a href={`/examples/#${key}`}>More about it</a>
                <a href={source(example.source)}>Source</a>
              </p>
            </div>
          </div>
        ))
      }
      </div>
    </div>
    <p class="all"><a href="/examples/">All examples</a></p>
  </div>
</section>

<script>
  import * as z from "zod/mini";

  // Each example runs in the page, started early and kept running (below); the radio
  // buttons only choose which one shows.
  const section = document.querySelector<HTMLElement>("[data-uses]");
  /** How long after the page's load the examples start, and how long one may take. */
  const WARM_MS = 1500;
  const GIVE_UP_MS = 60_000;
  // Where demos run at all (LiveTerminal: wide enough, no data saving), their files are
  // fetched ahead: the template's prefetch links, put in the head.
  const Connection = z.object({ saveData: z.optional(z.boolean()) });
  const saving = Connection.safeParse(Reflect.get(navigator, "connection")).data?.saveData === true;
  const ahead = section?.querySelector<HTMLTemplateElement>("template[data-ahead]");
  if (ahead && !saving && !matchMedia("(max-width: 760px)").matches)
    document.head.append(ahead.content.cloneNode(true));
  if (section) {
    const liveOf = (key: string) =>
      section.querySelector<HTMLElement>(`[data-use="${key}"] [data-live]`);
    const keys = [...section.querySelectorAll<HTMLInputElement>('input[name="use"]')].map((input) => input.value);
    const chosen = () => section.querySelector<HTMLInputElement>('input[name="use"]:checked')?.value ?? "";
    /** Resolves once the example is live (LiveTerminal adds `on`), or gave up. */
    const live = (root: HTMLElement) =>
      new Promise<void>((resolve) => {
        if (root.classList.contains("on")) return resolve();
        const watch = new MutationObserver(() => {
          if (!root.classList.contains("on")) return;
          watch.disconnect();
          resolve();
        });
        watch.observe(root, { attributes: true, attributeFilter: ["class"] });
        setTimeout(() => {
          watch.disconnect();
          resolve();
        }, GIVE_UP_MS);
      });
    // All of them run, and keep running: a pick only changes which one shows. They start
    // one after the other, the chosen first, each once the one before is live, so the page
    // is never starting them all at once.
    const warm = async () => {
      const order = [chosen(), ...keys.filter((key) => key !== chosen())];
      for (const key of order) {
        const root = liveOf(key);
        if (!root) continue;
        root.dispatchEvent(new Event("live:start"));
        await live(root);
      }
    };
    addEventListener("load", () => setTimeout(() => void warm(), WARM_MS));
    // A pick that is not running yet starts at once, ahead of its turn (a start twice is one).
    for (const input of section.querySelectorAll<HTMLInputElement>('input[name="use"]'))
      input.addEventListener("change", () => liveOf(input.value)?.dispatchEvent(new Event("live:start")));
  }
</script>

<style>
  .picks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }

  /* A tab drawn as a terminal draws a selected row: the chosen one lit, the others dim. */
  .pick {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-top-width: 2px;
    color: var(--mist);
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .pick:hover {
    border-color: var(--rule-strong);
  }

  .pick:has(:checked) {
    border-color: var(--rule-strong);
    border-top-color: var(--paper);
    background: var(--panel);
    color: var(--paper);
  }

  .pick:has(:focus-visible) {
    outline: 2px solid var(--dominant);
    outline-offset: 3px;
  }

  .pick input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .use {
    font: 600 var(--step-1) / 1.35 var(--mono);
  }

  .use::before {
    content: "  " / "";
    white-space: pre;
  }

  .pick:has(:checked) .use::before {
    content: "▸ " / "";
    color: var(--dominant);
  }

  .line {
    color: var(--mist);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* Every example stays laid out, one over the other, so each keeps running at its size:
     only the chosen one shows. Without :has(), the first one. */
  .panels {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .panel:first-child {
    visibility: visible;
  }

  @supports selector(:has(*)) {
    .panel:first-child {
      visibility: hidden;
    }

    .showcase:has(#use-coder:checked) [data-use="coder"],
    .showcase:has(#use-forge:checked) [data-use="forge"],
    .showcase:has(#use-mdreader:checked) [data-use="mdreader"] {
      visibility: visible;
    }
  }

  .under {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 20px;
  }

  /* Until the demo takes keys, its screen is only a picture: slightly blurred and greyed,
     with a word saying it is on its way; sharp and in colour the moment
     it is live. Where no demo runs, left as it is. */
  .live-wrap {
    position: relative;
  }

  .panel :global([data-live].standing .screen) {
    filter: blur(1.5px) grayscale(0.5) brightness(0.85);
    transition: filter 0.45s ease;
  }

  .panel :global([data-live].standing.on .screen) {
    filter: none;
    animation: none;
  }


  .starting {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 1.2ch;
    padding: 10px 16px;
    border: 1px solid var(--rule-strong);
    background: color-mix(in srgb, var(--night) 85%, transparent);
    color: var(--paper);
    font: 500 0.85rem / 1.4 var(--mono);
    white-space: nowrap;
    transform: translate(-50%, -50%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }

  /* A light that sweeps across the band, again and again, as loading skeletons do; the
     text takes it as it passes. */
  .starting {
    overflow: hidden;
    isolation: isolate;
  }

  .starting::after {
    content: "";
    position: absolute;
    inset: -50% 0;
    z-index: -1;
    background: linear-gradient(
      120deg,
      transparent 20%,
      color-mix(in srgb, var(--paper) 10%, transparent) 50%,
      transparent 80%
    );
    transform: translateX(-100%) skewX(-20deg);
    animation: sweep 1.8s ease-in-out infinite;
  }

  .starting .word {
    background: linear-gradient(
        120deg,
        var(--mist) 35%,
        color-mix(in srgb, var(--mist) 50%, var(--paper)) 50%,
        var(--mist) 65%
      )
      0 0 / 250% 100%;
    background-clip: text;
    color: transparent;
    animation: glint 1.8s ease-in-out infinite;
  }

  @keyframes sweep {
    to {
      transform: translateX(100%) skewX(-20deg);
    }
  }

  @keyframes glint {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  .live-wrap:has(:global([data-live].standing:not(.on))) .starting {
    opacity: 1;
    visibility: inherit;
  }

  /* A terminal's spinner: a braille dot running round, a frame at a time. */
  .spinner::before {
    content: "⠋" / "";
    color: var(--dominant);
    animation: spin 0.8s steps(1) infinite;
  }

  @keyframes spin {
    0% { content: "⠋" / ""; }
    12.5% { content: "⠙" / ""; }
    25% { content: "⠹" / ""; }
    37.5% { content: "⠸" / ""; }
    50% { content: "⠼" / ""; }
    62.5% { content: "⠴" / ""; }
    75% { content: "⠦" / ""; }
    87.5% { content: "⠧" / ""; }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel :global([data-live].standing .screen) {
      transition: none;
      animation: none;
    }

    .spinner::before,
    .starting::after,
    .starting .word {
      animation: none;
    }

    .starting .word {
      color: var(--paper);
      background: none;
    }
  }

  .scripted {
    color: var(--dim);
    font: 400 0.8rem / 1.5 var(--mono);
  }

  .run code {
    padding: 0;
    background: none;
    color: var(--paper);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .run span {
    color: var(--dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font: 400 0.85rem / 1.6 var(--mono);
  }

  .links a:first-child::after,
  .all a::after {
    content: " →" / "";
  }

  .all {
    margin-top: 32px;
    font: 500 0.9rem / 1.6 var(--mono);
  }

  @media (max-width: 900px) {
    .picks {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .pick {
      padding: 10px 14px;
    }
  }
</style>
