---
import { repo } from "../lib/links";

const links = [
  ["#how", "How it works"],
  ["#wire", "Latency"],
  ["#apps", "Examples"],
  ["#ship", "Ship"],
  ["#start", "Get started"],
];
---

<header class="header">
  <div class="wrap inner">
    <a class="mark" href="#top" aria-label="airtty, back to top">
      air<span class="tty">tty</span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <a class="repo" href={repo}>GitHub</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: var(--night);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 60px;
    font-family: var(--mono);
  }

  .mark {
    font: 700 1.15rem / 1 var(--mono);
    text-decoration: none;
  }

  .tty {
    color: var(--mist);
  }

  ul {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .repo {
    color: var(--mist);
    font-size: 0.85rem;
    text-decoration: none;
  }

  nav a:hover,
  .repo:hover {
    color: var(--paper);
  }

  .repo {
    margin-left: auto;
    padding: 6px 12px;
    border: 1px solid var(--rule-strong);
    color: var(--paper);
  }

  .repo:hover {
    border-color: var(--mist);
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
</style>
