---
import { repo } from "../lib/links";

const links = [
  ["#how", "How it works"],
  ["#wire", "Latency"],
  ["#apps", "Examples"],
  ["#try", "Try it"],
  ["#ship", "Ship"],
  ["#start", "Get started"],
];
---

<header class="header">
  <div class="wrap inner">
    <a class="mark" href="#top" aria-label="airtty, back to top">
      air<span class="tty">tty</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <a class="repo" href={repo}>GitHub</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: rgb(7 11 18 / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 60px;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    font: 700 1.2rem / 1 var(--mono);
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .tty {
    color: var(--client);
  }

  .cursor {
    width: 0.55em;
    height: 1.05em;
    margin-left: 3px;
    background: var(--server);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  ul {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .repo {
    color: var(--mist);
    font-size: 0.93rem;
    text-decoration: none;
  }

  nav a:hover,
  .repo:hover {
    color: var(--paper);
  }

  .repo {
    margin-left: auto;
    padding: 6px 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    color: var(--paper);
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
</style>
