---
import { doc } from "../lib/links";

const modes = [
  {
    name: "inline",
    where: "Inside the Client, in the same React tree",
    isolation: "None. You are told so before it opens.",
    for: "Code you trust: yours, installed, signed",
  },
  {
    name: "process",
    where: "A child process on its own PTY",
    isolation: "Crashes only. It is tmux, not a browser.",
    for: "Default for local and installed apps",
  },
  {
    name: "sandbox",
    where: "A child process under the OS sandbox",
    isolation: "Crashes, and the capabilities you granted, enforced",
    for: "Default for URLs and unsigned packages",
  },
];

const capabilities = ["fs.read", "fs.write", "net", "exec", "pty", "clipboard.write", "notify", "open-url", "secrets"];
---

<section class="section" id="trust" aria-labelledby="trust-title">
  <div class="wrap grid">
    <div class="head">
      <p class="label">trust</p>
      <h2 id="trust-title">Open apps by URL, like a browser. Confine them like one.</h2>
      <p class="lede">
        An app declares what it needs in its <code>package.json</code>; the build copies that into
        its signed manifest. You grant it, per origin. On macOS, Seatbelt enforces it; on Linux,
        Landlock and namespaces, through a small Rust launcher.
      </p>
      <ul class="caps" aria-label="Capabilities an app can declare">
        {capabilities.map((cap) => <li><code>{cap}</code></li>)}
      </ul>
      <p class="rule">
        One rule on every screen: a capability is shown as enforced only if something enforces it.
      </p>
      <a class="more" href={doc("EMBEDDING.md")}>How origins, keys and modes work</a>
    </div>

    <ol class="modes" aria-label="Isolation modes, least to most isolated">
      {
        modes.map((mode) => (
          <li>
            <p class="mode-name">
              <code>{mode.name}</code>
              <span class="meter" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            </p>
            <dl>
              <div><dt>Runs</dt><dd>{mode.where}</dd></div>
              <div><dt>Isolates</dt><dd>{mode.isolation}</dd></div>
              <div><dt>For</dt><dd>{mode.for}</dd></div>
            </dl>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .head {
    display: grid;
    gap: 22px;
    position: sticky;
    top: 100px;
  }

  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .caps code {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: var(--mist);
    font-size: 0.8rem;
  }

  .rule {
    padding: 14px 16px;
    border: 1px solid rgb(255 188 102 / 0.25);
    border-radius: 10px;
    background: var(--server-soft);
    color: var(--paper);
    font-size: 0.85rem;
  }

  .more {
    justify-self: start;
    color: var(--mist);
    font-size: 0.92rem;
  }

  .modes {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .modes li {
    padding: 22px 24px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
  }

  .modes li:last-child {
    border-color: rgb(103 217 188 / 0.35);
    background: linear-gradient(180deg, var(--client-soft), transparent);
  }

  .mode-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .mode-name code {
    padding: 0;
    background: none;
    color: var(--paper);
    font: 600 1.2rem / 1.2 var(--mono);
  }

  .meter {
    display: flex;
    gap: 4px;
  }

  .meter i {
    width: 22px;
    height: 6px;
    border-radius: 1px;
    background: var(--rule-strong);
  }

  /* How much stands between the app and your account: nothing, crashes, crashes and capabilities. */
  li:nth-child(2) .meter i:first-child,
  li:nth-child(3) .meter i {
    background: var(--client);
  }

  dl {
    display: grid;
    gap: 6px;
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
  }

  dt {
    color: var(--dim);
    font-size: 0.85rem;
  }

  dd {
    margin: 0;
    color: var(--mist);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .head {
      position: static;
    }
  }
</style>
