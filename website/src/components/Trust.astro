---
import { doc } from "../lib/links";

const modes = [
  {
    name: "inline",
    where: "Inside the Client, in the same React tree",
    isolation: "None. You are told so before it opens.",
    for: "Code you trust: yours, installed, signed",
  },
  {
    name: "process",
    where: "A child process on its own PTY",
    isolation: "Crashes only. It is tmux, not a browser.",
    for: "Default for local and installed apps",
  },
  {
    name: "sandbox",
    where: "A child process under the OS sandbox",
    isolation: "Crashes, and the capabilities you granted, enforced",
    for: "Default for URLs and unsigned packages",
  },
];

// Out of three: nothing, crashes, crashes and the capabilities granted.
const shields = [0, 1, 3];
const SHIELDS = 3;

const capabilities = ["fs.read", "fs.write", "net", "exec", "pty", "clipboard.write", "notify", "open-url", "secrets"];
---

<section class="section" id="trust" aria-labelledby="trust-title">
  <div class="wrap">
    <div class="head">
      <p class="label">trust</p>
      <h2 id="trust-title">Open apps by URL, like a browser. Confine them like one.</h2>
      <p class="lede">
        An app declares what it needs in its <code>package.json</code>; the build copies that into
        its signed manifest. You grant it, per origin. On macOS, Seatbelt enforces it; on Linux,
        Landlock and namespaces, through a small Rust launcher.
      </p>
      <ul class="caps" aria-label="Capabilities an app can declare">
        {capabilities.map((cap) => <li><code>{cap}</code></li>)}
      </ul>
      <p class="rule">
        One rule on every screen: a capability is shown as enforced only if something enforces it.
      </p>
      <a class="more" href={doc("EMBEDDING.md")}>How origins, keys and modes work</a>
    </div>

    <table class="modes">
      <caption class="visually-hidden">Isolation modes, least to most isolated</caption>
      <thead>
        <tr>
          <th scope="col">Mode</th>
          <th scope="col">Runs</th>
          <th scope="col">Isolates</th>
          <th scope="col">For</th>
        </tr>
      </thead>
      <tbody>
        {
          modes.map((mode, i) => (
            <tr>
              <th scope="row">
                <code>{mode.name}</code>
                <span class="meter" aria-hidden="true">
                  {"■".repeat(shields[i] ?? 0)}
                  <span class="empty">{"□".repeat(SHIELDS - (shields[i] ?? 0))}</span>
                </span>
              </th>
              <td data-label="Runs">{mode.where}</td>
              <td data-label="Isolates">{mode.isolation}</td>
              <td data-label="For">{mode.for}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 22px;
    max-width: 860px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 2.5ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .caps code {
    color: var(--paper);
    font-size: 0.85rem;
  }

  .rule {
    padding-left: 14px;
    border-left: 2px solid var(--paper);
    color: var(--paper);
    font-size: 0.95rem;
  }

  .more {
    justify-self: start;
    color: var(--mist);
    font: 400 0.88rem / 1.5 var(--mono);
  }

  /* Modes against what they do: data, so a table. */
  .modes {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  thead th {
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--rule-strong);
    color: var(--mist);
    font: 400 var(--step--1) / 1.5 var(--mono);
    text-align: left;
  }

  tbody th,
  td {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  tbody th {
    width: 16ch;
    font-weight: 400;
  }

  tbody th code {
    display: block;
    color: var(--paper);
    font: 600 1.05rem / 1.3 var(--mono);
  }

  td {
    color: var(--mist);
  }

  /* How much stands between the app and your account: nothing, crashes, crashes and capabilities. */
  .meter {
    display: block;
    margin-top: 4px;
    color: var(--client);
    font: 400 0.8rem / 1 var(--mono);
    letter-spacing: 0.2em;
  }

  .meter .empty {
    color: var(--rule-strong);
  }

  @media (max-width: 760px) {
    .modes,
    .modes tbody,
    .modes tr,
    .modes th,
    .modes td {
      display: block;
    }

    thead {
      display: none;
    }

    .modes tr {
      padding: 14px 0;
      border-bottom: 1px solid var(--rule);
    }

    tbody th,
    td {
      width: auto;
      padding: 2px 0;
      border: 0;
    }

    tbody th {
      margin-bottom: 8px;
    }

    td::before {
      content: attr(data-label) " ";
      display: inline-block;
      min-width: 10ch;
      color: var(--dim);
      font: 400 var(--step--1) / 1.5 var(--mono);
    }
  }
</style>
