---
import { Code } from "astro:components";
import type { ShikiTransformer } from "shiki";
import Screen, { type Region } from "./Screen.astro";
import { night } from "../lib/codeTheme";
import { frame } from "../lib/frames";
import { source } from "../lib/links";
// The real files of examples/notes, read at build time: the page cannot drift from them.
import rootLayout from "../../../examples/notes/app/layout.tsx?raw";
import listPage from "../../../examples/notes/app/page.tsx?raw";
import notePage from "../../../examples/notes/app/notes/[id]/page.tsx?raw";
import noteLoading from "../../../examples/notes/app/notes/[id]/loading.tsx?raw";
import editor from "../../../examples/notes/components/NoteEditor.tsx?raw";
import actions from "../../../examples/notes/actions/notes.ts?raw";
import repository from "../../../examples/notes/server/repository.ts?raw";
// What the Server really sent for /notes/1, captured by scripts/capture.py.
import flight from "../frames/flight.txt?raw";

type Side = "client" | "server";
const files: { path: string; side: Side; kind: string; note: string; code: string }[] = [
  { path: "app/layout.tsx", side: "client", kind: "Client layout", note: "Persistent chrome: connection state and global keys.", code: rootLayout },
  { path: "app/page.tsx", side: "server", kind: "Server page", note: "Reads the list straight from SQLite. No API in between.", code: listPage },
  { path: "app/notes/[id]/page.tsx", side: "server", kind: "Server page", note: "Loads a note and hands the save action to the editor as a prop.", code: notePage },
  { path: "app/notes/[id]/loading.tsx", side: "client", kind: "Client loading screen", note: "Shown the moment you press Enter, while the page travels.", code: noteLoading },
  { path: "components/NoteEditor.tsx", side: "client", kind: "Client Component", note: "Every keystroke is handled here, in the terminal.", code: editor },
  { path: "actions/notes.ts", side: "server", kind: "Server Functions", note: "Called from the terminal like any function. There is no RPC layer to write.", code: actions },
  { path: "server/repository.ts", side: "server", kind: "Server only", note: "SQLite, ownership checks and transactions. Never bundled into the Client.", code: repository },
];

// Where each file drew on the list screen of Notes (scripts/capture.py), in cells. The
// layout, a Client Component, draws the chrome around every page; the Server page sends
// the list; the repository is where the notes in it were read.
const list = frame("notes");
const FULL = { col: 1, cols: 82 };
const drew: Record<string, Region["rects"]> = {
  "app/layout.tsx": [
    { row: 1, rows: 1, ...FULL },
    { row: 3, rows: 1, ...FULL },
    { row: 22, rows: 1, ...FULL },
  ],
  "app/page.tsx": [{ row: 5, rows: 10, ...FULL }],
  "server/repository.ts": [{ row: 7, rows: 4, col: 3, cols: 13 }],
};
// The same screen cut in two: the rows the Client draws itself, the rows the Server sends.
const rowsIn = (rects: Region["rects"]) =>
  new Set(rects.flatMap(({ row, rows }) => Array.from({ length: rows }, (_, i) => row + i)));
const keep = (rows: Set<number>, title: string) => ({
  ...list,
  title,
  cells: list.cells.map((runs, i) => (rows.has(i) ? runs : [])),
});
const clientPart = keep(rowsIn(drew["app/layout.tsx"] ?? []), ".airtty/client draws");
const serverPart = keep(rowsIn(drew["app/page.tsx"] ?? []), ".airtty/server sends");

const regions: Region[] = files.flatMap((file, i) => {
  const rects = drew[file.path];
  return rects ? [{ id: String(i), side: file.side, rects }] : [];
});

// Each row of the Flight response, with what to notice in it.
const flightNotes: [RegExp, string][] = [
  [/^0:\{"tree"/, "The envelope: a tree, and the cache tags it read."],
  [/^\d+:I\[/, "A Client Component. Its code is already in the terminal: only its name travels."],
  [/#saveNote"/, "A Server Function: a reference the Client can call, never the code."],
  [/^0:\["\$","box"/, "The page itself: OpenTUI elements, rendered next to the database."],
  [/^\d+:\["note:/, "Cache tags: what a save of this note refreshes."],
];
const flightRows = flight
  .trim()
  .split("\n")
  .map((text) => ({ text, note: flightNotes.find(([pattern]) => pattern.test(text))?.[1] }));
const flightBytes = new TextEncoder().encode(flight).length;
const wireTab = files.length;

// Colour the "use client" and "use server" lines with the side they put a file on.
const directives: ShikiTransformer[] = [
  {
    name: "mark-directives",
    line(node, line) {
      const text = this.source.split("\n")[line - 1] ?? "";
      if (text.startsWith('"use client"')) this.addClassToHast(node, "directive-client");
      if (text.startsWith('"use server"')) this.addClassToHast(node, "directive-server");
    },
  },
];
---

<section class="section" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">how it works</p>
      <h2 id="how-title">One codebase. Two programs.</h2>
      <p class="lede">
        You write pages, layouts and actions in one <code>app/</code> folder, with the conventions of
        the React web frameworks you know. <code>airtty build</code> splits them: what reads your data
        stays on the <span class="server">Server</span>, what reads your keyboard ships to the <span
          class="client">Client</span
        >.
      </p>
    </div>

    <div class="explorer" data-tabs data-explorer>
      <div class="chrome" aria-hidden="true">
        <span><b>┤</b> examples/notes <b>├</b></span>
      </div>
      <div class="body">
      <div class="tree" role="tablist" aria-label="Files of the Notes example" aria-orientation="vertical">
        <p class="tree-root">app, components, actions, server</p>
        {
          files.map((file, i) => (
            <button
              type="button"
              role="tab"
              id={`file-tab-${i}`}
              aria-controls={`file-panel-${i}`}
              aria-selected={i === 4 ? "true" : "false"}
              tabindex={i === 4 ? 0 : -1}
              class:list={["file", file.side]}
              data-drew={drew[file.path] ? String(i) : undefined}
            >
              <span class="path">{file.path}</span>
              <span class="kind">{file.kind}</span>
            </button>
          ))
        }
        <p class="tree-root wire-root">between the two</p>
        <button
          type="button"
          role="tab"
          id={`file-tab-${wireTab}`}
          aria-controls={`file-panel-${wireTab}`}
          aria-selected="false"
          tabindex={-1}
          class="file wire"
        >
          <span class="path">GET /render /notes/1</span>
          <span class="kind">React Flight, {flightBytes} bytes</span>
        </button>
        <p class="key">
          <span><i class="swatch client-swatch"></i>ships to the terminal</span>
          <span><i class="swatch server-swatch"></i>stays on the Server</span>
        </p>
      </div>
      <div class="panels">
        {
          files.map((file, i) => (
            <div
              role="tabpanel"
              id={`file-panel-${i}`}
              aria-labelledby={`file-tab-${i}`}
              class:list={["pane", file.side]}
              hidden={i !== 4}
            >
              <div class="pane-head">
                <p>{file.note}</p>
                <a href={source(`examples/notes/${file.path}`)}>View on GitHub</a>
              </div>
              <Code code={file.code.trimEnd()} lang="tsx" theme={night} transformers={directives} />
            </div>
          ))
        }
        <div
          role="tabpanel"
          id={`file-panel-${wireTab}`}
          aria-labelledby={`file-tab-${wireTab}`}
          class="pane wire"
          hidden
        >
          <div class="pane-head">
            <p>
              What the Server sent to draw a note, byte for byte. The terminal turns it into a screen.
            </p>
          </div>
          <ol class="flight">
            {
              flightRows.map((row) => (
                <li>
                  <code>{row.text}</code>
                  {row.note && <span class="flight-note">{row.note}</span>}
                </li>
              ))
            }
          </ol>
        </div>
      </div>
      </div>
    </div>

    <div class="drawn">
      <Screen frame={list} regions={regions} class="drawn-screen" />
      <div class="drawn-text">
        <p>
          The list screen of Notes, as captured. Pick a file above: the cells it put on this screen
          light up, <span class="client">green</span> for the Client, <span class="server">amber</span> for
          the Server.
        </p>
        <p class="drawn-now" aria-live="polite" data-drawn-now></p>
      </div>
    </div>

    <figure class="parting" aria-label="The Notes screen, split between what the Client draws and what the Server sends">
      <div class="part client-part"><Screen frame={clientPart} /></div>
      <div class="part server-part"><Screen frame={serverPart} /></div>
      <p class="between" aria-hidden="true">⇄ React Flight</p>
    </figure>

    <div class="split" aria-label="What airtty build produces">
      <div class="half client-half">
        <p class="out"><code>.airtty/client</code></p>
        <h3>Runs in the user's terminal</h3>
        <p>
          The terminal runtime and your Client Components. OpenTUI draws the screen; keys, mouse,
          scrolling and local state never leave the machine. No business logic, no secrets, no
          database.
        </p>
      </div>
      <div class="bridge">
        <span>React Flight over HTTP, a Unix socket or SSH</span>
        <span>Same build ID on both ends, or the connection is refused</span>
      </div>
      <div class="half server-half">
        <p class="out"><code>.airtty/server</code></p>
        <h3>Runs where your data lives</h3>
        <p>
          Your pages, Server Functions and cache. It never imports OpenTUI and
          never draws a pixel: it answers with React trees.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // One tab pattern for the file tree and the examples gallery.
  for (const group of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus: boolean) => {
      for (const other of tabs) {
        const on = other === tab;
        other.setAttribute("aria-selected", String(on));
        other.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(other.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      group.dispatchEvent(new CustomEvent("tabs:select", { detail: tab }));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        event.preventDefault();
        const next = tabs.at((i + step) % tabs.length);
        if (next) select(next, true);
      });
    });
  }
</script>

<script>
  // The picked file lights the cells it drew on the Notes screen, and so does the one
  // under the pointer, for as long as it is there.
  const explorer = document.querySelector<HTMLElement>("[data-explorer]");
  const regions = [...document.querySelectorAll<HTMLElement>(".drawn [data-region]")];
  const now = document.querySelector<HTMLElement>("[data-drawn-now]");
  if (explorer && now) {
    const light = (tab: HTMLElement) => {
      const id = tab.dataset.drew;
      // A file that draws nothing here leaves the map of those that do, dimmed.
      for (const region of regions) {
        region.classList.toggle("lit", region.dataset.region === id);
        region.classList.toggle("faint", id === undefined);
      }
      const path = tab.querySelector(".path")?.textContent ?? "";
      now.textContent =
        id === undefined ? `${path}: not on this screen. Dimmed: the files that are.` : `${path}: lit.`;
    };
    const picked = () => explorer.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]');
    explorer.addEventListener("tabs:select", (event) => {
      if (event instanceof CustomEvent && event.detail instanceof HTMLElement) light(event.detail);
    });
    for (const tab of explorer.querySelectorAll<HTMLElement>('[role="tab"]')) {
      tab.addEventListener("pointerenter", () => light(tab));
      tab.addEventListener("pointerleave", () => {
        const current = picked();
        if (current) light(current);
      });
    }
    const current = picked();
    if (current) light(current);
  }
</script>

<style>
  .explorer {
    position: relative;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--panel);
  }

  /* The folder's name set into the top edge, as a terminal box titles itself. */
  .chrome {
    position: absolute;
    top: -0.75em;
    left: 14px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .chrome span {
    padding: 0 0.5ch;
    background: var(--night);
  }

  .chrome b {
    color: var(--rule-strong);
    font-weight: 400;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(250px, 300px) minmax(0, 1fr);
  }

  .tree {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 10px 14px;
    border-right: 1px solid var(--rule);
  }

  .tree-root {
    padding: 4px 10px 8px;
    color: var(--dim);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .wire-root {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  .file {
    position: relative;
    display: grid;
    gap: 1px;
    padding: 8px 10px 8px 26px;
    border: 0;
    border-left: 2px solid transparent;
    background: none;
    color: var(--mist);
    font-family: var(--mono);
    text-align: left;
    cursor: pointer;
    transition: background 0.15s;
  }

  .file::before {
    content: "";
    position: absolute;
    top: 15px;
    left: 11px;
    width: 7px;
    height: 7px;
    background: var(--dim);
  }

  .file.client::before {
    background: var(--client);
  }

  .file.server::before {
    background: var(--server);
  }

  /* Between the two: neither side's colour. */
  .file.wire::before {
    border: 1px solid var(--mist);
    background: none;
  }

  .file:hover {
    background: var(--night-raised);
  }

  .path {
    color: var(--paper);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .kind {
    font-size: 0.75rem;
  }

  .file.client .kind {
    color: var(--client);
  }

  .file.server .kind {
    color: var(--server);
  }

  .file[aria-selected="true"] {
    border-left-color: var(--paper);
    background: var(--night-raised);
  }

  .key {
    display: grid;
    gap: 6px;
    margin-top: auto;
    padding: 20px 10px 4px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .swatch {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
  }

  .client-swatch {
    background: var(--client);
  }

  .server-swatch {
    background: var(--server);
  }

  .panels {
    min-width: 0;
  }

  .pane-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 14px 20px 12px;
    border-bottom: 1px solid var(--rule);
    color: var(--mist);
    font-size: 0.85rem;
  }

  .pane-head a {
    flex-shrink: 0;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .pane :global(pre) {
    height: 540px;
    margin: 0;
    padding: 16px 0;
    background: transparent !important;
    overflow: auto;
    font: 400 0.8rem / 1.7 var(--mono);
    font-variant-ligatures: none;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  .pane :global(pre code) {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  .pane :global(.line) {
    display: inline-block;
    width: 100%;
    padding: 0 20px;
  }

  .pane :global(.directive-client) {
    background: var(--client-soft);
    box-shadow: inset 2px 0 var(--client);
  }

  .pane :global(.directive-server) {
    background: var(--server-soft);
    box-shadow: inset 2px 0 var(--server);
  }

  .flight {
    height: 540px;
    margin: 0;
    padding: 8px 20px 16px;
    overflow: auto;
    list-style: none;
    counter-reset: row;
  }

  .flight li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 6px 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    counter-increment: row;
  }

  .flight li::before {
    content: counter(row, decimal-leading-zero);
    color: var(--dim);
    font: 400 0.75rem / 1.8 var(--mono);
  }

  .flight code {
    padding: 0;
    background: none;
    font: 400 0.78rem / 1.8 var(--mono);
    overflow-wrap: anywhere;
  }

  .flight-note {
    grid-column: 2;
    color: var(--server);
    font-size: 0.82rem;
  }

  .flight-note::before {
    content: "↳ ";
    color: var(--dim);
  }

  .drawn {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 24px 48px;
    align-items: end;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .drawn-text {
    display: grid;
    gap: 12px;
    color: var(--mist);
    font-size: 0.95rem;
  }

  .drawn :global(.region.faint) {
    opacity: 0.35;
  }

  .drawn-now {
    min-height: 1.5em;
    color: var(--paper);
    font: 400 0.82rem / 1.5 var(--mono);
  }

  /* One screen that comes apart as it scrolls into view: the Client's rows slide left,
     over the Client's card, the Server's right, over the Server's. The resting state is
     the split one: without scroll-driven animations or with reduced motion, it is shown. */
  .parting {
    --gap: 100px;
    position: relative;
    display: grid;
    margin: clamp(48px, 6vw, 80px) 0 0;
    view-timeline: --parting block;
  }

  .part {
    grid-area: 1 / 1;
    justify-self: center;
    width: calc(50% - var(--gap));
  }

  .part :global(.term) {
    background: transparent;
  }

  .client-part {
    transform: translateX(calc(-50% - var(--gap)));
  }

  .server-part {
    transform: translateX(calc(50% + var(--gap)));
  }

  .client-part :global(.term) {
    border-color: var(--client);
  }

  .server-part :global(.term) {
    border-color: var(--server);
  }

  .between {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 2px 1ch;
    background: var(--night);
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  @supports (animation-timeline: view()) {
    .part,
    .part :global(.term),
    .part :global(.bar),
    .between {
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --parting;
      animation-range: entry 80% cover 55%;
    }

    .client-part,
    .server-part {
      animation-name: together;
    }

    .part :global(.term) {
      animation-name: neutral;
    }

    /* Each half names itself only once it stands apart. */
    .part :global(.bar),
    .between {
      animation-name: appear;
    }
  }

  @keyframes together {
    from {
      transform: none;
    }
  }

  @keyframes neutral {
    from {
      border-color: var(--rule-strong);
    }
  }

  @keyframes appear {
    from,
    60% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .part,
    .part :global(.term),
    .part :global(.bar),
    .between {
      animation: none;
    }
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px minmax(0, 1fr);
    align-items: stretch;
    margin-top: 28px;
  }

  .half {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 24px 26px;
    border: 1px solid var(--rule);
    border-top: 2px solid;
  }

  .half p:not(.out) {
    color: var(--mist);
    font-size: 0.92rem;
  }

  .client-half {
    border-top-color: var(--client);
  }

  .server-half {
    border-top-color: var(--server);
  }

  .client-half .out code {
    color: var(--client);
  }

  .server-half .out code {
    color: var(--server);
  }

  .out code {
    padding: 0;
    background: none;
    font-size: 0.85rem;
  }

  .bridge {
    position: relative;
    display: grid;
    align-content: center;
    gap: 40px;
    padding: 0 14px;
    color: var(--mist);
    font: 400 0.72rem / 1.5 var(--mono);
    text-align: center;
  }

  .bridge::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    border-top: 1px dashed var(--rule-strong);
  }

  /* A packet going back and forth: the one motion that is always on, because it is the idea. */
  .bridge::after {
    content: "";
    position: absolute;
    top: calc(50% - 3px);
    left: 0;
    width: 7px;
    height: 7px;
    animation: packet 3.2s steps(24) infinite alternate;
  }

  @keyframes packet {
    from {
      left: 0;
      background: var(--client);
    }
    49.99% {
      background: var(--client);
    }
    50% {
      background: var(--server);
    }
    to {
      left: calc(100% - 7px);
      background: var(--server);
    }
  }

  @media (max-width: 860px) {
    .body,
    .drawn {
      grid-template-columns: 1fr;
    }

    .tree {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .pane :global(pre),
    .flight {
      height: 420px;
    }

    .split {
      grid-template-columns: 1fr;
    }

    /* Too narrow to slide: the two halves, one above the other. */
    .parting {
      gap: 36px;
    }

    .part,
    .client-part,
    .server-part {
      grid-area: auto;
      width: 100%;
      transform: none;
      animation: none;
    }

    .part :global(.term),
    .part :global(.bar) {
      animation: none;
    }

    .between {
      position: static;
      justify-self: center;
      order: 1;
      transform: none;
      animation: none;
    }

    .server-part {
      order: 2;
    }

    .bridge {
      padding: 28px 0;
    }

    .bridge::before {
      top: 0;
      bottom: 0;
      left: 50%;
      border-top: 0;
      border-left: 1px dashed var(--rule-strong);
    }

    .bridge::after {
      display: none;
    }

    .bridge span {
      position: relative;
      padding: 4px 0;
      background: var(--night);
    }
  }
</style>
