---
// The code section, drawn rather than shown: the tree of examples/notes as the App Router
// lays one out, then what `luciole build` makes of it, each file on the side it runs on.
// The sides are those of the real files: a layout, loading.tsx and error.tsx are Client
// Components in luciole, a page a Server Component. The tree stays neutral; the build sorts.
import { source } from "../lib/links";

type Side = "client" | "server";
type Node = { name: string; role?: string; side?: Side; children?: Node[] };
// A rail is one column of the tree's drawing: a line going on, nothing, or a branch.
type Rail = "pipe" | "blank" | "tee" | "elbow";
type Row = { rails: Rail[]; name: string; role?: string; side?: Side; path: string };

const tree: Node[] = [
  {
    name: "app/",
    role: "the route tree",
    children: [
      { name: "layout.tsx", role: "stays around every page", side: "client" },
      { name: "page.tsx", role: "the empty state at /", side: "server" },
      { name: "error.tsx", role: "shows when a page fails", side: "client" },
      {
        name: "notes/",
        children: [
          {
            name: "[id]/",
            role: "one segment: /notes/42",
            children: [
              { name: "page.tsx", role: "reads the note", side: "server" },
              { name: "loading.tsx", role: "shows until it arrives", side: "client" },
            ],
          },
        ],
      },
    ],
  },
  { name: "actions/", children: [{ name: "notes.ts", role: "saves a note", side: "server" }] },
  {
    name: "components/",
    children: [{ name: "NoteEditor.tsx", role: "edits it as you type", side: "client" }],
  },
];

// Flattened as `tree` prints it, each row knowing its rails and its path from the root.
const flatten = (nodes: Node[], dir = "", above: boolean[] = []): Row[] =>
  nodes.flatMap((node, i) => {
    const last = i === nodes.length - 1;
    const rails: Rail[] = [...above.map((on): Rail => (on ? "pipe" : "blank")), last ? "elbow" : "tee"];
    const path = dir + node.name;
    const row: Row = { rails, name: node.name, role: node.role, side: node.side, path };
    return [row, ...flatten(node.children ?? [], path, [...above, !last])];
  });

const rows = flatten(tree);

const sides: { side: Side; title: string; does: string }[] = [
  { side: "client", title: "your terminal", does: "draws every screen, answers every key" },
  { side: "server", title: "the server", does: "runs your pages and actions, next to your data" },
];

// A chip names the file by its path from the root, the directories dimmed.
const split = (path: string) => {
  const cut = path.lastIndexOf("/") + 1;
  return { dir: path.slice(0, cut), base: path.slice(cut) };
};
---

<section class="section" id="code" aria-labelledby="code-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">code</p>
      <h2 id="code-title">
        <span class="phrase">The folder you know.</span> <span class="phrase">Split in two.</span>
      </h2>
      <p class="lede">
        Lay out <code>app/</code> as you would for Next.js. <code>luciole build</code> sends each file to its
        side. One difference: layouts and loading screens run in your terminal, so changing pages never
        waits to start.
      </p>
    </div>

    <figure class="split" data-split aria-label="The files of the Notes example and the side each one runs on">
      <div class="tree" data-from>
        <a class="tree-title" href={source("examples/notes")}>
          examples/notes<span class="out" aria-hidden="true"> ↗</span>
        </a>
        <ul>
          {
            rows.map((row) => (
              <li
                class:list={{ dir: row.name.endsWith("/") }}
                data-file={row.side && row.path}
                data-side={row.side}
              >
                <span class="name">
                  {row.rails.map((rail) => <span class:list={["rail", rail]} aria-hidden="true" />)}{row.name}
                </span>
                {row.role && <span class="role">{row.role}</span>}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="prism">
        <span class="build" data-build>luciole build</span>
      </div>

      <div class="sides">
        {
          sides.map((side) => (
            <div class:list={["side", side.side]} data-to={side.side}>
              <div class="head">
                {side.side === "client" ? (
                  <svg class="icon" viewBox="0 0 32 32" aria-hidden="true" data-anchor>
                    <rect x="3" y="5" width="26" height="22" rx="2" />
                    <path d="M9 13 l4 3 -4 3" />
                    <path d="M16 20 h6" />
                  </svg>
                ) : (
                  <svg class="icon" viewBox="0 0 32 32" aria-hidden="true" data-anchor>
                    <ellipse cx="16" cy="8.5" rx="11" ry="3.5" />
                    <path d="M5 8.5 v15 c0 1.9 4.9 3.5 11 3.5 s11 -1.6 11 -3.5 v-15" />
                    <path d="M5 16 c0 1.9 4.9 3.5 11 3.5 s11 -1.6 11 -3.5" />
                  </svg>
                )}
                <div>
                  <p class="title">
                    <span class={side.side}>{side.title}</span>
                  </p>
                  <p class="does">{side.does}</p>
                </div>
              </div>
              <ul class="chips">
                {rows
                  .filter((row) => row.side === side.side)
                  .map((row) => (
                    <li data-file={row.path} data-side={row.side}>
                      <span class="chip-dir">{split(row.path).dir}</span>{split(row.path).base}
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>

      <svg class="wires" aria-hidden="true" data-wires>
        <path class="in" />
        <path class="to-client" data-wire="client" />
        <path class="to-server" data-wire="server" />
        <circle class="knot" data-knot="from" r="3" />
        <circle class="knot" data-knot="fork" r="3" />
      </svg>
    </figure>
  </div>
</section>

<script>
  // The wires are drawn from where the boxes are, not from a stretched drawing: the trunk
  // leaves the tree at its middle, forks past the label, and each branch lands level with
  // its side's icon. Pointing at a file lights it, its chip and the branch it takes.
  const figure = document.querySelector<HTMLElement>("[data-split]");
  const wires = figure?.querySelector<SVGSVGElement>("[data-wires]");
  const from = figure?.querySelector<HTMLElement>("[data-from]");
  const label = figure?.querySelector<HTMLElement>("[data-build]");
  if (figure && wires && from && label) {
    const draw = () => {
      if (getComputedStyle(wires).display === "none") return;
      const box = figure.getBoundingClientRect();
      const tree = from.getBoundingClientRect();
      const x0 = tree.right - box.left;
      const y0 = tree.top + tree.height / 2 - box.top;
      const ends = ["client", "server"].map((side) => {
        const card = figure.querySelector<HTMLElement>(`[data-to="${side}"]`)!;
        const icon = card.querySelector("[data-anchor]")!.getBoundingClientRect();
        return { side, x: card.getBoundingClientRect().left - box.left, y: icon.top + icon.height / 2 - box.top };
      });
      const gap = Math.min(...ends.map((end) => end.x)) - x0;
      // The fork sits past the label, so no branch ever crosses it.
      const fx = x0 + Math.min(Math.max(gap * 0.4, label.offsetWidth + 24), gap - 32);
      wires.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      wires.querySelector(".in")!.setAttribute("d", `M${x0} ${y0} H${fx}`);
      for (const end of ends) {
        const mid = fx + (end.x - fx) / 2;
        wires
          .querySelector(`[data-wire="${end.side}"]`)!
          .setAttribute("d", `M${fx} ${y0} C${mid} ${y0}, ${mid} ${end.y}, ${end.x} ${end.y}`);
      }
      // A knot where the folder leaves the tree, as one, and where it forks.
      for (const [name, x] of [["from", x0], ["fork", fx]] as const) {
        const knot = wires.querySelector(`[data-knot="${name}"]`)!;
        knot.setAttribute("cx", String(x));
        knot.setAttribute("cy", String(y0));
      }
      figure.style.setProperty("--build-x", `${(x0 + fx) / 2}px`);
      figure.style.setProperty("--build-y", `${y0}px`);
      figure.dataset.drawn = "";
    };
    new ResizeObserver(draw).observe(figure);
    document.fonts.ready.then(draw);

    const files = [...figure.querySelectorAll<HTMLElement>("[data-file]")];
    const light = (file?: string, side?: string) => {
      for (const each of files) each.classList.toggle("lit", !!file && each.dataset.file === file);
      if (side) figure.dataset.side = side;
      else delete figure.dataset.side;
    };
    figure.addEventListener("pointerover", (event) => {
      const at = (event.target as Element).closest<HTMLElement>("[data-file]");
      light(at?.dataset.file, at?.dataset.side);
    });
    figure.addEventListener("pointerleave", () => light());
  }
</script>

<style>
  .phrase {
    display: inline-block;
  }

  .lede code {
    white-space: nowrap;
  }

  /* Three columns, read left to right: the tree, the build, the two sides. The wires are
     laid over the whole figure. */
  .split {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(150px, 3fr) minmax(0, 5fr);
    align-items: center;
    margin: 0;
  }

  .tree {
    padding: 18px 20px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--panel);
    font: 400 0.85rem / 1.5 var(--mono);
  }

  .tree-title {
    display: inline-block;
    margin-bottom: 6px;
    color: var(--paper);
    font-weight: 600;
    text-decoration: underline dotted var(--dim);
    text-underline-offset: 4px;
  }

  /* Clear of the dotted underline, which sits 4px below the text. */
  .tree-title:focus-visible {
    outline-offset: 7px;
  }

  .tree-title:hover {
    text-decoration-color: var(--paper);
  }

  .out {
    color: var(--dim);
    font-weight: 400;
  }

  /* One grid for every row, so the roles start in one column. */
  .tree ul {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1ch;
    margin: 0 -8px;
    padding: 0;
    list-style: none;
  }

  .tree li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: stretch;
    padding-inline: 8px;
    border-radius: var(--radius);
    color: var(--paper);
    transition: background-color 120ms;
  }

  .tree li.dir {
    color: var(--mist);
  }

  .name {
    display: flex;
    align-items: center;
    padding-block: 3px;
    white-space: nowrap;
  }

  /* Rows touch, so the rails run unbroken from one row to the next, as lines, not glyphs. */
  /* A dotted leader from the name to its role, faint enough to guide without drawing. */
  .tree li:has(.role) .name::after {
    content: "";
    flex: 1;
    min-width: 2ch;
    margin-left: 1ch;
    border-bottom: 1px dotted var(--rule-strong);
    transform: translateY(0.35em);
    opacity: 0.6;
  }

  .rail {
    position: relative;
    flex: none;
    align-self: stretch;
    width: 3ch;
    margin-block: -3px;
  }

  .rail.pipe::before,
  .rail.tee::before,
  .rail.elbow::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.6ch;
    border-left: 1px solid var(--rule-strong);
  }

  .rail.elbow::before {
    bottom: 50%;
  }

  .rail.tee::after,
  .rail.elbow::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0.6ch;
    width: 1.8ch;
    border-top: 1px solid var(--rule-strong);
  }

  .role {
    align-self: center;
    color: var(--dim);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The build: one line in, a knot where it forks, one line out to each side. */
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .wires path {
    fill: none;
    stroke-width: 1.5;
    transition:
      opacity 120ms,
      stroke-width 120ms;
  }

  .in {
    stroke: var(--mist);
  }

  .to-client {
    stroke: var(--client);
  }

  .to-server {
    stroke: var(--server);
    stroke-dasharray: var(--server-dash, none);
  }

  .knot {
    fill: var(--paper);
  }

  .build {
    color: var(--paper);
    font: 600 0.75rem / 1 var(--mono);
    white-space: nowrap;
  }

  /* Wide: over the trunk, centred between the tree and the knot, once the wires are drawn. */
  @media (min-width: 901px) {
    .build {
      position: absolute;
      top: calc(var(--build-y, 50%) - 1.4em);
      left: var(--build-x, 50%);
      transform: translateX(-50%);
      opacity: 0;
    }

    .split[data-drawn] .build {
      opacity: 1;
    }
  }

  .sides {
    display: grid;
    gap: 40px;
  }

  .side {
    --tone: var(--client);
    display: grid;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid color-mix(in srgb, var(--tone) 55%, transparent);
    border-radius: 4px;
    background: var(--panel);
    transition: opacity 120ms;
  }

  .side.server {
    --tone: var(--server);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .icon {
    flex: none;
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--tone);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .title {
    font: 600 var(--step-1) / 1.3 var(--mono);
  }

  .title > span {
    color: var(--paper);
  }

  .title > span::before {
    color: var(--tone);
  }

  .does {
    color: var(--mist);
    font-size: 0.88rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 0.78rem / 1.4 var(--mono);
  }

  .chips li {
    padding: 3px 8px;
    border: 1px solid var(--rule-strong);
    color: var(--paper);
    transition:
      border-color 120ms,
      background-color 120ms;
  }

  .chip-dir {
    color: var(--dim);
  }

  /* Pointing at a file: it, its chip and its branch light; the other side steps back. */
  .tree li.lit {
    background: color-mix(in srgb, var(--client) 12%, transparent);
  }

  .tree li.lit[data-side="server"] {
    background: color-mix(in srgb, var(--server) 12%, transparent);
  }

  .chips li.lit {
    border-color: var(--tone);
    background: color-mix(in srgb, var(--tone) 12%, transparent);
  }

  .split[data-side] :is(.to-client, .to-server) {
    opacity: 0.25;
  }

  .split[data-side="client"] .to-client,
  .split[data-side="server"] .to-server {
    opacity: 1;
    stroke-width: 2;
  }

  .split[data-side="client"] .side.server,
  .split[data-side="server"] .side.client {
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .tree li,
    .wires path,
    .side,
    .chips li {
      transition: none;
    }
  }

  /* Narrow: one above the other, the build between, pointing down. */
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }

    .prism {
      display: grid;
      place-items: center;
      height: 80px;
    }

    .wires {
      display: none;
    }

    .build::before {
      content: "↓ " / "";
    }

    .build::after {
      content: " ↓" / "";
    }
  }

  /* Phone: the roles wrap rather than lose their end; the rails stretch with the row. */
  @media (max-width: 560px) {
    .role {
      padding-block: 3px;
      white-space: normal;
    }
  }
</style>
