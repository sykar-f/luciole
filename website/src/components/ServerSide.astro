---
// The code section, drawn rather than shown: the tree of examples/notes as the App Router
// lays one out, each file with the convention it follows and the side it runs on, then
// what `airtty build` makes of it. The sides are those of the real files: a layout,
// loading.tsx and error.tsx are Client Components in airtty, a page a Server Component.
import { source } from "../lib/links";

type Side = "client" | "server";
type Row = { depth: number; name: string; role?: string; side?: Side };

const tree: Row[] = [
  { depth: 0, name: "app/", role: "the route tree" },
  { depth: 1, name: "layout.tsx", role: "around every page", side: "client" },
  { depth: 1, name: "page.tsx", role: "the route /", side: "server" },
  { depth: 1, name: "error.tsx", role: "when a page fails", side: "client" },
  { depth: 1, name: "notes/" },
  { depth: 2, name: "[id]/", role: "a segment: /notes/42" },
  { depth: 3, name: "page.tsx", role: "reads the note", side: "server" },
  { depth: 3, name: "loading.tsx", role: "while it travels", side: "client" },
  { depth: 0, name: "actions/" },
  { depth: 1, name: "notes.ts", role: '"use server"', side: "server" },
  { depth: 0, name: "components/" },
  { depth: 1, name: "NoteEditor.tsx", role: '"use client"', side: "client" },
];

const sides: { side: Side; title: string; does: string; files: string[] }[] = [
  {
    side: "client",
    title: "your terminal",
    does: "draws every screen, handles every key",
    files: ["layout.tsx", "error.tsx", "loading.tsx", "NoteEditor.tsx"],
  },
  {
    side: "server",
    title: "the server",
    does: "reads and writes your data, renders the pages",
    files: ["page.tsx", "notes/[id]/page.tsx", "actions/notes.ts"],
  },
];
---

<section class="section" id="code" aria-labelledby="code-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">code</p>
      <h2 id="code-title">The App Router's layout. Already proven.</h2>
      <p class="lede">
        <code>app/</code> is the route tree, as in Next.js: a <code>page.tsx</code> per route, a
        <code>layout.tsx</code> around it, <code>loading.tsx</code> and <code>error.tsx</code> beside it,
        <code>[id]</code> for a segment, <code>"use client"</code> and <code>"use server"</code> where code
        runs. Conventions you already know; <code>airtty build</code> sends each file to its side.
      </p>
    </div>

    <figure class="split" aria-label="The files of the Notes example and the side each one runs on">
      <div class="tree">
        <a class="tree-title" href={source("examples/notes")}>examples/notes</a>
        <ul>
          {
            tree.map((row) => (
              <li class:list={[row.side, { dir: row.name.endsWith("/") }]} style={`--depth:${row.depth}`}>
                <span class="name">{row.name}</span>
                {row.role && <span class="role">{row.role}</span>}
                {row.side && <span class="dot" aria-label={row.side} />}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="prism" aria-hidden="true">
        <span class="build">airtty build</span>
        <svg viewBox="0 0 120 240" preserveAspectRatio="none">
          <path class="in" d="M0 120 H52" />
          <path class="to-client" d="M52 120 C80 120, 80 40, 120 40" />
          <path class="to-server" d="M52 120 C80 120, 80 200, 120 200" />
          <polygon class="gem" points="52,104 68,120 52,136 36,120" />
        </svg>
      </div>

      <div class="sides">
        {
          sides.map((side) => (
            <div class:list={["side", side.side]}>
              <div class="head">
                {side.side === "client" ? (
                  <svg class="icon" viewBox="0 0 48 36" aria-hidden="true">
                    <rect x="1" y="1" width="46" height="34" rx="3" />
                    <path d="M1 9 H47" />
                    <path d="M8 17 l6 5 -6 5" />
                    <path d="M18 27 H28" />
                  </svg>
                ) : (
                  <svg class="icon" viewBox="0 0 48 36" aria-hidden="true">
                    <rect x="6" y="1" width="36" height="10" rx="2" />
                    <rect x="6" y="13" width="36" height="10" rx="2" />
                    <rect x="6" y="25" width="36" height="10" rx="2" />
                    <path d="M12 6 h2 M12 18 h2 M12 30 h2" />
                  </svg>
                )}
                <div>
                  <p class="title">{side.title}</p>
                  <p class="does">{side.does}</p>
                </div>
              </div>
              <ul class="chips">
                {side.files.map((file) => (
                  <li>{file}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </figure>
  </div>
</section>

<style>
  /* Three columns, read left to right: the tree, the build, the two sides. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(80px, 2fr) minmax(0, 5fr);
    align-items: center;
    margin: 0;
  }

  .tree {
    padding: 18px 20px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--panel);
    font: 400 0.85rem / 1.5 var(--mono);
  }

  .tree-title {
    display: block;
    margin-bottom: 10px;
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }

  .tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A row: the file at its depth, the convention it follows, the side it runs on. */
  .tree li {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) 10px;
    align-items: center;
    gap: 12px;
    padding: 3px 0 3px calc(var(--depth) * 2.2ch);
    color: var(--paper);
  }

  .tree li.dir {
    color: var(--mist);
  }

  .tree li:not(.dir) .name::before {
    content: "· " / "";
    color: var(--dim);
  }

  .role {
    color: var(--dim);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dot {
    grid-column: 3;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .client .dot {
    background: var(--client);
  }

  .server .dot {
    border: 1.5px var(--server-line) var(--server);
  }

  /* The build: one line in, two out, a facet where it splits. */
  .prism {
    position: relative;
    align-self: stretch;
    display: grid;
    align-items: center;
  }

  .prism svg {
    width: 100%;
    height: min(100%, 320px);
    overflow: visible;
  }

  .prism path {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .in {
    stroke: var(--mist);
  }

  .to-client {
    stroke: var(--client);
  }

  .to-server {
    stroke: var(--server);
    stroke-dasharray: var(--server-dash, none);
  }

  .gem {
    fill: var(--night);
    stroke: var(--paper);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* Above the facet, where neither side's line passes (the facet sits at 52/120). */
  .build {
    position: absolute;
    top: calc(50% - 40px);
    left: calc(52 / 120 * 100%);
    color: var(--paper);
    font: 600 0.75rem / 1 var(--mono);
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .sides {
    display: grid;
    gap: 40px;
  }

  .side {
    display: grid;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid;
    border-radius: 4px;
    background: var(--panel);
  }

  .side.client {
    border-color: color-mix(in srgb, var(--client) 55%, transparent);
  }

  .side.server {
    border-color: color-mix(in srgb, var(--server) 55%, transparent);
    border-style: var(--server-line);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .icon {
    flex: none;
    width: 48px;
    height: 36px;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .client .icon {
    stroke: var(--client);
  }

  .server .icon {
    stroke: var(--server);
  }

  .title {
    color: var(--paper);
    font: 600 var(--step-1) / 1.3 var(--mono);
  }

  .does {
    color: var(--mist);
    font-size: 0.88rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 0.78rem / 1.4 var(--mono);
  }

  .chips li {
    padding: 3px 8px;
    border: 1px solid var(--rule-strong);
    color: var(--paper);
  }

  /* Narrow: one above the other, the build between, pointing down. */
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }

    .prism {
      height: 80px;
    }

    .prism svg {
      display: none;
    }

    .build {
      position: static;
      text-align: center;
      transform: none;
    }

    .build::before {
      content: "↓ " / "";
    }

    .build::after {
      content: " ↓" / "";
    }
  }
</style>
