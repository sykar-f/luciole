---
// Real lines of the checkout, found by anchors at build time. `mark` highlights the lines that
// carry the point, so the eye goes there first. A tone other than neutral names its side in
// the bar, in words: the colour only repeats it.
import { Code } from "astro:components";
import type { BundledLanguage, ShikiTransformer } from "shiki";
import { night } from "../../lib/codeTheme";
import { excerpt, whole } from "../../lib/docs/source";
import { source } from "../../lib/links";
import type { Tone } from "../../lib/docs/tones";

interface Props {
  path: string;
  find?: string;
  until?: string;
  count?: number;
  after?: string;
  mark?: string[];
  tone?: Tone;
  lang?: BundledLanguage;
  caption?: string;
}

const { path, find, until, count, after, mark = [], tone = "neutral", caption } = Astro.props;
const sides: Record<Tone, string> = { client: "Client", server: "Server", wire: "Wire", build: "Build", neutral: "" };
const side = sides[tone];
const lang: BundledLanguage =
  Astro.props.lang ?? (path.endsWith(".rs") ? "rust" : path.endsWith(".json") ? "json" : "tsx");
const picked = find === undefined ? { code: whole(path), start: 1, end: whole(path).split("\n").length } : excerpt(path, { find, until, count, after });
const name = path.replace(/^packages\/core\//, "");
const lines = picked.start === picked.end ? `${picked.start}` : `${picked.start}–${picked.end}`;

for (const text of mark) {
  if (!picked.code.includes(text)) throw new Error(`Docs: ${JSON.stringify(text)} is not in the excerpt of ${path}:${lines}`);
}
const transformers: ShikiTransformer[] = [
  {
    name: "excerpt-mark",
    line(node, line) {
      const text = this.source.split("\n")[line - 1] ?? "";
      if (mark.some((m) => text.includes(m))) this.addClassToHast(node, "marked");
    },
  },
];
---

<figure class={`excerpt tone-${tone}`} data-figure="excerpt" data-tone={tone}>
  <div class="bar">
    <a href={`${source(path)}#L${picked.start}${picked.end > picked.start ? `-L${picked.end}` : ""}`}>{name}<span>:{lines}</span></a>
    {tone !== "neutral" && <span class="side" data-side={tone}>{side}</span>}
  </div>
  <Code code={picked.code} lang={lang} theme={night} transformers={transformers} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .excerpt {
    margin: 1.4em 0;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 7px 14px;
    border: 1px solid var(--rule);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: color-mix(in srgb, var(--paper) 3%, transparent);
    font: 400 0.75rem / 1.5 var(--mono);
    box-shadow: inset 3px 0 0 var(--tone);
  }

  .bar a {
    color: var(--mist);
    text-decoration: none;
  }

  .bar a:hover {
    color: var(--paper);
  }

  .bar a span {
    color: var(--dim);
  }

  .side {
    flex-shrink: 0;
    color: var(--tone);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tone-client { --tone: var(--client); }
  .tone-server { --tone: var(--server); }
  .tone-wire { --tone: var(--wire); }
  .tone-build { --tone: var(--build); }
  .tone-neutral { --tone: var(--rule-strong); }

  .excerpt :global(pre) {
    margin: 0;
    padding: 12px 0;
    border: 1px solid var(--rule);
    border-radius: 0 0 4px 4px;
    background: var(--code-bg) !important;
    overflow-x: auto;
    font: 400 0.8rem / 1.65 var(--term);
    font-variant-ligatures: none;
    scrollbar-width: thin;
  }

  .excerpt :global(pre code) {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  .excerpt :global(.line) {
    display: inline-block;
    width: 100%;
    padding: 0 16px;
  }

  /* With marked lines, the rest steps back: one quiet colour, still read at 4.5:1
     (--code-dimmed, checked by scripts/palettes.py), never a fade. */
  .excerpt:has(:global(.marked)) :global(.line:not(.marked)),
  .excerpt:has(:global(.marked)) :global(.line:not(.marked) span) {
    color: var(--code-dimmed) !important;
  }

  .excerpt :global(.marked) {
    background: linear-gradient(90deg, color-mix(in srgb, var(--paper) 7%, transparent), transparent 80%);
    box-shadow: inset 2px 0 var(--tone);
  }
</style>
