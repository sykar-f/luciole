---
// The hero's app, Notes, on the reader's machine: three commands, checked in a PTY, then
// a file to edit whose change shows on the screen (airtty dev rebuilds and reopens it).
import CopyCommand from "./CopyCommand.astro";
import { repo, source } from "../lib/links";

const EDIT = "examples/notes/components/NoteList.tsx";
---

<section class="section" id="start" aria-labelledby="start-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">start</p>
      <h2 id="start-title">Start locally. Both sides run on your machine.</h2>
      <p class="lede">
        The same Notes as above, with every request half a second late. You need Bun 1.4.2, on macOS
        or Linux.
      </p>
    </div>

    <div class="transcript">
      <p class="bar" aria-hidden="true"><span><b>┤</b> ~ <b>├</b></span></p>
      <CopyCommand
        lines={[
          `git clone ${repo} && cd airtty`,
          "bun install --frozen-lockfile",
          "AIRTTY_LATENCY_MS=500 bun run dev",
        ]}
        plain
      />
      <p class="then">
        <span aria-hidden="true"># </span>Now edit <a href={source(EDIT)}><code>{EDIT}</code></a>: change{" "}
        <code>YOUR NOTES</code>, save, and the terminal rebuilds and reopens the same screen.
      </p>
    </div>

    <div class="next">
      <a class="button primary" href="/docs/getting-started/">Build your first app</a>
      <a class="button" href={repo}>Star on GitHub</a>
    </div>
  </div>
</section>

<style>
  /* One shell session: the commands, then what to do with them. */
  .transcript {
    position: relative;
    display: grid;
    gap: 14px;
    max-width: 900px;
    padding: 24px clamp(14px, 3vw, 28px) 18px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--panel);
  }

  .bar {
    position: absolute;
    top: -0.75em;
    left: 14px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .bar span {
    padding: 0 0.5ch;
    background: var(--night);
  }

  .bar b {
    color: var(--rule-strong);
    font-weight: 400;
  }

  .then {
    padding-top: 12px;
    border-top: 1px dashed var(--rule);
    color: var(--mist);
    font: 400 0.88rem / 1.7 var(--mono);
  }

  .then > span {
    color: var(--dim);
  }

  .then code {
    padding: 0;
    background: none;
    color: var(--paper);
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
