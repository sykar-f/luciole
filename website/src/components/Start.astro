---
// Your own app in a minute, written as it will read once the package is published: `init`
// copies the hero's Notes as a project of yours, `dev` runs both sides and rebuilds on a
// save. Names come from lib/product.ts: a rename is that file.
import CopyCommand from "./CopyCommand.astro";
import { repo } from "../lib/links";
import { commands } from "../lib/product";

const EDIT = "components/NoNoteShown.tsx";
---

<section class="section" id="start" aria-labelledby="start-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">start</p>
      <h2 id="start-title">Your app, running in a minute.</h2>
      <p class="lede">
        <code>{commands.cli} init</code> gives you the Notes above as a project of your own. Three
        commands, then edit a file. You need Bun 1.4.2, on macOS or Linux.
      </p>
    </div>

    <div class="transcript">
      <p class="bar" aria-hidden="true"><span><b>┤</b> ~ <b>├</b></span></p>
      <ol class="steps">
        {
          [`bunx ${commands.cli} init my-app`, "cd my-app && bun install", "bun run dev"].map((line) => (
            <li>
              <CopyCommand lines={[line]} plain />
            </li>
          ))
        }
      </ol>
      <p class="then">
        <span aria-hidden="true"># </span>Now edit <code>{EDIT}</code>: change <code>No note selected</code>,
        save, and the terminal rebuilds and reopens the same screen.
      </p>
    </div>

    <div class="next">
      <a class="button primary" href="/docs/getting-started/">Build your first app</a>
      <a class="button" href={repo}>Star on GitHub</a>
    </div>
  </div>
</section>

<style>
  /* One shell session: the commands, then what to do with them. */
  .transcript {
    position: relative;
    display: grid;
    gap: 14px;
    max-width: 900px;
    padding: 24px clamp(14px, 3vw, 28px) 18px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--panel);
  }

  .bar {
    position: absolute;
    top: -0.75em;
    left: 14px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .bar span {
    padding: 0 0.5ch;
    background: var(--night);
  }

  .bar b {
    color: var(--rule-strong);
    font-weight: 400;
  }

  .steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li + li {
    padding-top: 10px;
    margin-top: 10px;
    border-top: 1px dashed var(--rule);
  }

  .then {
    padding-top: 12px;
    border-top: 1px dashed var(--rule);
    color: var(--mist);
    font: 400 0.88rem / 1.7 var(--mono);
  }

  .then > span {
    color: var(--dim);
  }

  .then code {
    padding: 0;
    background: none;
    color: var(--paper);
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
