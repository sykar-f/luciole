---
// The hero: the same Notes twice, both over SSH, the same round trip (500 ms, the reader's
// slider sets it), placed differently. Left, a classic TUI, the whole app on the host: every
// key and click waits. Right, the luciole app (`notes --on host`): its client in the terminal,
// only requests wait. Whatever the reader does in one
// is replayed in the other (docs/WEB.md, "Page embarquée", `typed`), and the page's largest
// type is not a claim but a measure: how long each screen took, from the key to its cells.
// Each keeps its side; one stands in front, the other a step behind it, still in sight: a
// click brings it forward, on its own side.
import HeroField from "./HeroField.astro";
import Screen from "./Screen.astro";
import { frame } from "../lib/frames";

const COLUMNS = 84;
const ROWS = 24;
/** The note both screens open on: the duel shows Notes at work, not asking for a note. */
const OPEN = "/notes/1";
const look = new URLSearchParams({
  columns: String(COLUMNS),
  rows: String(ROWS),
  restore: "off",
  path: OPEN,
});
const src = `/demo/notes/index.html?${look}`;
/** luciole's screen in front: the reader's first key lands where it answers at once, and the
 *  classic one, behind, shows the same key arriving a round trip later. */
const sides = [
  { id: "ssh", name: "Classic TUI", tag: "over SSH", depth: "back" },
  { id: "luciole", name: "luciole app", tag: "over SSH", depth: "front" },
];
/** The height of a cell of the live terminal, in ems of its font, about what xterm.js draws
 *  with the runtime's fonts: the frame's proportions until the script measures the exact
 *  cell (`fit`), or without it. */
const LINE = 1.2;
/** The round trip both screens start with, and how far the reader's slider takes it. */
const PING = { value: 500, min: 20, max: 1000, step: 10 };
const notes = frame("notes");
/** What luciole keeps in the terminal, turn by turn in the title: the first is the one
 *  without motion, and the one the duel measures. */
const LOCAL = ["typing", "scrolling", "hovering", "selecting", "pasting", "resizing"];
---

<section
  class="hero"
  id="top"
  data-duel
  data-columns={COLUMNS}
  data-rows={ROWS}
  style={`--columns:${COLUMNS};--rows:${ROWS};--cell-line:${LINE}`}
>
  <HeroField />
  <div class="wrap">
    <div class="top">
      <h1 aria-label={`With luciole, ${LOCAL.join(", ")}: none of it waits for the network.`}>
        <span class="line" aria-hidden="true">
          With luciole,{" "}
          <span class="rotor" data-rotor>
            {LOCAL.map((word, index) => <span class:list={{ now: index === 0 }}>{word}</span>)}
          </span>
        </span>
        <span class="line" aria-hidden="true">never waits for the network.</span>
      </h1>
      <p class="sub">
        luciole splits your React app in two: Server Components render next to your data, the client
        runs in your terminal, smooth at any ping.
      </p>
      <div class="actions">
        <a class="button primary" href="#start">Start a project</a>
        <a class="button" href="#code">See the code</a>
      </div>
    </div>

    <div class="controls">
      <label class="ping" data-ping-control>
        Same ping for both
        <input type="range" data-ping min={PING.min} max={PING.max} step={PING.step} value={PING.value} />
        <output data-ping-value>{PING.value} ms</output>
      </label>
    </div>

    <div class="pair">
      {
        sides.map((side) => (
          <figure class:list={["pane", side.id]} data-pane={side.id} data-depth={side.depth}>
            <figcaption class="tag">
              <b>{side.name}</b> · {side.tag}
            </figcaption>
            <div class="glass">
              <div class="frame" data-frame={side.id} data-src={src} data-title={`Notes, ${side.name}`}>
                <Screen frame={notes} class="poster" />
              </div>
            </div>
            <div class="raise" data-raise aria-hidden="true" />
            <p class="reading" aria-live="polite">
              <output data-ms />
              <span class="unit">ms</span>
              <span class="what">key to screen</span>
            </p>
          </figure>
        ))
      }
    </div>

    <p class="narrow">On a wider screen, both run live.</p>
  </div>
</section>

<script>
  import * as z from "zod/mini";
  import { gridSize } from "../lib/cells";
  import { overscroll } from "../lib/overscroll";
  import { screenColours } from "../lib/recolor";
  import { writes } from "../lib/writes";

  const Drawn = z.object({ source: z.literal("luciole"), type: z.literal("stage"), stage: z.literal("drawn") });
  const Typed = z.object({ source: z.literal("luciole"), type: z.literal("typed"), data: z.string() });
  const Connection = z.object({ saveData: z.optional(z.boolean()) });

  /** A key its screen has not answered this long after it reached it changed nothing. */
  const ANSWER_MS = 250;
  /** How wide a cell of the capture is, in ems of its font: JetBrains Mono's advance. */
  const CAPTURE_CELL = 0.6;
  /** Below this width, two 84-column screens are too small to use: their captures stay. */
  const NARROW = "(max-width: 760px)";
  const ESC = "\u001b";
  /** A mouse report (SGR or X10): measured keys are keys, not the pointer's moves. */
  const mouse = (data: string) => data.startsWith(`${ESC}[<`) || data.startsWith(`${ESC}[M`);
  /** A focus report: the frame's own focus, which the other frame never had. */
  const focus = (data: string) => data === `${ESC}[I` || data === `${ESC}[O`;

  // The word ending the title's first line turns through what stays in the terminal; held
  // still when the reader asks for less motion.
  const TURN_MS = 2200;
  /** How long a word takes to leave: the rotor's transition, in the styles below. */
  const LEAVE_MS = 400;
  const rotor = document.querySelector<HTMLElement>("[data-rotor]");
  if (rotor && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = [...rotor.children];
    let at = 0;
    setInterval(() => {
      if (document.hidden) return;
      words[at].classList.replace("now", "gone");
      const was = words[at];
      setTimeout(() => was.classList.remove("gone"), LEAVE_MS);
      at = (at + 1) % words.length;
      words[at].classList.add("now");
    }, TURN_MS);
  }

  const root = document.querySelector<HTMLElement>("[data-duel]");
  const saving = Connection.safeParse(Reflect.get(navigator, "connection")).data?.saveData === true;
  if (root) {
    fit(root);
    const raise = stage(root);
    if (!matchMedia(NARROW).matches && !saving) duel(root, raise);
  }

  /** Where the reader types in a screen: its terminal's input, in the frame (same origin). */
  const keyboard = (pane: HTMLElement) => {
    const frame = pane.querySelector("iframe");
    frame?.focus({ preventScroll: true });
    frame?.contentDocument
      ?.querySelector<HTMLElement>(".xterm-helper-textarea")
      ?.focus({ preventScroll: true });
  };

  /**
   * Each frame exactly as large as its grid at the size the runtime will draw it at
   * (lib/cells.ts): the capture is drawn on those cells, and the live terminal, a margin
   * larger on each side, fits that size and no other. Both screens share it: the one
   * behind is laid out as the front one and only drawn smaller.
   */
  function fit(root: HTMLElement) {
    const columns = Number(root.dataset.columns);
    const rows = Number(root.dataset.rows);
    const pane = root.querySelector<HTMLElement>("[data-pane]");
    const glass = pane?.querySelector<HTMLElement>(".glass");
    if (!pane || !glass) return;
    const size = () => {
      const look = getComputedStyle(glass);
      const chrome = ["paddingLeft", "paddingRight", "borderLeftWidth", "borderRightWidth"] as const;
      const room = pane.clientWidth - chrome.reduce((sum, side) => sum + parseFloat(look[side]), 0);
      const grid = gridSize(columns, rows, room);
      if (!grid) return;
      // The capture's font fills the width: its rows take the height.
      const capture = grid.width / columns / CAPTURE_CELL;
      root.style.setProperty("--grid-width", `${grid.width}px`);
      root.style.setProperty("--grid-height", `${grid.height}px`);
      root.style.setProperty("--cell-line", String(grid.height / rows / capture));
      root.dataset.sized = "";
    };
    size();
    new ResizeObserver(size).observe(pane);
  }

  /**
   * One screen in front, the other floating behind it (the styles below). A click on the
   * one behind brings it forward and gives it the keyboard: that click lands on a cover
   * over the screen, never in the app. Returns how to bring a screen forward.
   */
  function stage(root: HTMLElement) {
    const panes = [...root.querySelectorAll<HTMLElement>("[data-pane]")];
    const raise = (pane: HTMLElement) => {
      if (pane.dataset.depth === "front") return;
      for (const each of panes) each.dataset.depth = each === pane ? "front" : "back";
    };
    for (const pane of panes)
      pane.querySelector("[data-raise]")?.addEventListener("click", () => {
        raise(pane);
        keyboard(pane);
      });
    return raise;
  }

  function duel(root: HTMLElement, raise: (pane: HTMLElement) => void) {
    const { background, foreground } = screenColours();
    const frames: HTMLIFrameElement[] = [];
    for (const holder of root.querySelectorAll<HTMLElement>("[data-frame]")) {
      const url = new URL(holder.dataset.src ?? "", location.href);
      url.searchParams.set("background", background.slice(1));
      url.searchParams.set("foreground", foreground.slice(1));
      const frame = document.createElement("iframe");
      frame.title = holder.dataset.title ?? "";
      frame.dataset.side = holder.dataset.frame;
      frame.src = url.href;
      holder.prepend(frame);
      frames.push(frame);
    }
    const post = (frame: HTMLIFrameElement, message: Record<string, unknown>) =>
      frame.contentWindow?.postMessage({ source: "luciole", ...message }, location.origin);
    const ssh = (frame: HTMLIFrameElement) => frame.dataset.side === "ssh";
    // The reader's ping: both screens get it at once, keys already on their way keep theirs.
    const slider = root.querySelector<HTMLInputElement>("[data-ping]");
    const shown = root.querySelector<HTMLOutputElement>("[data-ping-value]");
    /** The round trip, as the slider sets it. */
    let rtt = slider ? Number(slider.value) : 0;
    const network = (frame: HTMLIFrameElement) =>
      post(frame, { type: "network", latencyMs: rtt, delays: ssh(frame) ? "keys" : "requests" });
    slider?.addEventListener("input", () => {
      rtt = Number(slider.value);
      if (shown) shown.value = `${rtt} ms`;
      for (const frame of frames) network(frame);
    });
    const paneOf = (frame: HTMLIFrameElement) => frame.closest<HTMLElement>("[data-pane]");

    // The measure: from the moment a key left the reader's hand to the first cells its
    // screen rewrote once the key had reached it (at once for luciole, a round trip later
    // over SSH): what the screen drew before comes from something else. One key at a time.
    const pending = new Map<HTMLIFrameElement, { typed: number; reached: number }>();
    const measured = (frame: HTMLIFrameElement) => {
      const key = pending.get(frame);
      const now = performance.now();
      if (!key || now < key.reached) return;
      pending.delete(frame);
      if (now > key.reached + ANSWER_MS) return;
      const pane = paneOf(frame);
      const output = pane?.querySelector<HTMLOutputElement>("[data-ms]");
      if (output) output.value = String(Math.round(now - key.typed));
      pane?.classList.add("measured");
    };

    addEventListener("message", (event) => {
      const frame = frames.find((f) => f.contentWindow === event.source);
      if (!frame) return;
      // Once drawn: the poster goes, the cells the app rewrites are timed, and the
      // round trip sits before each key (SSH) or each request (luciole).
      if (Drawn.safeParse(event.data).success) {
        // The grid in the middle of its frame: what the font's steps leave over is shared
        // between the four sides, as around the capture it replaces.
        const centre = frame.contentDocument?.createElement("style");
        if (centre) {
          centre.textContent = "#luciole { display: grid; place-content: center }";
          frame.contentDocument?.head.append(centre);
        }
        frame.parentElement?.classList.add("on");
        const signal = new AbortController().signal;
        // A turn of the wheel the app has nothing left to scroll for goes on to the page:
        // as the screen shows it, so the turns still crossing the round trip over SSH
        // are not taken for nothing to scroll.
        overscroll({ frame, signal });
        writes({ frame, signal, onWritten: () => measured(frame) });
        return void network(frame);
      }
      // What one terminal sent, the other gets: at once for luciole's, whose keys never
      // travel; a round trip later for SSH's, as if typed there. The frame typed in holds
      // its own keys back itself (`delays`).
      const typed = Typed.safeParse(event.data);
      if (!typed.success) return;
      const { data } = typed.data;
      if (focus(data)) return;
      if (!mouse(data)) {
        const now = performance.now();
        for (const each of frames) {
          const waiting = pending.get(each);
          if (!waiting || now > waiting.reached + ANSWER_MS)
            pending.set(each, { typed: now, reached: now + (ssh(each) ? rtt : 0) });
        }
      }
      for (const other of frames) {
        if (other === frame) continue;
        const send = () => post(other, { type: "input", data });
        if (ssh(other)) setTimeout(send, rtt);
        else send();
      }
    });

    // Which screen has the reader's hands: the frame the focus went into. Reached with the
    // keyboard, the screen behind comes forward.
    const mark = () => {
      for (const pane of root.querySelectorAll<HTMLElement>("[data-pane]")) {
        const held = pane.contains(document.activeElement);
        pane.classList.toggle("held", held);
        if (held) raise(pane);
      }
    };
    addEventListener("blur", () => setTimeout(mark));
    addEventListener("focus", mark);
  }
</script>

<style>
  /* The first view is the hero whole: the title, the screens and their measures share the
     window's height instead of crowding its top. */
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - 61px);
    padding: clamp(24px, 4vh, 72px) 0 clamp(112px, 16vh, 150px);
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }

  /* The product said once, plainly: the title across both screens, then how on the left
     and what to do about it on the right, over the screen each side belongs to. */
  .top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 20px clamp(20px, 2.5vw, 36px);
    margin-bottom: clamp(20px, 3.5vh, 48px);
  }

  h1 {
    grid-column: 1 / -1;
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.8rem);
    letter-spacing: -0.01em;
  }

  /* Two lines, the turning word last on the first, so nothing after it ever moves. */
  h1 .line {
    display: block;
  }

  /* The turning word: each one slides up into place. */
  .rotor {
    display: inline-grid;
    overflow: clip;
    overflow-clip-margin: 0.15em;
    color: var(--client);
  }

  .rotor > span {
    grid-area: 1 / 1;
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
  }

  .rotor > .now {
    transform: none;
    opacity: 1;
  }

  .rotor > .gone {
    transform: translateY(-100%);
  }

  .sub {
    max-width: 52ch;
    color: var(--mist);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Between the screens and the title, what the reader sets for both: one ping, the only
     thing they change about the network. */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 5ch;
    margin-bottom: 20px;
    font: 400 0.8rem / 1.4 var(--mono);
    color: var(--mist);
  }

  .ping {
    display: flex;
    align-items: center;
    gap: 1.5ch;
  }

  .ping input {
    width: min(240px, 30vw);
    height: 16px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }

  .ping input::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--rule-strong);
  }

  .ping input::-moz-range-track {
    height: 1px;
    background: var(--rule-strong);
  }

  .ping input::-webkit-slider-thumb {
    width: 10px;
    height: 16px;
    margin-top: -8px;
    border: 0;
    border-radius: 0;
    background: var(--paper);
    appearance: none;
  }

  .ping input::-moz-range-thumb {
    width: 10px;
    height: 16px;
    border: 0;
    border-radius: 0;
    background: var(--paper);
  }

  .ping input:focus-visible {
    outline: 2px solid var(--dominant);
    outline-offset: 4px;
  }

  .ping output {
    min-width: 7ch;
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 2.5vw, 36px);
  }

  .pane {
    position: relative;
    display: grid;
    min-width: 0;
    margin: 0;
  }

  /* Wide: a stage. Each screen keeps its side, the classic one left and luciole's right,
     so the comparison reads the same whatever is in front. The one in front is at its full
     size and flat, so its cells stay sharp; the other steps back on its own side, a little
     smaller, dimmer and turned toward the middle, where the two overlap slightly. Both are
     laid out at the same size and only the transform differs: trading places is a
     transition, and the live terminals never refit on the way. */
  @media (min-width: 761px) {
    /* Wider than the column of text above it: the screens are what the reader came for.
       Each screen takes a little more than half of it, so they overlap in the middle; in
       a short window the whole stage narrows, so the measure under the screen in front
       stays in the first view (what the title and the controls leave of the window's
       height, at the frame's proportions). */
    .pair {
      --share: 0.57;
      align-self: center;
      width: min(
        100vw - 64px,
        1440px,
        max(720px, calc(((100svh - 520px) * 1.91 + 18px) / var(--share)))
      );
      grid-template-columns: 1fr;
    }

    .pane {
      grid-area: 1 / 1;
      width: calc(var(--share) * 100%);
      transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
    }

    /* Each steps back toward its outer edge: the overlap in the middle only shrinks. */
    .ssh {
      justify-self: start;
      transform-origin: 0 50%;
    }

    .luciole {
      justify-self: end;
      transform-origin: 100% 50%;
    }

    .pane[data-depth="front"] {
      z-index: 2;
    }

    .pane[data-depth="back"] {
      z-index: 1;
    }

    .ssh[data-depth="back"] {
      transform: perspective(1600px) rotateY(12deg) scale(0.86);
    }

    .luciole[data-depth="back"] {
      transform: perspective(1600px) rotateY(-12deg) scale(0.86);
    }

    /* The overlap is in the middle: each screen's name and measure sit on its outer edge,
       in sight whichever screen is in front. */
    .luciole .tag {
      right: 16px;
      left: auto;
    }

    .luciole .reading {
      right: 0;
    }

    /* The measure behind is drawn smaller with its screen, and dimmer. */
    .reading {
      transition: opacity 0.6s ease;
    }

    .pane[data-depth="back"] .reading {
      opacity: 0.55;
    }

    /* Over the screen behind, a cover that takes the click bringing it forward: the app
       under it never hears that click. It dims the screen a little, less when pointed at. */
    .raise {
      position: absolute;
      z-index: 4;
      inset: 0;
      border-radius: 4px;
      background: color-mix(in srgb, var(--night) 22%, transparent);
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .raise:hover {
      background: color-mix(in srgb, var(--night) 6%, transparent);
    }

    .pane[data-depth="front"] .raise {
      display: none;
    }
  }

  @media (min-width: 761px) and (prefers-reduced-motion: reduce) {
    .pane,
    .reading {
      transition: none;
    }
  }

  /* Each screen's name and link, set in its top edge like a window title. */
  .tag {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 16px;
    padding: 0 8px;
    transform: translateY(-50%);
    background: var(--night);
    font: 400 0.8rem / 1.4 var(--mono);
    color: var(--mist);
  }

  .tag b {
    color: var(--paper);
    font-weight: 600;
  }

  .luciole .tag b {
    color: var(--client);
  }

  /* Under each screen, its measure, as large as the page gets: nothing until a key has
     been timed, so the number and what it counts appear together. It lands in the hero's
     bottom padding, out of the flow: the screens never move under the reader's hands, and
     nothing invisible weighs on the layout before. */
  .reading {
    position: absolute;
    top: 100%;
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    margin: 14px 0 0;
    color: var(--paper);
    visibility: hidden;
  }

  .measured .reading {
    visibility: visible;
  }

  .reading output {
    font: 600 clamp(3rem, 1.5rem + 4vw, 5.5rem) / 1 var(--mono);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .ssh .reading output {
    color: var(--mist);
  }

  .unit {
    font: 500 1.1rem / 1 var(--mono);
    color: var(--mist);
  }

  .what {
    margin-left: 1ch;
    font: 400 0.85rem / 1 var(--mono);
    color: var(--mist);
  }

  /* Around the cells, the margin the runtime's page keeps around its terminal (web/index.html,
     #luciole): the live frame covers it, the capture sits inside it. It is also what lets
     the runtime fit the grid beside its scroll bar (14px) without fitting a larger one. */
  .glass {
    --margin: 8px;
    padding: var(--margin);
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--screen);
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.35),
      0 28px 60px -18px rgb(0 0 0 / 0.7);
    cursor: text;
  }

  /* Each screen's selection ring: white for the classic one, green for luciole's. */
  .ssh {
    --edge: var(--paper);
  }

  .luciole {
    --edge: var(--client);
  }

  .luciole .glass {
    border-color: color-mix(in srgb, var(--client) 55%, transparent);
  }

  /* The screen that has the keyboard is ringed in its own colour. */
  .held .glass {
    outline: 2px solid var(--edge);
    outline-offset: 3px;
  }

  /* The cells and nothing else: the frame is as wide and high as the grid, at the live
     terminal's cell. The capture holds the place until the app has drawn over it. */
  .frame {
    position: relative;
    aspect-ratio: calc(var(--columns) * 0.6) / calc(var(--rows) * var(--cell-line));
  }

  /* Sized by the script to the live grid (fit): the glass wraps it. */
  [data-sized] .glass {
    justify-self: center;
  }

  [data-sized] .frame {
    width: var(--grid-width);
    height: var(--grid-height);
    aspect-ratio: auto;
  }

  .frame :global(.bar) {
    display: none;
  }

  .frame :global(.term) {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }

  .frame :global(.screen) {
    overflow: hidden;
    padding: 0;
    border-radius: 0;
  }

  .frame :global(.grid) {
    margin: 0;
    font-size: calc(100cqw / var(--cols) / 0.6);
  }

  .frame :global(iframe) {
    position: absolute;
    inset: calc(-1 * var(--margin));
    width: calc(100% + 2 * var(--margin));
