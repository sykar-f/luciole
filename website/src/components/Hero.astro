---
import LatencyDemo from "./LatencyDemo.astro";

// The title is typed, one line after the other, a character at a time: short, so the demo
// under it is there to play at once.
const title = ["Build terminal apps", "with React."];
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="intro">
      <h1 style={`--longest:${Math.max(...title.map((line) => line.length))}`}>
        {
          title.map((line, i) => (
            <>
              <span class:list={["typed", { last: i === title.length - 1 }]} style={`--n:${line.length};--line:${i}`}>
                {line}
              </span>
              {i < title.length - 1 && " "}
            </>
          ))
        }
      </h1>
      <div class="pitch">
        <p class="lede">
          Keep typing while your server works. airtty brings React Server Components to a native
          terminal client.
        </p>
        <div class="actions">
          <button type="button" class="button primary" data-play>Play with the demo</button>
          <a class="button" href="#start">Run it locally</a>
        </div>
        <p class="proof">
          <a href="/status/">
            Experimental · installed from the repository · Bun 1.4.2 · macOS &amp; Linux · every screen
            on this site is a live app or a real capture
          </a>
        </p>
      </div>
    </div>

    <LatencyDemo />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(32px, 4.5vw, 56px) 0 clamp(56px, 7vw, 96px);
  }

  /* The title on the left; the pitch and what to do about it on the right. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: end;
    gap: 20px clamp(32px, 4vw, 64px);
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .pitch {
    display: grid;
    gap: 18px;
  }

  .lede {
    color: var(--paper);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  button.button {
    cursor: pointer;
  }

  .proof {
    color: var(--mist);
    font: 400 0.78rem / 1.6 var(--mono);
  }

  .proof a {
    color: inherit;
    text-decoration-color: var(--rule-strong);
  }

  .proof a::after {
    content: " ›" / "";
  }

  /* As large as its column allows: each line is one line, the width of its letters. */
  h1 {
    font-size: min(
      var(--step-4),
      calc((min(100vw, var(--page)) - 2 * var(--gutter)) * 0.54 / (var(--longest) + 1) / 0.6)
    );
    letter-spacing: 0;
    line-height: 1.15;
  }

  /* Typed at the cursor: a block, the width of a character, that moves as the line grows,
     then blinks at the end of the last one. */
  .typed {
    --at: calc(0.2s + var(--line) * 0.9s);
    display: inline-block;
    box-sizing: content-box;
    width: calc(var(--n) * 1ch);
    border-right: 1ch solid transparent;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation:
      type calc(var(--n) * 40ms) steps(var(--n)) var(--at) both,
      caret calc(var(--n) * 40ms) steps(1) var(--at);
  }

  .typed.last {
    animation:
      type calc(var(--n) * 40ms) steps(var(--n)) var(--at) both,
      blink 1.1s steps(1) var(--at) infinite;
  }

  @keyframes type {
    from {
      width: 0;
    }
  }

  @keyframes caret {
    from,
    to {
      border-right-color: var(--dominant);
    }
  }

  @keyframes blink {
    0%,
    50% {
      border-right-color: var(--dominant);
    }
    50.01%,
    100% {
      border-right-color: transparent;
    }
  }

  /* Where the demo does not start (LiveTerminal: below 760 px), nothing to play with. */
  @media (max-width: 760px) {
    [data-play] {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .intro {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: min(var(--step-4), calc((100vw - 2 * var(--gutter)) / (var(--longest) + 1) / 0.6));
    }
  }

  /* Still: the title is written, the cursor lit. */
  @media (prefers-reduced-motion: reduce) {
    .typed,
    .typed.last {
      animation: none;
    }

    .typed.last {
      border-right-color: var(--dominant);
    }
  }
</style>
