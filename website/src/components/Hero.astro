---
// The hero: the same Notes twice, both over SSH, the same round trip (500 ms, the reader's
// slider sets it), placed differently. Left, a classic TUI, the whole app on the host: every
// key and click waits. Right, the luciole app (`notes --on host`): its client in the terminal,
// only requests wait. Whatever the reader does in one
// is replayed in the other (docs/WEB.md, "Page embarquée", `typed`), and the page's largest
// type is not a claim but a measure: how long each screen took, from the key to its cells.
import HeroField from "./HeroField.astro";
import Screen from "./Screen.astro";
import { frame } from "../lib/frames";

const COLUMNS = 84;
const ROWS = 24;
const look = new URLSearchParams({ columns: String(COLUMNS), rows: String(ROWS), restore: "off" });
const src = `/demo/notes/index.html?${look}`;
const sides = [
  { id: "ssh", name: "Classic TUI", tag: "over SSH" },
  { id: "luciole", name: "luciole app", tag: "over SSH" },
];
/** The round trip both screens start with, and how far the reader's slider takes it. */
const PING = { value: 500, min: 20, max: 1000, step: 10 };
const notes = frame("notes");
/** What luciole keeps in the terminal, turn by turn in the title: the first is the one
 *  without motion, and the one the duel measures. */
const LOCAL = ["typing", "scrolling", "hovering", "selecting", "pasting", "resizing"];
---

<section class="hero" id="top" data-duel data-columns={COLUMNS} data-rows={ROWS}>
  <HeroField />
  <div class="wrap">
    <div class="top">
      <h1 aria-label={`With luciole, ${LOCAL.join(", ")}: none of it waits for the network.`}>
        <span class="line" aria-hidden="true">
          With luciole,{" "}
          <span class="rotor" data-rotor>
            {LOCAL.map((word, index) => <span class:list={{ now: index === 0 }}>{word}</span>)}
          </span>
        </span>
        <span class="line" aria-hidden="true">never waits for the network.</span>
      </h1>
      <p class="sub">
        luciole splits your React app in two: Server Components render next to your data, the client
        runs in your terminal.
      </p>
      <div class="actions">
        <a class="button primary" href="#start">Start a project</a>
        <a class="button" href="#code">See the code</a>
      </div>
    </div>

    <label class="ping" data-ping-control>
      Same ping for both
      <input type="range" data-ping min={PING.min} max={PING.max} step={PING.step} value={PING.value} />
      <output data-ping-value>{PING.value} ms</output>
    </label>

    <div class="pair">
      {
        sides.map((side) => (
          <figure class:list={["pane", side.id]} data-pane={side.id}>
            <figcaption class="tag">
              <b>{side.name}</b> · {side.tag}
            </figcaption>
            <div class="glass">
              <div class="frame" data-frame={side.id} data-src={src} data-title={`Notes, ${side.name}`}>
                <Screen frame={notes} class="poster" />
                <div class="glows" data-glows aria-hidden="true" />
              </div>
            </div>
            <p class="reading" aria-live="polite">
              <output data-ms />
              <span class="unit">ms</span>
              <span class="what">key to screen</span>
            </p>
          </figure>
        ))
      }
    </div>

    <p class="narrow">On a wider screen, both run live.</p>
  </div>
</section>

<script>
  import * as z from "zod/mini";
  import { glowWrites } from "../lib/glow";
  import { overscroll } from "../lib/overscroll";
  import { screenColours } from "../lib/recolor";

  const Drawn = z.object({ source: z.literal("luciole"), type: z.literal("stage"), stage: z.literal("drawn") });
  const Typed = z.object({ source: z.literal("luciole"), type: z.literal("typed"), data: z.string() });
  const Connection = z.object({ saveData: z.optional(z.boolean()) });

  /** The round trip, as the slider sets it. */
  let rtt = 500;
  /** A key its screen has not answered this long after it reached it changed nothing. */
  const ANSWER_MS = 250;
  /** Below this width, two 84-column screens are too small to use: their captures stay. */
  const NARROW = "(max-width: 760px)";
  const ESC = "\u001b";
  /** A mouse report (SGR or X10): measured keys are keys, not the pointer's moves. */
  const mouse = (data: string) => data.startsWith(`${ESC}[<`) || data.startsWith(`${ESC}[M`);
  /** A focus report: the frame's own focus, which the other frame never had. */
  const focus = (data: string) => data === `${ESC}[I` || data === `${ESC}[O`;

  // The word ending the title's first line turns through what stays in the terminal; held
  // still when the reader asks for less motion.
  const TURN_MS = 2200;
  const rotor = document.querySelector<HTMLElement>("[data-rotor]");
  if (rotor && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = [...rotor.children];
    let at = 0;
    setInterval(() => {
      if (document.hidden) return;
      words[at].classList.replace("now", "gone");
      const was = words[at];
      setTimeout(() => was.classList.remove("gone"), 400);
      at = (at + 1) % words.length;
      words[at].classList.add("now");
    }, TURN_MS);
  }

  const root = document.querySelector<HTMLElement>("[data-duel]");
  const saving = Connection.safeParse(Reflect.get(navigator, "connection")).data?.saveData === true;
  if (root && !matchMedia(NARROW).matches && !saving) duel(root);

  function duel(root: HTMLElement) {
    const columns = Number(root.dataset.columns);
    const rows = Number(root.dataset.rows);
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const { background, foreground } = screenColours();
    const frames: HTMLIFrameElement[] = [];
    for (const holder of root.querySelectorAll<HTMLElement>("[data-frame]")) {
      const url = new URL(holder.dataset.src ?? "", location.href);
      url.searchParams.set("background", background.slice(1));
      url.searchParams.set("foreground", foreground.slice(1));
      const frame = document.createElement("iframe");
      frame.title = holder.dataset.title ?? "";
      frame.dataset.side = holder.dataset.frame;
      frame.src = url.href;
      holder.prepend(frame);
      frames.push(frame);
    }
    const post = (frame: HTMLIFrameElement, message: Record<string, unknown>) =>
      frame.contentWindow?.postMessage({ source: "luciole", ...message }, location.origin);
    const ssh = (frame: HTMLIFrameElement) => frame.dataset.side === "ssh";
    const network = (frame: HTMLIFrameElement) =>
      post(frame, { type: "network", latencyMs: rtt, delays: ssh(frame) ? "keys" : "requests" });

    // The reader's ping: both screens get it at once, keys already on their way keep theirs.
    const slider = root.querySelector<HTMLInputElement>("[data-ping]");
    const shown = root.querySelector<HTMLOutputElement>("[data-ping-value]");
    slider?.addEventListener("input", () => {
      rtt = Number(slider.value);
      if (shown) shown.value = `${rtt} ms`;
      for (const frame of frames) network(frame);
    });
    const paneOf = (frame: HTMLIFrameElement) => frame.closest<HTMLElement>("[data-pane]");

    // The measure: from the moment a key left the reader's hand to the first cells its
    // screen rewrote once the key had reached it (at once for luciole, a round trip later
    // over SSH): what the screen drew before comes from something else. One key at a time.
    const pending = new Map<HTMLIFrameElement, { typed: number; reached: number }>();
    const measured = (frame: HTMLIFrameElement) => {
      const key = pending.get(frame);
      const now = performance.now();
      if (!key || now < key.reached) return;
      pending.delete(frame);
      if (now > key.reached + ANSWER_MS) return;
      const pane = paneOf(frame);
      const output = pane?.querySelector<HTMLOutputElement>("[data-ms]");
      if (output) output.value = String(Math.round(now - key.typed));
      pane?.classList.add("measured");
    };

    addEventListener("message", (event) => {
      const frame = frames.find((f) => f.contentWindow === event.source);
      if (!frame) return;
      // Once drawn: the poster goes, the cells the app rewrites glow and are timed, and the
      // round trip sits before each key (SSH) or each request (luciole).
      if (Drawn.safeParse(event.data).success) {
        frame.parentElement?.classList.add("on");
        const signal = new AbortController().signal;
        // A turn of the wheel the app has nothing to scroll for goes on to the page, once
        // the app has had the time to answer it: a round trip later over SSH.
        const answered = overscroll({ frame, delayMs: () => (ssh(frame) ? rtt : 0), signal });
        const layer = frame.parentElement?.querySelector<HTMLElement>("[data-glows]");
        if (layer)
          glowWrites({
            frame,
            layer: still ? document.createElement("div") : layer,
            columns,
            rows,
            signal,
            onWritten: () => {
              answered();
              measured(frame);
            },
          });
        return void network(frame);
      }
      // What one terminal sent, the other gets: at once for luciole's, whose keys never
      // travel; a round trip later for SSH's, as if typed there. The frame typed in holds
      // its own keys back itself (`delays`).
      const typed = Typed.safeParse(event.data);
      if (!typed.success) return;
      const { data } = typed.data;
      if (focus(data)) return;
      if (!mouse(data)) {
        const now = performance.now();
        for (const each of frames) {
          const waiting = pending.get(each);
          if (!waiting || now > waiting.reached + ANSWER_MS)
            pending.set(each, { typed: now, reached: now + (ssh(each) ? rtt : 0) });
        }
      }
      for (const other of frames) {
        if (other === frame) continue;
        const send = () => post(other, { type: "input", data });
        if (ssh(other)) setTimeout(send, rtt);
        else send();
      }
    });

    // Which screen has the reader's hands: the frame the focus went into.
    const mark = () => {
      for (const pane of root.querySelectorAll<HTMLElement>("[data-pane]"))
        pane.classList.toggle("held", pane.contains(document.activeElement));
    };
    addEventListener("blur", () => setTimeout(mark));
    addEventListener("focus", mark);
  }
</script>

<style>
  /* The first view is the hero whole: the title, the screens and their measures share the
     window's height instead of crowding its top. */
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - 61px);
    padding: clamp(40px, 6vh, 72px) 0 clamp(112px, 16vh, 150px);
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }

  /* The product said once, plainly: the title across both screens, then how on the left
     and what to do about it on the right, over the screen each side belongs to. */
  .top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 20px clamp(20px, 2.5vw, 36px);
    margin-bottom: clamp(28px, 5vh, 48px);
  }

  h1 {
    grid-column: 1 / -1;
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.8rem);
    letter-spacing: -0.01em;
  }

  /* Two lines, the turning word last on the first, so nothing after it ever moves. */
  h1 .line {
    display: block;
  }

  /* The turning word: each one slides up into place. */
  .rotor {
    display: inline-grid;
    overflow: clip;
    overflow-clip-margin: 0.15em;
    color: var(--client);
  }

  .rotor > span {
    grid-area: 1 / 1;
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
  }

  .rotor > .now {
    transform: none;
    opacity: 1;
  }

  .rotor > .gone {
    transform: translateY(-100%);
  }

  .sub {
    max-width: 52ch;
    color: var(--mist);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* One ping for both screens, set between them and the title: the only thing the reader
     changes about the network. */
  .ping {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5ch;
    margin-bottom: 28px;
    font: 400 0.8rem / 1.4 var(--mono);
    color: var(--mist);
  }

  .ping input {
    width: min(240px, 30vw);
    height: 16px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }

  .ping input::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--rule-strong);
  }

  .ping input::-moz-range-track {
    height: 1px;
    background: var(--rule-strong);
  }

  .ping input::-webkit-slider-thumb {
    width: 10px;
    height: 16px;
    margin-top: -8px;
    border: 0;
    border-radius: 0;
    background: var(--paper);
    appearance: none;
  }

  .ping input::-moz-range-thumb {
    width: 10px;
    height: 16px;
    border: 0;
    border-radius: 0;
    background: var(--paper);
  }

  .ping input:focus-visible {
    outline: 2px solid var(--dominant);
    outline-offset: 4px;
  }

  .ping output {
    min-width: 7ch;
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 2.5vw, 36px);
  }

  .pane {
    position: relative;
    display: grid;
    margin: 0;
  }

  /* Each screen's name and link, set in its top edge like a window title. */
  .tag {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 16px;
    padding: 0 8px;
    transform: translateY(-50%);
    background: var(--night);
    font: 400 0.8rem / 1.4 var(--mono);
    color: var(--mist);
  }

  .tag b {
    color: var(--paper);
    font-weight: 600;
  }

  .luciole .tag b {
    color: var(--client);
  }

  /* Under each screen, its measure, as large as the page gets: nothing until a key has
     been timed, so the number and what it counts appear together. It lands in the hero's
     bottom padding, out of the flow: the screens never move under the reader's hands, and
     nothing invisible weighs on the layout before. */
  .reading {
    position: absolute;
    top: 100%;
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    margin: 14px 0 0;
    color: var(--paper);
    visibility: hidden;
  }

  .measured .reading {
    visibility: visible;
  }

  .reading output {
    font: 600 clamp(3rem, 1.5rem + 4vw, 5.5rem) / 1 var(--mono);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .ssh .reading output {
    color: var(--mist);
  }

  .unit {
    font: 500 1.1rem / 1 var(--mono);
    color: var(--mist);
  }

  .what {
    margin-left: 1ch;
    font: 400 0.85rem / 1 var(--mono);
    color: var(--mist);
  }

  .glass {
    padding: 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--screen);
    cursor: text;
  }

  .luciole .glass {
    border-color: color-mix(in srgb, var(--client) 55%, transparent);
  }

  .held .glass {
    outline: 2px solid var(--dominant);
    outline-offset: 3px;
  }

  /* The capture holds the place and the size until the app has drawn over it. */
  .frame {
    position: relative;
  }

  .frame :global(.bar) {
    display: none;
  }

  .frame :global(.term) {
    margin: 0;
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--screen);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .frame.on :global(iframe) {
    z-index: 1;
    opacity: 1;
  }

  /* Drawn over, the poster only keeps the size: clicks go to the app. */
  .frame.on :global(.stage) {
    visibility: hidden;
  }

  /* Over the frame, the cells its app just rewrote, glowing out (lib/glow.ts). */
  .glows {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glows :global(i) {
    position: absolute;
    background: color-mix(in srgb, var(--afterglow) 40%, transparent);
    box-shadow: 0 0 calc(var(--glow-blur) * 1.6) color-mix(in srgb, var(--afterglow) 50%, transparent);
    mix-blend-mode: screen;
    opacity: var(--glow, 1);
    animation: afterglow var(--glow-ms, 0.45s) forwards;
  }

  /* A firefly's flash: lit almost at once, then a slow fade, darkest last. */
  @keyframes afterglow {
    from {
      opacity: calc(var(--glow, 1) * 0.6);
      animation-timing-function: ease-out;
    }
    8% {
      opacity: var(--glow, 1);
      animation-timing-function: cubic-bezier(0.25, 0, 0.55, 1);
    }
    to {
      opacity: 0;
    }
  }

  .narrow {
    display: none;
    margin-top: 16px;
    color: var(--mist);
    font: 400 0.88rem / 1.6 var(--sans);
  }

  /* Narrow: the two captures, one above the other, and no measure to take. */
  @media (max-width: 760px) {
    .hero {
      min-height: 0;
      padding-bottom: 64px;
    }

    .top {
      grid-template-columns: 1fr;
    }

    .pair {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .reading,
    .ping {
      display: none;
    }

    .narrow {
      display: block;
    }

    .actions .button {
      flex: 1 1 100%;
      text-align: center;
    }
  }
</style>
