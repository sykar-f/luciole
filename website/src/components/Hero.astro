---
import LiveTerminal, { type Step } from "./LiveTerminal.astro";
import { frame } from "../lib/frames";
import { repo } from "../lib/links";

// Forge starts on its sign-in screen: the page signs in as alice and opens the pull request
// the capture shows, then hands over. A reader coming back finds it where they left it.
const signIn: Step[] = [
  { wait: "Demo accounts", type: "alice\r", pause: 250 },
  { wait: "Demo accounts", type: "forge\r" },
  { wait: "REVIEW REQUESTED", type: "j", pause: 250 },
  { wait: "REVIEW REQUESTED", type: "\r" },
  { wait: "wants to merge feature/refund-idempotency", type: "" },
];
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="intro">
      <a class="status" href="#limits">
        <span class="dot" aria-hidden="true"></span>
        Open source, experimental
        <span class="arrow" aria-hidden="true">›</span>
      </a>
      <h1>Build terminal apps<br class="wide" /> like web apps.</h1>
      <p class="lede">
        A React framework for the terminal. Pages render on a <span class="server">Server</span>,
        stream to a native terminal <span class="client">Client</span>, and your keystrokes never wait
        for the network.
      </p>
      <div class="actions">
        <a class="button primary" href="#start">Get started</a>
        <a class="button" href={repo}>View on GitHub</a>
      </div>
      <p class="needs">Bun 1.4.2, macOS and Linux</p>
    </div>

    <div class="showcase">
      <LiveTerminal
        demo="forge"
        frame={frame("forge-pr")}
        script={signIn}
        boot="eager"
        arriving="signing in as alice"
        printed
        glow
        tilt
      />
      <p class="caption">
        Forge, the code-review example, running in this page: its Server in a Worker, its
        database in SQLite. Click it and review.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(64px, 10vw, 128px) 0 clamp(72px, 9vw, 120px);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -30%;
    left: 50%;
    width: 1100px;
    height: 700px;
    background: radial-gradient(closest-side, rgb(103 217 188 / 0.13), transparent);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .intro {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 26px;
    margin-bottom: clamp(56px, 8vw, 96px);
    text-align: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: var(--mist);
    font-size: 0.8rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
  }

  .status:hover {
    color: var(--paper);
    border-color: rgb(255 255 255 / 0.25);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--server);
    box-shadow: 0 0 10px var(--server);
  }

  .arrow {
    color: var(--dim);
  }

  h1 {
    font-size: var(--step-4);
    background: linear-gradient(180deg, #fff 30%, #9fb0c6);
    background-clip: text;
    color: transparent;
  }

  @media (max-width: 600px) {
    .wide {
      display: none;
    }
  }

  .intro .lede {
    max-width: 58ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .needs {
    color: var(--dim);
    font-size: var(--step--1);
  }

  .caption {
    margin-top: 16px;
    color: var(--dim);
    font-size: var(--step--1);
    text-align: center;
  }
</style>
