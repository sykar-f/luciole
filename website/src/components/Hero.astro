---
import LiveTerminal, { type Step } from "./LiveTerminal.astro";
import { frame } from "../lib/frames";
import { repo } from "../lib/links";
// The framework's own version, read at build time, as `airtty --version` prints it.
import manifest from "../../../packages/airtty/package.json?raw";

// Forge starts on its sign-in screen: the page signs in as alice and opens the pull request
// the capture shows, then hands over. A reader coming back starts there again.
const signIn: Step[] = [
  { wait: "Demo accounts", type: "alice\r", pause: 250 },
  { wait: "Demo accounts", type: "forge\r" },
  { wait: "REVIEW REQUESTED", type: "j", pause: 250 },
  { wait: "REVIEW REQUESTED", type: "\r" },
  { wait: "wants to merge feature/refund-idempotency", type: "" },
];

// The title is typed, one line after the other, a character at a time.
const title = ["Build terminal apps", "like web apps."];
const { version } = JSON.parse(manifest) as { version: string };
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="intro">
      <p class="version">
        <span class="prompt" aria-hidden="true">$ </span>airtty --version<br />
        <span class="answer">
          {version} · <a href="#limits">Open source, experimental</a> · Bun 1.4.2, macOS and
          Linux
        </span>
      </p>
      <h1 style={`--longest:${Math.max(...title.map((line) => line.length))}`}>
        {
          title.map((line, i) => (
            <>
              <span class:list={["typed", { last: i === title.length - 1 }]} style={`--n:${line.length};--line:${i}`}>
                {line}
              </span>
              {i < title.length - 1 && " "}
            </>
          ))
        }
      </h1>
      <div class="pitch">
        <p class="lede">
          A React framework for the terminal. Pages render on a <span class="server">Server</span>,
          stream to a native terminal <span class="client">Client</span>, and your keystrokes never
          wait for the network.
        </p>
        <div class="actions">
          <a class="button primary" href="#start">Get started</a>
          <a class="button" href={repo}>View on GitHub</a>
        </div>
      </div>
    </div>

    <div class="showcase">
      <LiveTerminal
        demo="forge"
        frame={frame("forge-pr")}
        intro={[frame("forge-home")]}
        script={signIn}
        boot="eager"
        afterglow
      />
      <p class="caption">
        Forge, the code-review example, running in this page: its Server in a Worker, its
        database in SQLite. Click it and review.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 112px);
  }

  .intro {
    display: grid;
    gap: 28px;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .version {
    color: var(--mist);
    font: 400 0.88rem / 1.7 var(--mono);
  }

  .prompt {
    color: var(--dim);
  }

  .answer {
    color: var(--paper);
  }

  .answer a {
    text-decoration-color: var(--dim);
  }

  /* As large as the longest line allows: each line is one line, the width of its letters. */
  h1 {
    font-size: min(var(--step-4), calc((100vw - 2 * var(--gutter)) / (var(--longest) + 1) / 0.6));
    letter-spacing: 0;
    line-height: 1.15;
  }

  /* Typed at the cursor: a block, the width of a character, that moves as the line grows,
     then blinks at the end of the last one. */
  .typed {
    --at: calc(0.3s + var(--line) * 1.25s);
    display: inline-block;
    box-sizing: content-box;
    width: calc(var(--n) * 1ch);
    border-right: 1ch solid transparent;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation:
      type calc(var(--n) * 55ms) steps(var(--n)) var(--at) both,
      caret calc(var(--n) * 55ms) steps(1) var(--at);
  }

  .typed.last {
    animation:
      type calc(var(--n) * 55ms) steps(var(--n)) var(--at) both,
      blink 1.1s steps(1) var(--at) infinite;
  }

  @keyframes type {
    from {
      width: 0;
    }
  }

  @keyframes caret {
    from,
    to {
      border-right-color: var(--dominant);
    }
  }

  @keyframes blink {
    0%,
    50% {
      border-right-color: var(--dominant);
    }
    50.01%,
    100% {
      border-right-color: transparent;
    }
  }

  .pitch {
    display: grid;
    grid-template-columns: minmax(0, 58ch) auto;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* The screen switches on once the title is typed. */
  .showcase {
    --power-at: 1.6s;
  }

  .caption {
    margin-top: 8px;
    max-width: 70ch;
    color: var(--mist);
    font-size: var(--step--1);
  }

  @media (max-width: 860px) {
    .pitch {
      grid-template-columns: 1fr;
    }
  }

  /* Still: the title is written, the cursor lit. */
  @media (prefers-reduced-motion: reduce) {
    .typed,
    .typed.last {
      animation: none;
    }

    .typed.last {
      border-right-color: var(--dominant);
    }
  }
</style>
