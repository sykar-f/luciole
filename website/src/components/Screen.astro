---
// A captured terminal screen, drawn as text: every cell is the character and colours the
// application sent, so it stays sharp at any size and can be selected. Always a figure: a
// caption says what the screen shows, and its transcript, the rows as text, describes it
// to a screen reader and opens under it.
import { escape, frame as load, style, text, type Frame } from "../lib/frames";
import { uniqueId } from "../lib/transcripts";

/** The cells of the screen a piece of code drew, in rectangles of rows and columns. */
export type Rect = { row: number; col: number; rows: number; cols: number };
export type Region = { id: string; side: "client" | "server"; rects: Rect[] };

interface Props {
  /** The capture, or its name in src/frames/ (scripts/capture.py). */
  frame: Frame | string;
  /** What the screen shows, in a sentence. */
  caption: string;
  regions?: Region[];
  /** Print the rows one after the other, once, like a teletype. */
  printed?: boolean;
  /** Start dark and switch on like a tube: a line that opens to the whole screen. */
  poweron?: boolean;
  /**
   * Wider than the column, for a capture of many columns: in the docs, the screen takes
   * the room of the page's table of contents, so 140 columns keep 10px cells at 1280px.
   */
  wide?: boolean;
  /**
   * `poster`: the screen stands in for something drawn over it (a live demo). Its caption
   * and transcript stay for screen readers and take no room.
   * `paired`: a figure around it captions it with something else (CodeAndScreen). Its
   * caption stays for screen readers; its transcript still opens under it.
   */
  class?: string;
}

const {
  caption,
  regions = [],
  printed = false,
  poweron = false,
  wide = false,
  class: className,
} = Astro.props;
const frame = typeof Astro.props.frame === "string" ? load(Astro.props.frame) : Astro.props.frame;
if (!caption?.trim()) throw new Error(`Screen « ${frame.title} »: a caption is required.`);
const transcript = text(frame);

// The id the screen's description points to: from the capture's title, so the same on
// every build, and numbered on a page that shows one capture twice.
const id = uniqueId(Astro.locals, `screen-${frame.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`);

// Built as a string: whitespace inside <pre> is content, and templates add some.
const html = frame.cells
  .map((runs, i) => {
    const cells = runs.map((run) => {
      const css = style(run);
      const text = escape(run[0]);
      return css ? `<span style="${css}">${text}</span>` : text;
    });
    return `<span class="row" style="--i:${i}">${cells.join("") || " "}</span>`;
  })
  .join("");
---

<figure class:list={["stage", className, { wide }]} data-figure="screen">
  <div class:list={["term", { printed, poweron }]} style={`--cols:${frame.cols}`}>
    <div class="bar" aria-hidden="true">
      <span class="title"><b>┤</b> {frame.title} <b>├</b></span>
      <span class="size"><b>┤</b> {frame.cols}×{frame.rows} <b>├</b></span>
    </div>
    <div
      class="screen"
      role="img"
      aria-label={`${frame.title}, a ${frame.cols} by ${frame.rows} terminal screen`}
      aria-describedby={id}
    >
      <div class="grid">
        <pre aria-hidden="true" set:html={html} />
        {
          regions.flatMap((region) =>
            region.rects.map(({ row, col, rows, cols }) => (
              <span
                class:list={["region", region.side]}
                data-region={region.id}
                style={`--row:${row};--col:${col};--h:${rows};--w:${cols}`}
              />
            )),
          )
        }
      </div>
      <slot name="live" />
    </div>
  </div>
  <figcaption class="caption">{caption}</figcaption>
  <details class="transcript">
    <summary>Transcript</summary>
    <pre id={id} data-transcript>{transcript}</pre>
  </details>
</figure>

<style>
  .stage {
    position: relative;
    margin: 0;
  }

  :global(.prose) > .stage {
    margin-block: 1.6em;
  }

  .caption {
    margin-top: 10px;
    color: var(--dim);
    font: 400 0.8rem / 1.5 var(--sans);
  }

  .transcript {
    margin-top: 6px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .transcript summary {
    width: fit-content;
    cursor: pointer;
  }

  .transcript pre {
    margin: 8px 0 0;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--code-bg);
    color: var(--paper);
    overflow-x: auto;
    font: 400 0.75rem / 1.4 var(--term);
    scrollbar-width: thin;
  }

  /* Drawn over by a live demo, or captioned by the figure around it: the words stay for
     screen readers only. */
  .poster > .caption,
  .paired > .caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .poster > .transcript {
    display: none;
  }

  /* Wide, in the docs: over the table of contents' column and the gap before it (the
     grid of styles/docs.css), where there is one; above it as it scrolls by. */
  @media (min-width: 1181px) {
    :global(.docs) .wide > .term {
      z-index: 3;
      margin-right: calc(-1 * (var(--toc) + clamp(28px, 4vw, 56px)));
    }
  }

  /* A terminal, not a window: a ruled box with its title set into the top edge. */
  .term {
    position: relative;
    margin: 0;
    padding-top: 2px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--screen);
  }

  .bar {
    position: absolute;
    top: -0.75em;
    right: 14px;
    left: 14px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
    pointer-events: none;
  }

  .bar > span {
    padding: 0 0.5ch;
    background: var(--night);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bar b {
    color: var(--rule-strong);
    font-weight: 400;
  }

  .size {
    flex-shrink: 0;
    color: var(--dim);
  }

  /* A live terminal (LiveTerminal.astro) lies over the capture, in the same box. */
  .screen {
    position: relative;
    container-type: inline-size;
    overflow: auto hidden;
    padding: 14px 0;
    border-radius: 3px;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  /* The glass, over whatever draws the cells: faint scanlines and a darker rim. Only
     screens get it; the page around them stays flat. */
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(130% 120% at 50% 50%, transparent 62%, var(--vignette)),
      repeating-linear-gradient(to bottom, var(--scanline) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }

  /* Switched on: a bright line opens to the whole screen, then settles. */
  .poweron .screen {
    animation: power 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--power-at, 0s) both;
  }

  @keyframes power {
    0% {
      transform: scaleY(0.006);
      filter: brightness(5);
    }
    35% {
      transform: scaleY(1);
      filter: brightness(2);
    }
    100% {
      transform: none;
      filter: none;
    }
  }

  /* A row is --cell-line em high: a page that lays a live terminal over the capture gives
     the terminal's, so both grids match. */
  .grid {
    /* JetBrains Mono advances 0.6em: the grid fills the width exactly, never below 6px. */
    position: relative;
    width: calc(var(--cols) * 0.6em);
    margin: 0 12px;
    font-size: max(6px, calc((100cqw - 26px) / var(--cols) / 0.6));
  }

  pre {
    margin: 0;
    color: var(--screen-fg);
    font: 400 1em / var(--cell-line, 1.25) var(--term);
    font-variant-ligatures: none;
    white-space: pre;
    tab-size: 8;
  }

  pre :global(.row) {
    display: block;
    height: calc(var(--cell-line, 1.25) * 1em);
  }

  .region {
    position: absolute;
    left: calc(var(--col) * 0.6em);
    top: calc(var(--row) * var(--cell-line, 1.25) * 1em);
    width: calc(var(--w) * 0.6em);
    height: calc(var(--h) * var(--cell-line, 1.25) * 1em);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .region.client {
    background: var(--screen-client-soft);
    box-shadow:
      inset 0 0 0 1px var(--screen-client),
      0 0 calc(var(--glow-blur) * 3) color-mix(in srgb, var(--screen-client) 30%, transparent);
  }

  /* Outlined, not inset: the Server's edge can be dashed (the encoding's --server-line). */
  .region.server {
    background: var(--screen-server-soft);
    outline: 1px var(--server-line) var(--screen-server);
    outline-offset: -1px;
    box-shadow: 0 0 calc(var(--glow-blur) * 3) color-mix(in srgb, var(--screen-server) 30%, transparent);
  }

  .region.lit {
    opacity: 1;
  }

  .printed pre :global(.row) {
    animation: print 90ms steps(12, end) both;
    animation-delay: calc(250ms + var(--i) * 16ms);
  }

  @keyframes print {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poweron .screen,
    .printed pre :global(.row) {
      animation: none;
    }

    .region {
      transition: none;
    }
  }
</style>
