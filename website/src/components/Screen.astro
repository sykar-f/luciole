---
// A captured terminal screen, drawn as text: every cell is the character and colours the
// application sent, so it stays sharp at any size and can be selected.
import { escape, style, type Frame } from "../lib/frames";

/** The cells of the screen a piece of code drew, in rectangles of rows and columns. */
export type Rect = { row: number; col: number; rows: number; cols: number };
export type Region = { id: string; side: "client" | "server"; rects: Rect[] };

interface Props {
  frame: Frame;
  regions?: Region[];
  /** Print the rows one after the other, once, like a teletype. */
  printed?: boolean;
  /** Light the page behind the window in the two sides' colours. */
  glow?: boolean;
  /** Start tilted back and straighten as the window scrolls into view. */
  tilt?: boolean;
  class?: string;
}

const {
  frame,
  regions = [],
  printed = false,
  glow = false,
  tilt = false,
  class: className,
} = Astro.props;

// Built as a string: whitespace inside <pre> is content, and templates add some.
const html = frame.cells
  .map((runs, i) => {
    const cells = runs.map((run) => {
      const css = style(run);
      const text = escape(run[0]);
      return css ? `<span style="${css}">${text}</span>` : text;
    });
    return `<span class="row" style="--i:${i}">${cells.join("") || " "}</span>`;
  })
  .join("");
---

<div class:list={["stage", className, { glow, tilt }]}>
  <figure class:list={["term", { printed }]} style={`--cols:${frame.cols}`}>
    <div class="bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="title">{frame.title}</span>
      <span class="size">{frame.cols}×{frame.rows}</span>
    </div>
    <div
      class="screen"
      role="img"
      aria-label={`${frame.title}, a ${frame.cols} by ${frame.rows} terminal screen`}
    >
      <div class="grid">
        <pre aria-hidden="true" set:html={html} />
        {
          regions.flatMap((region) =>
            region.rects.map(({ row, col, rows, cols }) => (
              <span
                class:list={["region", region.side]}
                data-region={region.id}
                style={`--row:${row};--col:${col};--h:${rows};--w:${cols}`}
              />
            )),
          )
        }
      </div>
      <slot name="live" />
    </div>
  </figure>
</div>

<style>
  .stage {
    position: relative;
  }

  .stage.glow::before {
    content: "";
    position: absolute;
    inset: -6% -4% -10%;
    z-index: 0;
    background:
      radial-gradient(45% 55% at 15% 35%, rgb(103 217 188 / 0.35), transparent 70%),
      radial-gradient(45% 55% at 88% 70%, rgb(255 188 102 / 0.28), transparent 70%);
    filter: blur(70px);
    pointer-events: none;
  }

  .stage.tilt {
    perspective: 1800px;
  }

  .term {
    position: relative;
    z-index: 1;
    margin: 0;
    border: 1px solid transparent;
    border-radius: 14px;
    background:
      linear-gradient(180deg, #0e141d, var(--screen)) padding-box,
      linear-gradient(
          135deg,
          rgb(103 217 188 / 0.55),
          rgb(255 255 255 / 0.08) 35%,
          rgb(255 255 255 / 0.05) 65%,
          rgb(255 188 102 / 0.45)
        )
        border-box;
    overflow: hidden;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 50px 120px -50px rgb(0 0 0 / 0.95);
  }

  /* Scroll-driven where supported: the window lies back, then faces the reader. */
  @supports (animation-timeline: view()) {
    .tilt .term {
      transform-origin: 50% 100%;
      animation: straighten linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt .term {
      animation: none;
    }
  }

  @keyframes straighten {
    from {
      transform: rotateX(18deg) scale(0.94);
    }
    to {
      transform: none;
    }
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(255 255 255 / 0.02);
    color: var(--dim);
    font: 500 0.72rem / 1.4 var(--mono);
  }

  .lights {
    display: flex;
    gap: 7px;
  }

  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
  }

  .title {
    color: var(--mist);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .size {
    justify-self: end;
  }

  /* A live terminal (LiveTerminal.astro) lies over the capture, in the same box. */
  .screen {
    position: relative;
    container-type: inline-size;
    overflow: auto hidden;
    padding: 12px 0 14px;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  .grid {
    /* JetBrains Mono advances 0.6em: the grid fills the width exactly, never below 6px. */
    position: relative;
    width: calc(var(--cols) * 0.6em);
    margin: 0 12px;
    font-size: max(6px, calc((100cqw - 26px) / var(--cols) / 0.6));
  }

  pre {
    margin: 0;
    color: var(--screen-fg);
    font: 400 1em / 1.25 var(--term);
    font-variant-ligatures: none;
    white-space: pre;
    tab-size: 8;
  }

  pre :global(.row) {
    display: block;
    height: 1.25em;
  }

  .region {
    position: absolute;
    left: calc(var(--col) * 0.6em);
    top: calc(var(--row) * 1.25em);
    width: calc(var(--w) * 0.6em);
    height: calc(var(--h) * 1.25em);
    border-radius: 3px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .region.client {
    background: var(--client-soft);
    box-shadow:
      inset 0 0 0 1px var(--client),
      0 0 24px rgb(103 217 188 / 0.25);
  }

  .region.server {
    background: var(--server-soft);
    box-shadow:
      inset 0 0 0 1px var(--server),
      0 0 24px rgb(255 188 102 / 0.25);
  }

  .region.lit {
    opacity: 1;
  }

  .printed pre :global(.row) {
    animation: print 90ms steps(12, end) both;
    animation-delay: calc(250ms + var(--i) * 16ms);
  }

  @keyframes print {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
