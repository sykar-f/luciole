---
// The examples that can run in a page, live (LiveTerminal.astro, scripts/demo.ts): one at a
// time, the one the reader picked, the others back to their capture. The two that need a
// real terminal say why, with the command that runs them there.
import LiveTerminal, { type Step } from "./LiveTerminal.astro";
import { frame } from "../lib/frames";

// Forge signs in as alice and opens a diff: the capture's screen.
const toDiff: Step[] = [
  { wait: "Demo accounts", type: "alice\r", pause: 250 },
  { wait: "Demo accounts", type: "forge\r" },
  { wait: "REVIEW REQUESTED", type: "j", pause: 250 },
  { wait: "REVIEW REQUESTED", type: "\r" },
  { wait: "wants to merge feature/refund-idempotency", type: "\t", pause: 400 },
  { wait: "files 0/4 viewed", type: "]", pause: 300 },
  { wait: "src/ledger.ts · typescript", type: "]" },
  { wait: "src/refunds.ts · typescript", type: "" },
];
// Chat is asked the capture's question, and replaces it once the answer has streamed.
const ask: Step[] = [
  {
    wait: "Ask anything",
    type: "How does airtty keep typing local when the Server is 500 ms away?\r",
  },
  { wait: "Done.", type: "" },
];

const apps = [
  {
    name: "Forge",
    demo: "forge",
    frame: "forge-files",
    script: toDiff,
    run: "bun run forge",
    about:
      "Code review: pull requests, coloured diffs, line comments, live CI logs and merge. Built to push the framework past its contract.",
  },
  {
    name: "Chat",
    demo: "chat",
    frame: "chat",
    script: ask,
    run: "OPENROUTER_API_KEY=… bun run chat",
    about:
      "Answers stream token by token from a live Server Function; the key never leaves the Server. Here a scripted model answers, since no key can live in a page.",
  },
  {
    name: "mdreader",
    demo: "mdreader",
    frame: "mdreader",
    script: [],
    run: "MD_PATH=docs bun run mdreader",
    about:
      "A folder of Markdown in two panes, with tables, code and outlines: this repository's own docs. On disk, it reloads when a file changes and keeps your place.",
  },
  {
    name: "DevTools",
    demo: "devtools",
    frame: "devtools-network",
    script: [],
    run: "bun packages/airtty/src/cli.ts devtools --demo",
    about:
      "Both processes in one waterfall, with the cache that answered, component trees and logs, on a recorded session. The DevTools are an airtty app too.",
  },
];

const terminalOnly = [
  {
    name: "Files",
    run: "bun run files",
    why: "Previews images through a native library, and browses your disk.",
  },
  {
    name: "mux",
    run: "bun run mux",
    why: "A small tmux: your shell and vim on real PTYs, with another airtty app in a pane.",
  },
];
---

<section class="section" id="apps" aria-labelledby="apps-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">examples</p>
      <h2 id="apps-title">Real apps, in the repository today.</h2>
      <p class="lede">
        Each one runs below, in this page: its Client in the terminal, its Server in a Worker. Pick
        one, click it, use it. On your machine, each is a single command away.
      </p>
    </div>

    <div class="gallery" data-tabs data-gallery>
      <div class="tabs" role="tablist" aria-label="Example applications">
        {
          apps.map((app, i) => (
            <button
              type="button"
              role="tab"
              id={`app-tab-${i}`}
              aria-controls={`app-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {app.name}
            </button>
          ))
        }
      </div>
      {
        apps.map((app, i) => (
          <div
            role="tabpanel"
            id={`app-panel-${i}`}
            aria-labelledby={`app-tab-${i}`}
            class="view"
            hidden={i !== 0}
          >
            <LiveTerminal
              demo={app.demo}
              frame={frame(app.frame)}
              script={app.script}
              boot="manual"
            />
            <div class="about">
              <p>{app.about}</p>
              <code>
                <span aria-hidden="true">$ </span>
                {app.run}
              </code>
            </div>
          </div>
        ))
      }
    </div>

    <div class="elsewhere">
      <p class="elsewhere-head">Only in a real terminal</p>
      <ul>
        {
          terminalOnly.map((app) => (
            <li>
              <p class="name">{app.name}</p>
              <p class="why">{app.why}</p>
              <code>
                <span aria-hidden="true">$ </span>
                {app.run}
              </code>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // The picked panel's demo runs while the gallery is near the viewport; any other stops,
  // its capture back. A demo restarted later starts again from its first screen.
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  if (gallery) {
    let near = false;
    const panels = [...gallery.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const sync = () => {
      const shown = (panel: HTMLElement) => near && !panel.hidden;
      const signal = (panel: HTMLElement, name: string) =>
        panel.querySelector("[data-live]")?.dispatchEvent(new Event(name));
      const stopOthers = () => {
        for (const panel of panels.filter((p) => !shown(p))) signal(panel, "live:stop");
      };
      const picked = panels.find(shown)?.querySelector<HTMLElement>("[data-live]");
      for (const panel of panels.filter(shown)) signal(panel, "live:start");
      // Unloading a demo holds this thread: only once the picked one's stand-in has painted.
      if (!picked || picked.dataset.stood !== undefined) stopOthers();
      else picked.addEventListener("live:stood", stopOthers, { once: true });
    };
    new MutationObserver(sync).observe(gallery, {
      subtree: true,
      attributes: true,
      attributeFilter: ["hidden"],
    });
    new IntersectionObserver(
      (entries) => {
        near = entries.some((entry) => entry.isIntersecting);
        sync();
      },
      { rootMargin: "400px 0px" },
    ).observe(gallery);
  }
</script>

<style>
  .gallery {
    display: grid;
    gap: 36px;
  }

  /* Tabs as a terminal's: names in a row, the picked one inverted. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 2ch;
    border-bottom: 1px solid var(--rule);
  }

  button {
    padding: 8px 1ch;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--mist);
    font: 500 0.9rem / 1 var(--mono);
    cursor: pointer;
  }

  button:hover {
    color: var(--paper);
  }

  button[aria-selected="true"] {
    border-bottom-color: var(--paper);
    color: var(--paper);
  }

  .view {
    display: grid;
    gap: 22px;
  }

  .about {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 40px;
  }

  .about p {
    max-width: 70ch;
    color: var(--mist);
    font-size: 0.95rem;
  }

  code {
    color: var(--paper);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  code span {
    color: var(--dim);
  }

  .elsewhere {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }

  .elsewhere-head {
    margin-bottom: 14px;
    color: var(--mist);
    font: 400 var(--step--1) / 1.5 var(--mono);
  }

  .elsewhere ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .elsewhere li {
    display: grid;
    gap: 4px;
  }

  .name {
    color: var(--paper);
    font: 600 0.95rem / 1.5 var(--mono);
  }

  .why {
    color: var(--mist);
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .elsewhere ul {
      grid-template-columns: 1fr;
    }
  }
</style>
