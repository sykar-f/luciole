---
// Behind the hero, a dark field of terminal cells where a few fireflies wander: each one a
// single cell that lights almost at once and fades slowly, as the screens' written cells
// do (the afterglow's curve, lib/glow.ts), then steps to a neighbouring cell and flashes
// again, a few times, before going out. Not a picture: the name's light, in the medium's
// grain. Faint, and only in the open: never over the title, its lede and buttons, or under
// the screens, whose glass is opaque. A mouse passing by stirs them: the dark ones near it
// flash again, a little brighter, the nearest first, and now and then a newcomer wakes a few
// cells off its path, flashes once or twice and goes out. Only a fine pointer does, and
// only when it moves.
// Still when the reader asks for less motion; paused out of view.
---

<canvas class="field" data-field aria-hidden="true"></canvas>

<script>
  import { screenColours } from "../lib/recolor";

  /** A terminal cell of the field, in CSS pixels: the screens' grain, a little larger. */
  const CELL = { width: 12, height: 24 };
  /** The lit part of a cell: a square in its middle, as the wordmark's i has. */
  const DOT = 5;
  /** One firefly per this many square pixels of open field, and never more than MOST. */
  const AREA = 45_000;
  const MOST = 16;
  /** What they keep clear of, and by how many pixels. */
  const COVERED = ".hero .top, .hero .ping, .hero .glass";
  const MARGIN = 28;
  /** A flash: up almost at once, a short hold, then a long fade. */
  const RISE_MS = 90;
  const HOLD_MS = 70;
  const FADE_MS = 1500;
  /** The fade's curve: dimming fast, then lingering, as a firefly's afterglow does. */
  const AFTERGLOW = 2.2;
  /** The quick second pulse of a double flash: how late, and how bright against the first. */
  const TWICE_MS = 260;
  const TWICE_PEAK = 0.8;
  /** How often a flash is a double one. */
  const TWICE_ODDS = 0.3;
  /** A firefly's peak, its halo's reach in cells and brightness, and the dimmest worth drawing. */
  const PEAK = 0.7;
  const HALO = 2.2;
  const HALO_PEAK = 0.22;
  const UNSEEN = 0.01;
  /** Flashes a firefly gives before leaving: at least FEWEST, up to FEWEST + MORE - 1. */
  const FEWEST = 2;
  const MORE = 4;
  /** The dark wait before a newcomer's first flash, and between two flashes, in ms. */
  const FIRST_WAIT_MS = { from: 0, to: 2600 };
  const WAIT_MS = { from: 250, to: 1100 };
  /** Held still, how lit each firefly is drawn: somewhere mid-fade. */
  const POSED = { from: 0.15, to: 0.6 };
  /** Random cells tried for an open one before settling for a covered one. */
  const TRIES = 40;
  /** A step between flashes, drawn from these: each one a tenth of the odds. */
  const LEAP = 2;
  const STEPS = [-LEAP, -1, -1, -1, 0, 0, 1, 1, 1, LEAP];
  /** The pointer's reach in pixels: fireflies within it stir, the nearest soonest and most. */
  const STIR_REACH = 180;
  /** A stirred flash: brighter by up to this share, led off up to this late with distance. */
  const STIR_BOOST = 0.3;
  const STIR_DELAY_MS = 420;
  /** Only a firefly dark or nearly so stirs, and not again before this long. */
  const STIR_BELOW = 0.08;
  const STIR_REST_MS = 2600;
  /** A newcomer the pointer wakes: one per this many pixels it travels, no sooner than every
   *  GUEST_REST_MS, never more than GUESTS at once, this many pixels off the pointer. */
  const GUEST_TRAVEL = 360;
  const GUEST_REST_MS = 1600;
  const GUESTS = 3;
  const GUEST_OFF = { from: 36, to: 110 };
  /** Places tried around the pointer for a newcomer before giving up. */
  const GUEST_TRIES = 8;
  /** An alpha channel's largest value, and its base in a hex colour. */
  const BYTE = 255;
  const HEX = 16;

  type Range = { from: number; to: number };

  type Firefly = {
    column: number;
    row: number;
    /** When the current flash starts; before it, the firefly waits dark. */
    at: number;
    /** Flashes left, this one included. */
    left: number;
    /** A second, quick pulse right after the first, as some fireflies signal. */
    twice: boolean;
    /** How much brighter than a firefly's usual this flash is: 1 unless stirred. */
    boost: number;
    /** When the pointer last stirred it. */
    stirred: number;
    /** Woken by the pointer: it goes out for good, and no one takes its place. */
    guest: boolean;
  };

  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
  const context = canvas?.getContext("2d");
  if (canvas && context) field(canvas, context);

  function field(canvas: HTMLCanvasElement, context: CanvasRenderingContext2D) {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let colour = screenColours().afterglow;
    let columns = 0;
    let rows = 0;
    let flies: Firefly[] = [];
    /** Cells covered by the title block, the slider or a screen: never lit. */
    let covered = new Set<number>();
    const open = (column: number, row: number) => !covered.has(row * columns + column);
    let running = false;
    let frame = 0;

    const random = ({ from, to }: Range) => from + Math.random() * (to - from);
    const spawn = (now: number): Firefly => {
      let column = 0;
      let row = 0;
      for (let tries = 0; tries < TRIES; tries++) {
        column = Math.floor(Math.random() * columns);
        row = Math.floor(Math.random() * rows);
        if (open(column, row)) break;
      }
      return {
        column,
        row,
        left: FEWEST + Math.floor(Math.random() * MORE),
        stirred: -Infinity,
        guest: false,
        ...next(now, FIRST_WAIT_MS),
      };
    };
    const next = (now: number, wait: Range) => ({
      at: now + random(wait),
      twice: Math.random() < TWICE_ODDS,
      boost: 1,
    });

    const size = () => {
      const ratio = devicePixelRatio || 1;
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      columns = Math.max(1, Math.floor(width / CELL.width));
      rows = Math.max(1, Math.floor(height / CELL.height));
      const box = canvas.getBoundingClientRect();
      covered = new Set();
      for (const element of document.querySelectorAll(COVERED)) {
        const r = element.getBoundingClientRect();
        const left = Math.max(0, Math.floor((r.left - box.left - MARGIN) / CELL.width));
        const right = Math.min(columns - 1, Math.floor((r.right - box.left + MARGIN) / CELL.width));
        const top = Math.max(0, Math.floor((r.top - box.top - MARGIN) / CELL.height));
        const bottom = Math.min(rows - 1, Math.floor((r.bottom - box.top + MARGIN) / CELL.height));
        for (let y = top; y <= bottom; y++)
          for (let x = left; x <= right; x++) covered.add(y * columns + x);
      }
      const free = columns * rows - covered.size;
      const count = Math.min(MOST, Math.round((free * CELL.width * CELL.height) / AREA));
      const now = performance.now();
      flies = Array.from({ length: count }, () => spawn(now));
    };

    /** How lit a flash is, `t` ms after it started: 0 to 1. */
    const brightness = (t: number, twice: boolean) => {
      const one = (t: number) => {
        if (t < 0) return 0;
        if (t < RISE_MS) return t / RISE_MS;
        if (t < RISE_MS + HOLD_MS) return 1;
        const fading = (t - RISE_MS - HOLD_MS) / FADE_MS;
        return fading >= 1 ? 0 : (1 - fading) ** AFTERGLOW;
      };
      return twice ? Math.max(one(t), TWICE_PEAK * one(t - TWICE_MS)) : one(t);
    };
    const flashMs = (twice: boolean) => RISE_MS + HOLD_MS + FADE_MS + (twice ? TWICE_MS : 0);

    const centre = (fly: Firefly) => ({
      x: fly.column * CELL.width + CELL.width / 2,
      y: fly.row * CELL.height + CELL.height / 2,
    });
    const light = (fly: Firefly, amount: number) => {
      if (amount <= UNSEEN) return;
      const { x, y } = centre(fly);
      const reach = CELL.height * HALO;
      const halo = context.createRadialGradient(x, y, 0, x, y, reach);
      halo.addColorStop(0, `${colour}${alpha(HALO_PEAK * amount)}`);
      halo.addColorStop(1, `${colour}00`);
      context.fillStyle = halo;
      context.fillRect(x - reach, y - reach, reach * 2, reach * 2);
      context.fillStyle = `${colour}${alpha(PEAK * amount)}`;
      context.fillRect(x - DOT / 2, y - DOT / 2, DOT, DOT);
    };

    /** Where the mouse is, in the page's coordinates, while it is over the hero. */
    let pointer: { x: number; y: number } | undefined;
    let moved = false;
    /** Pixels the pointer has travelled since the last newcomer, and when that one came. */
    let travel = 0;
    let lastGuest = -Infinity;

    /** An open cell a little off (x, y), or none if the pointer is hemmed in. */
    const beside = (x: number, y: number) => {
      for (let tries = 0; tries < GUEST_TRIES; tries++) {
        const angle = Math.random() * 2 * Math.PI;
        const off = random(GUEST_OFF);
        const column = Math.floor((x + Math.cos(angle) * off) / CELL.width);
        const row = Math.floor((y + Math.sin(angle) * off) / CELL.height);
        if (column >= 0 && column < columns && row >= 0 && row < rows && open(column, row))
          return { column, row };
      }
      return undefined;
    };

    /** The pointer moved: the dark fireflies near it flash anew, and maybe a newcomer wakes. */
    const stir = (now: number) => {
      if (!pointer) return;
      const box = canvas.getBoundingClientRect();
      const x = pointer.x - box.left;
      const y = pointer.y - box.top;
      for (const fly of flies) {
        if (now - fly.stirred < STIR_REST_MS) continue;
        const at = centre(fly);
        const distance = Math.hypot(at.x - x, at.y - y);
        if (distance > STIR_REACH) continue;
        const t = now - fly.at;
        if (t >= 0 && brightness(t, fly.twice) * fly.boost > STIR_BELOW) continue;
        const near = 1 - distance / STIR_REACH;
        Object.assign(fly, {
          at: now + (1 - near) * STIR_DELAY_MS,
          twice: false,
          boost: 1 + STIR_BOOST * near * near,
          stirred: now,
          left: Math.max(fly.left, 2),
        });
      }
      const guests = flies.filter((fly) => fly.guest).length;
      if (travel < GUEST_TRAVEL || now - lastGuest < GUEST_REST_MS || guests >= GUESTS) return;
      travel = 0;
      const cell = beside(x, y);
      if (!cell) return;
      lastGuest = now;
      flies.push({
        ...cell,
        at: now + random({ from: 0, to: STIR_DELAY_MS }),
        left: 1 + Math.floor(Math.random() * 2),
        twice: false,
        boost: 1,
        stirred: now,
        guest: true,
      });
    };

    const draw = (now: number) => {
      if (moved) stir(now);
      moved = false;
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.globalCompositeOperation = "lighter";
      let gone = false;
      for (const [index, fly] of flies.entries()) {
        const t = now - fly.at;
        light(fly, brightness(t, fly.twice) * fly.boost);
        if (t < flashMs(fly.twice)) continue;
        // Its flash done: a step to a neighbouring cell and a pause, or out for good.
        fly.left -= 1;
        if (fly.left <= 0) {
          if (fly.guest) gone = true;
          else flies[index] = spawn(now);
          continue;
        }
        const column = clamp(fly.column + step(), columns);
        const row = clamp(fly.row + step(), rows);
        if (open(column, row)) Object.assign(fly, { column, row });
        Object.assign(fly, next(now, WAIT_MS));
      }
      if (gone) flies = flies.filter((fly) => !fly.guest || fly.left > 0);
      context.globalCompositeOperation = "source-over";
    };

    const tick = (now: number) => {
      if (!running) return;
      draw(now);
      frame = requestAnimationFrame(tick);
    };
    const play = (on: boolean) => {
      if (on === running) return;
      running = on;
      cancelAnimationFrame(frame);
      if (on) frame = requestAnimationFrame(tick);
    };

    // Held still: a few cells caught mid-fade, drawn once.
    const pose = () => {
      context.clearRect(0, 0, canvas.width, canvas.height);
      for (const fly of flies) light(fly, random(POSED));
    };

    size();
    // The title's box settles once its fonts are in.
    void document.fonts.ready.then(() => {
      size();
      if (still) pose();
    });
    new ResizeObserver(() => {
      size();
      if (still) pose();
    }).observe(canvas);
    document.addEventListener("palette", () => {
      colour = screenColours().afterglow;
      if (still) pose();
    });
    if (still) return pose();

    let visible = false;
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      play(visible && !document.hidden);
    }).observe(canvas);
    document.addEventListener("visibilitychange", () => play(visible && !document.hidden));

    // The mouse, not a finger: a touch would stir them only where it lands, and a tap is not
    // a passage. The pointer is only read here; the stirring waits for the next frame.
    const hero = canvas.parentElement;
    hero?.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" && event.pointerType !== "pen") return;
      if (pointer) travel += Math.hypot(event.clientX - pointer.x, event.clientY - pointer.y);
      pointer = { x: event.clientX, y: event.clientY };
      moved = running;
    });
    hero?.addEventListener("pointerleave", () => {
      pointer = undefined;
    });
  }

  /** -1, 0 or 1 cell, rarely 2: a firefly drifts, it does not jump. */
  function step() {
    return STEPS[Math.floor(Math.random() * STEPS.length)] ?? 0;
  }

  function clamp(value: number, count: number) {
    return Math.min(count - 1, Math.max(0, value));
  }

  /** `amount` (0 to 1) as the two hex digits of an `#rrggbbaa` colour. */
  function alpha(amount: number) {
    return Math.round(Math.min(1, Math.max(0, amount)) * BYTE)
      .toString(HEX)
      .padStart(2, "0");
  }
</script>

<style>
  /* The whole hero, behind everything in it; faded out toward the bottom, so the section
     below starts in the dark. */
  .field {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mask-image: linear-gradient(#000 70%, transparent);
  }
</style>
