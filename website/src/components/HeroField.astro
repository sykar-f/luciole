---
// Behind the hero, a dark field of terminal cells where a few fireflies wander: each one a
// single cell that lights almost at once and fades slowly, as the screens' written cells
// do (the afterglow's curve, lib/glow.ts), then steps to a neighbouring cell and flashes
// again, a few times, before going out. Not a picture: the name's light, in the medium's
// grain. Faint, and only in the open: never over the title, its lede and buttons, or under
// the screens, whose glass is opaque. Left alone they are few and slow. A mouse startles them
// when it surprises them: setting off from rest, or suddenly quickening; its steady gliding
// barely does, as they grow used to it. Startled, the ones near it light up, the nearest
// first and brightest, and fly off from it, wavering and curving upward as a firefly climbs
// while it flashes; a sharp start also wakes a few newcomers by it, who fly off the same way.
// Only a fine pointer does, and only when it moves.
// They are not all as near: each has a depth, from the far back to just behind the glass, and
// its nearness sets how big, bright and swift it looks, the nearest a little out of focus;
// there are more far off than near, as the space widens with distance. The pointer is on the
// glass, so it reaches the near ones first, and a startled one flies off into the depth,
// shrinking, dimming and slowing as it recedes toward the vanishing point.
// Still when the reader asks for less motion; paused out of view.
---

<canvas class="field" data-field aria-hidden="true"></canvas>

<script>
  import { screenColours } from "../lib/recolor";

  /** A terminal cell of the field, in CSS pixels: the screens' grain, a little larger. */
  const CELL = { width: 12, height: 24 };
  /** The lit part of a cell: a square in its middle, as the wordmark's i has. */
  const DOT = 5;
  /** One firefly per this many square pixels of open field, and never more than MOST. */
  const AREA = 65_000;
  const MOST = 10;
  /** What they keep clear of, and by how many pixels. */
  const COVERED = ".hero .top, .hero .ping, .hero .glass";
  const MARGIN = 28;
  /** A flash: up almost at once, a short hold, then a long fade. */
  const RISE_MS = 90;
  const HOLD_MS = 70;
  const FADE_MS = 1500;
  /** The fade's curve: dimming fast, then lingering, as a firefly's afterglow does. */
  const AFTERGLOW = 2.2;
  /** The quick second pulse of a double flash: how late, and how bright against the first. */
  const TWICE_MS = 260;
  const TWICE_PEAK = 0.8;
  /** How often a flash is a double one. */
  const TWICE_ODDS = 0.3;
  /** A firefly's peak, its halo's reach in cells and brightness, and the dimmest worth drawing. */
  const PEAK = 0.7;
  const HALO = 2.2;
  const HALO_PEAK = 0.22;
  const UNSEEN = 0.01;
  /** Flashes a firefly gives before leaving: at least FEWEST, up to FEWEST + MORE - 1. */
  const FEWEST = 2;
  const MORE = 4;
  /** The dark wait before a newcomer's first flash, and between two flashes, in ms. */
  const FIRST_WAIT_MS = { from: 0, to: 4000 };
  const WAIT_MS = { from: 900, to: 2600 };
  /** Held still, how lit each firefly is drawn: somewhere mid-fade. */
  const POSED = { from: 0.15, to: 0.6 };
  /** Random cells tried for an open one before settling for a covered one. */
  const TRIES = 40;
  /** A step between flashes, drawn from these: each one a tenth of the odds. */
  const LEAP = 2;
  const STEPS = [-LEAP, -1, -1, -1, 0, 0, 1, 1, 1, LEAP];
  /** How surprised they are: by the pointer's haste (its speed averaged over HASTE_MS) outrunning
   *  the pace it was keeping (averaged over PACE_MS), both fading when it stops; past SLACK, and
   *  by ALARM_SPEED more at the most, in px per ms. The surprise fades over ALARM_FADE_MS. Two
   *  moves are weighed as at least MIN_GAP_MS and at most MAX_GAP_MS apart. */
  const HASTE_MS = 40;
  const PACE_MS = 450;
  const SLACK = 0.08;
  const ALARM_SPEED = 0.5;
  const ALARM_FADE_MS = 400;
  const MIN_GAP_MS = 8;
  const MAX_GAP_MS = 50;
  /** Below this, the surprise is spent: only a moving pointer still startles the ones it brushes. */
  const CALMED = 0.02;
  /** Whom the pointer startles, in pixels: only the ones it brushes when it is no surprise,
   *  out to STIR_REACH when it is the most; the nearest soonest and most. */
  const CALM_REACH = 60;
  const STIR_REACH = 220;
  /** A startled flash: brighter by up to this share (BOOST_CALM of it when it is no surprise),
   *  led off up to this late with distance. */
  const STIR_BOOST = 0.45;
  const BOOST_CALM = 0.4;
  const STIR_DELAY_MS = 240;
  /** A startled firefly is left alone this long before it can be startled again. */
  const STIR_REST_MS = 2200;
  /** Its flight, a hop at a time: from HOPS.from hops when barely surprised to HOPS.to at the
   *  most, each about STRIDE pixels, the first after FIRST_HOP_MS and each next one slower by
   *  SLOWING. Its heading wavers (a turn that keeps TURN_KEEP of itself and gains up to WOBBLE
   *  radians a hop) and bends upward by CLIMB of the way each hop. A hop crossfades the two
   *  cells over HOP_MS, so it glides without leaving the grain. */
  const HOPS = { from: 4, to: 12 };
  /** How much of its due a flight gets, and how uneven the wait between two hops is. */
  const HOPS_SHARE = { from: 0.7, to: 1 };
  const HOP_JITTER = { from: 0.8, to: 1.25 };
  const STRIDE = { from: 9, to: 19 };
  const FIRST_HOP_MS = 80;
  const SLOWING = 1.14;
  const TURN_KEEP = 0.7;
  const WOBBLE = 0.45;
  const CLIMB = 0.12;
  const UP = -Math.PI / 2;
  const HOP_MS = 90;
  /** A surprise past BURST wakes newcomers by the pointer, as many as it is strong, never more
   *  than GUESTS out at once, and not again before BURST_REST_MS; this many pixels off it. */
  const BURST = 0.45;
  const BURST_REST_MS = 1500;
  const GUESTS = 3;
  const GUEST_OFF = { from: 36, to: 110 };
  /** Places tried around the pointer for a newcomer before giving up. */
  const GUEST_TRIES = 8;
  /** Depth, from 0 (the far back) to 1 (just behind the glass), and how large it makes a firefly
   *  look, from FAR to NEAR: its dot, its halo, its steps. Its light dims with distance, as its
   *  size to the power DIMMING. Depths are drawn skewed toward the back by FAR_SKEW, as more of
   *  the space lies there. */
  const FAR = 0.45;
  const NEAR = 1.15;
  const DIMMING = 1.3;
  const FAR_SKEW = 1.6;
  /** The depth in focus; nearer, a firefly blurs, up to the nearest: its dot wider by BOKEH_DOT
   *  and fainter by BOKEH_FADE, its halo wider by BOKEH_REACH, with a flat core over
   *  BOKEH_CORE of it. */
  const FOCUS = 0.6;
  const BOKEH_DOT = 0.2;
  const BOKEH_FADE = 0.35;
  const BOKEH_REACH = 0.1;
  const BOKEH_CORE = 0.3;
  /** How far back the far end lies, in pixels, as the pointer on the glass feels it. */
  const DEPTH_PX = 240;
  /** Between two flashes a firefly drifts in depth by up to this much; fleeing, it recedes by
   *  this much a hop. Receding pulls it toward the vanishing point, softened by PERSPECTIVE. */
  const DEPTH_DRIFT = 0.06;
  const RECEDE = { from: 0.01, to: 0.045 };
  const PERSPECTIVE = 0.3;
  /** Newcomers wake this near: close to the glass, where the pointer startles them. */
  const GUEST_DEPTH = { from: 0.6, to: 0.95 };
  /** An alpha channel's largest value, and its base in a hex colour. */
  const BYTE = 255;
  const HEX = 16;

  type Range = { from: number; to: number };

  type Firefly = {
    /** Where it is, in pixels, and the cell that is lit for it there. */
    x: number;
    y: number;
    column: number;
    row: number;
    /** How near, from 0 (the far back) to 1 (just behind the glass). */
    z: number;
    /** When the current flash starts; before it, the firefly waits dark. */
    at: number;
    /** Flashes left, this one included. */
    left: number;
    /** A second, quick pulse right after the first, as some fireflies signal. */
    twice: boolean;
    /** How much brighter than a firefly's usual this flash is: 1 unless stirred. */
    boost: number;
    /** When the pointer last stirred it. */
    stirred: number;
    /** Woken by the pointer: it goes out for good, and no one takes its place. */
    guest: boolean;
    /** Fleeing the pointer: which way it goes, its hops to come. */
    flight?: {
      heading: number;
      turn: number;
      hops: number;
      at: number;
      gap: number;
    };
    /** The cell it just left, and when: drawn fading as the new one lights. */
    trail?: { column: number; row: number; at: number };
  };

  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
  const context = canvas?.getContext("2d");
  if (canvas && context) field(canvas, context);

  function field(canvas: HTMLCanvasElement, context: CanvasRenderingContext2D) {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let colour = screenColours().afterglow;
    let columns = 0;
    let rows = 0;
    /** The vanishing point: the field's middle. */
    let middle = { x: 0, y: 0 };
    let flies: Firefly[] = [];
    /** Cells covered by the title block, the slider or a screen: never lit. */
    let covered = new Set<number>();
    const open = (column: number, row: number) => !covered.has(row * columns + column);
    let running = false;
    let frame = 0;

    const random = ({ from, to }: Range) => from + Math.random() * (to - from);
    const spawn = (now: number): Firefly => {
      let column = 0;
      let row = 0;
      for (let tries = 0; tries < TRIES; tries++) {
        column = Math.floor(Math.random() * columns);
        row = Math.floor(Math.random() * rows);
        if (open(column, row)) break;
      }
      return {
        ...centre({ column, row }),
        column,
        row,
        z: Math.random() ** FAR_SKEW,
        left: FEWEST + Math.floor(Math.random() * MORE),
        stirred: -Infinity,
        guest: false,
        ...next(now, FIRST_WAIT_MS),
      };
    };
    const next = (now: number, wait: Range) => ({
      at: now + random(wait),
      twice: Math.random() < TWICE_ODDS,
      boost: 1,
    });

    const size = () => {
      const ratio = devicePixelRatio || 1;
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      middle = { x: width / 2, y: height / 2 };
      columns = Math.max(1, Math.floor(width / CELL.width));
      rows = Math.max(1, Math.floor(height / CELL.height));
      const box = canvas.getBoundingClientRect();
      covered = new Set();
      for (const element of document.querySelectorAll(COVERED)) {
        const r = element.getBoundingClientRect();
        const left = Math.max(0, Math.floor((r.left - box.left - MARGIN) / CELL.width));
        const right = Math.min(columns - 1, Math.floor((r.right - box.left + MARGIN) / CELL.width));
        const top = Math.max(0, Math.floor((r.top - box.top - MARGIN) / CELL.height));
        const bottom = Math.min(rows - 1, Math.floor((r.bottom - box.top + MARGIN) / CELL.height));
        for (let y = top; y <= bottom; y++)
          for (let x = left; x <= right; x++) covered.add(y * columns + x);
      }
      const free = columns * rows - covered.size;
      const count = Math.min(MOST, Math.round((free * CELL.width * CELL.height) / AREA));
      const now = performance.now();
      flies = Array.from({ length: count }, () => spawn(now));
    };

    /** How lit a flash is, `t` ms after it started: 0 to 1. */
    const brightness = (t: number, twice: boolean) => {
      const one = (t: number) => {
        if (t < 0) return 0;
        if (t < RISE_MS) return t / RISE_MS;
        if (t < RISE_MS + HOLD_MS) return 1;
        const fading = (t - RISE_MS - HOLD_MS) / FADE_MS;
        return fading >= 1 ? 0 : (1 - fading) ** AFTERGLOW;
      };
      return twice ? Math.max(one(t), TWICE_PEAK * one(t - TWICE_MS)) : one(t);
    };
    const flashMs = (twice: boolean) => RISE_MS + HOLD_MS + FADE_MS + (twice ? TWICE_MS : 0);

    const centre = ({ column, row }: { column: number; row: number }) => ({
      x: column * CELL.width + CELL.width / 2,
      y: row * CELL.height + CELL.height / 2,
    });
    /** How large a firefly `z` deep looks, against one in the screens' plane. */
    const scale = (z: number) => FAR + (NEAR - FAR) * z;
    /** A cell lit by `amount` of a flash, for a firefly `z` deep. */
    const light = (cell: { column: number; row: number }, amount: number, z: number) => {
      const size = scale(z);
      const glow = amount * size ** DIMMING;
      if (glow <= UNSEEN) return;
      const { x, y } = centre(cell);
      const blur = Math.max(0, (z - FOCUS) / (1 - FOCUS));
      const reach = CELL.height * HALO * size * (1 + BOKEH_REACH * blur);
      const halo = context.createRadialGradient(x, y, 0, x, y, reach);
      halo.addColorStop(0, `${colour}${alpha(HALO_PEAK * glow)}`);
      if (blur > 0) halo.addColorStop(BOKEH_CORE * blur, `${colour}${alpha(HALO_PEAK * glow)}`);
      halo.addColorStop(1, `${colour}00`);
      context.fillStyle = halo;
      context.fillRect(x - reach, y - reach, reach * 2, reach * 2);
      const dot = DOT * size * (1 + BOKEH_DOT * blur);
      context.fillStyle = `${colour}${alpha(PEAK * glow * (1 - BOKEH_FADE * blur))}`;
      context.fillRect(x - dot / 2, y - dot / 2, dot, dot);
    };

    /** Moves a firefly to (x, y) if the cell there is open, crossfading from its old cell when
     *  `now` is given; tells whether it moved. */
    const place = (fly: Firefly, x: number, y: number, now?: number) => {
      const column = Math.floor(x / CELL.width);
      const row = Math.floor(y / CELL.height);
      if (column < 0 || column >= columns || row < 0 || row >= rows || !open(column, row)) return false;
      if (now !== undefined && (column !== fly.column || row !== fly.row))
        fly.trail = { column: fly.column, row: fly.row, at: now };
      Object.assign(fly, { x, y, column, row });
      return true;
    };

    /** Where the mouse is, in the page's coordinates, and when it was there, while it is over
     *  the hero; the speed it has been keeping; how surprised the field is, as of when. */
    let pointer: { x: number; y: number; at: number } | undefined;
    let haste = 0;
    let pace = 0;
    let alarm = { amount: 0, at: 0 };
    let lastBurst = -Infinity;
    const alarmed = (now: number) => alarm.amount * Math.exp(-(now - alarm.at) / ALARM_FADE_MS);

    /** An open cell a little off (x, y), or none if the pointer is hemmed in. */
    const beside = (x: number, y: number) => {
      for (let tries = 0; tries < GUEST_TRIES; tries++) {
        const angle = Math.random() * 2 * Math.PI;
        const off = random(GUEST_OFF);
        const column = Math.floor((x + Math.cos(angle) * off) / CELL.width);
        const row = Math.floor((y + Math.sin(angle) * off) / CELL.height);
        if (column >= 0 && column < columns && row >= 0 && row < rows && open(column, row))
          return { column, row };
      }
      return undefined;
    };

    /** Startles a firefly `near` the pointer (0 at the reach, 1 on it) at (x, y), as `surprised`
     *  as the field is (0 to 1): it lights up, from however lit it already is, and flies off. */
    const startle = (fly: Firefly, now: number, x: number, y: number, near: number, surprised: number) => {
      const boost = 1 + STIR_BOOST * near * (BOOST_CALM + (1 - BOOST_CALM) * surprised);
      const lit = Math.min(1, (brightness(now - fly.at, fly.twice) * fly.boost) / boost);
      // A lit one brightens from where it is; a dark one waits a moment, the farther the longer.
      const at = lit > UNSEEN ? now - lit * RISE_MS : now + (1 - near) * STIR_DELAY_MS;
      const heading =
        fly.x === x && fly.y === y ? Math.random() * 2 * Math.PI : Math.atan2(fly.y - y, fly.x - x);
      const hops = Math.round(HOPS.from + (HOPS.to - HOPS.from) * surprised * random(HOPS_SHARE));
      Object.assign(fly, {
        at,
        twice: false,
        boost,
        stirred: now,
        left: Math.max(fly.left, 2),
        flight: { heading, turn: 0, hops, at: Math.max(now, at), gap: FIRST_HOP_MS },
      });
    };

    /** A hop of a flying firefly, if one is due: along its wavering, climbing heading and back
     *  into the depth, its stride and its place shrinking toward the vanishing point as it
     *  recedes; a covered cell ends the flight. */
    const flee = (fly: Firefly, now: number) => {
      const flight = fly.flight;
      if (!flight || now < flight.at) return;
      flight.turn = flight.turn * TURN_KEEP + random({ from: -WOBBLE, to: WOBBLE });
      flight.heading += flight.turn + CLIMB * towards(flight.heading, UP);
      const z = Math.max(0, fly.z - random(RECEDE));
      const size = scale(z);
      const pull = (size / scale(fly.z)) ** PERSPECTIVE;
      const stride = random(STRIDE) * size;
      const x = middle.x + (fly.x - middle.x) * pull + Math.cos(flight.heading) * stride;
      const y = middle.y + (fly.y - middle.y) * pull + Math.sin(flight.heading) * stride;
      flight.hops -= 1;
      flight.at = now + flight.gap * random(HOP_JITTER);
      flight.gap *= SLOWING;
      if (place(fly, x, y, now)) fly.z = z;
      else flight.hops = 0;
      if (flight.hops <= 0) fly.flight = undefined;
    };

    /** While the pointer moves or the field is surprised: the fireflies near the pointer
     *  startle, the farther the more surprised, and a sharp surprise wakes newcomers by it. */
    const stir = (now: number) => {
      const surprised = alarmed(now);
      if (!pointer || (surprised < CALMED && now - pointer.at > MAX_GAP_MS)) return;
      const box = canvas.getBoundingClientRect();
      const x = pointer.x - box.left;
      const y = pointer.y - box.top;
      const reach = CALM_REACH + (STIR_REACH - CALM_REACH) * surprised;
      for (const fly of flies) {
        if (fly.flight || now - fly.stirred < STIR_REST_MS) continue;
        // The pointer is on the glass: a far one is far from it, however close it looks.
        const distance = Math.hypot(fly.x - x, fly.y - y, (1 - fly.z) * DEPTH_PX);
        if (distance <= reach) startle(fly, now, x, y, 1 - distance / reach, surprised);
      }
      if (surprised < BURST || now - lastBurst < BURST_REST_MS) return;
      lastBurst = now;
      const out = flies.filter((fly) => fly.guest).length;
      const count = Math.min(GUESTS - out, Math.round(GUESTS * surprised));
      for (let index = 0; index < count; index++) {
        const cell = beside(x, y);
        if (!cell) continue;
        const z = random(GUEST_DEPTH);
        const guest: Firefly = {
          ...cell,
          ...centre(cell),
          z,
          at: now,
          left: 1,
          twice: false,
          boost: 1,
          stirred: now,
          guest: true,
        };
        const distance = Math.hypot(guest.x - x, guest.y - y, (1 - z) * DEPTH_PX);
        startle(guest, now, x, y, Math.max(0, 1 - distance / reach), surprised);
        guest.left = 1 + Math.floor(Math.random() * 2);
        flies.push(guest);
      }
    };

    const draw = (now: number) => {
      stir(now);
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.globalCompositeOperation = "lighter";
      let gone = false;
      for (const [index, fly] of flies.entries()) {
        const t = now - fly.at;
        const amount = brightness(t, fly.twice) * fly.boost;
        flee(fly, now);
        const crossing = fly.trail ? (now - fly.trail.at) / HOP_MS : 1;
        if (fly.trail && crossing < 1) light(fly.trail, amount * (1 - crossing), fly.z);
        light(fly, amount * Math.min(1, crossing), fly.z);
        if (t < flashMs(fly.twice)) continue;
        // Its flash done: a step, the shorter the farther, a drift in depth, and a pause; or out
        // for good.
        fly.flight = undefined;
        fly.trail = undefined;
        fly.left -= 1;
        if (fly.left <= 0) {
          if (fly.guest) gone = true;
          else flies[index] = spawn(now);
          continue;
        }
        const size = scale(fly.z);
        place(fly, fly.x + step() * CELL.width * size, fly.y + step() * CELL.height * size);
        fly.z = Math.min(1, Math.max(0, fly.z + random({ from: -DEPTH_DRIFT, to: DEPTH_DRIFT })));
        Object.assign(fly, next(now, WAIT_MS));
      }
      if (gone) flies = flies.filter((fly) => !fly.guest || fly.left > 0);
      context.globalCompositeOperation = "source-over";
    };

    const tick = (now: number) => {
      if (!running) return;
      draw(now);
      frame = requestAnimationFrame(tick);
    };
    const play = (on: boolean) => {
      if (on === running) return;
      running = on;
      cancelAnimationFrame(frame);
      if (on) frame = requestAnimationFrame(tick);
    };

    // Held still: a few cells caught mid-fade, drawn once.
    const pose = () => {
      context.clearRect(0, 0, canvas.width, canvas.height);
      for (const fly of flies) light(fly, random(POSED), fly.z);
    };

    size();
    // The title's box settles once its fonts are in.
    void document.fonts.ready.then(() => {
      size();
      if (still) pose();
    });
    new ResizeObserver(() => {
      size();
      if (still) pose();
    }).observe(canvas);
    document.addEventListener("palette", () => {
      colour = screenColours().afterglow;
      if (still) pose();
    });
    if (still) return pose();

    let visible = false;
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      play(visible && !document.hidden);
    }).observe(canvas);
    document.addEventListener("visibilitychange", () => play(visible && !document.hidden));

    // The mouse, not a finger: a touch would stir them only where it lands, and a tap is not
    // a passage. Here the pointer is only measured; the stirring waits for the next frame.
    const hero = canvas.parentElement;
    hero?.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" && event.pointerType !== "pen") return;
      const now = event.timeStamp;
      const last = pointer;
      pointer = { x: event.clientX, y: event.clientY, at: now };
      if (!last || !running) return;
      const gap = now - last.at;
      const weighed = Math.min(MAX_GAP_MS, Math.max(MIN_GAP_MS, gap));
      const speed = Math.hypot(pointer.x - last.x, pointer.y - last.y) / weighed;
      // Each average, faded by however long the pointer paused (after a rest, nothing kept),
      // then drawn toward this move's speed.
      const average = (value: number, ms: number) => {
        const kept = value * Math.exp(-gap / ms);
        return kept + (speed - kept) * (1 - Math.exp(-weighed / ms));
      };
      haste = average(haste, HASTE_MS);
      pace = average(pace, PACE_MS);
      const surprise = Math.min(1, Math.max(0, (haste - pace - SLACK) / ALARM_SPEED));
      if (surprise > alarmed(now)) alarm = { amount: surprise, at: now };
    });
    hero?.addEventListener("pointerleave", () => {
      pointer = undefined;
      haste = 0;
      pace = 0;
    });
  }

  /** -1, 0 or 1 cell, rarely 2: a firefly drifts, it does not jump. */
  function step() {
    return STEPS[Math.floor(Math.random() * STEPS.length)] ?? 0;
  }

  /** The turn, in radians between -π and π, from `heading` to `goal`. */
  function towards(heading: number, goal: number) {
    return Math.atan2(Math.sin(goal - heading), Math.cos(goal - heading));
  }

  /** `amount` (0 to 1) as the two hex digits of an `#rrggbbaa` colour. */
  function alpha(amount: number) {
    return Math.round(Math.min(1, Math.max(0, amount)) * BYTE)
      .toString(HEX)
      .padStart(2, "0");
  }
</script>

