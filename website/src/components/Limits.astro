---
import { doc, repo } from "../lib/links";

const limits = [
  {
    what: "Nothing is published yet.",
    why: "No package on a registry. A new app depends on a checkout of this repository, and the name may still change.",
  },
  {
    what: "No Fast Refresh.",
    why: "A rebuild restarts both processes. The route, history and named fields come back; state held only in memory does not.",
  },
  {
    what: "No silent retries.",
    why: "Live streams do not reconnect by themselves and an operation with an unknown outcome is never replayed. Only your app knows whether doing it twice is safe.",
  },
  {
    what: "One user per Server, by default.",
    why: "The built-in session is a single token. Multi-user sign-in is yours to write in server/auth.ts.",
  },
  {
    what: "Measured, not assumed.",
    why: "The remote path is tested macOS to Linux over SSH. There is no WAN measurement campaign yet, and macOS notarization has never run without a Developer ID.",
  },
  {
    what: "Pinned on purpose.",
    why: "React Flight 19.3.0 and OpenTUI 0.5.12 are pinned exactly. The Flight adapter is isolated and retested on every upgrade.",
  },
];
---

<section class="section" id="limits" aria-labelledby="limits-title">
  <div class="wrap grid">
    <div class="head">
      <p class="label">limits</p>
      <h2 id="limits-title">What it doesn't do, written down.</h2>
      <p class="lede">
        airtty is an experiment run in the open. Every limit below comes from its README, next to the
        test that proves the rest.
      </p>
      <a class="more" href={doc("VALIDATION.md")}>Evidence and limits</a>
      <a class="more" href={`${repo}#contrat-et-limites`}>The contract in the README</a>
    </div>
    <ul class="limits">
      {
        limits.map((limit) => (
          <li>
            <p class="what">{limit.what}</p>
            <p class="why">{limit.why}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
  }

  .head {
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .more {
    justify-self: start;
    color: var(--mist);
    font: 400 0.88rem / 1.5 var(--mono);
  }

  .limits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 18px 0 22px;
    border-top: 1px solid var(--rule);
  }

  /* Short and dense: the page tightens here. */
  .section {
    padding-block: clamp(56px, 7vw, 96px);
  }

  .what {
    margin-bottom: 8px;
    color: var(--paper);
    font: 600 0.95rem / 1.5 var(--mono);
  }

  .what::before {
    content: "✕ " / "";
    color: var(--dim);
  }

  .why {
    color: var(--mist);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .grid,
    .limits {
      grid-template-columns: 1fr;
    }
  }
</style>
