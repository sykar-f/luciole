---
import { doc } from "../lib/links";

const tools = [
  {
    name: "Routes are files",
    body: "layout, page, loading, error and not-found; [param], [...catchAll] and (group). TanStack Router drives navigation, typed from a generated route tree.",
    link: doc("ROUTER.md"),
  },
  {
    name: '"use cache"',
    body: "Cache a Server read with tags and lifetimes. invalidate() from an action, and the Client refreshes only the routes that read it.",
    link: doc("CACHE.md"),
  },
  {
    name: "Live screens",
    body: "useLive subscribes a screen to a generator Server Function: logs, CI, streamed tokens. It closes when the screen unmounts.",
    link: doc("API.md"),
  },
  {
    name: "Fields that survive",
    body: "Like a browser, the Client keeps history and the text of named fields. A crash, a closed terminal or a rebuild gives them back; quitting forgets them.",
    link: doc("API.md"),
  },
  {
    name: "<Terminal> and <Embed>",
    body: "Run shells and vim on a PTY inside your app, or load another airtty app into a pane with its own keys and focus.",
    link: doc("EMBEDDING.md"),
  },
  {
    name: "Protected by default",
    body: "With server/auth.ts, every page and action requires a session. A public one says so with export const auth = \"public\".",
    link: doc("API.md"),
  },
  {
    name: "Boundaries checked at build",
    body: "server-only and client-only keep a module on its side. A violation fails the build and prints the import chain that caused it.",
    link: doc("BOUNDARIES.md"),
  },
  {
    name: "A bad network on demand",
    body: "AIRTTY_LATENCY_MS, AIRTTY_JITTER_MS and AIRTTY_FAULT delay, cut and lose requests so you see your error handling before your users do.",
    link: "#wire",
  },
];
---

<section class="section" id="toolbox" aria-labelledby="toolbox-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">toolbox</p>
      <h2 id="toolbox-title">What you expect from a web framework, in a terminal.</h2>
    </div>
    <dl class="tools" data-spotlight>
      {
        tools.map((tool) => (
          <div class="tool">
            <dt>
              <a href={tool.link}>{tool.name}</a>
            </dt>
            <dd>{tool.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // Each card lights up under the pointer, and a little around it.
  const grid = document.querySelector<HTMLElement>("[data-spotlight]");
  grid?.addEventListener("pointermove", (event) => {
    for (const card of grid.querySelectorAll<HTMLElement>(".tool")) {
      const box = card.getBoundingClientRect();
      card.style.setProperty("--x", `${event.clientX - box.left}px`);
      card.style.setProperty("--y", `${event.clientY - box.top}px`);
    }
  });
</script>

<style>
  .tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }

  /* The first two carry the most weight: the same conventions as the web, and the cache. */
  .tool:nth-child(1),
  .tool:nth-child(2),
  .tool:last-child {
    grid-column: span 2;
  }

  .tool {
    --x: -200px;
    --y: -200px;
    position: relative;
    padding: 24px 24px 28px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background:
      radial-gradient(320px circle at var(--x) var(--y), rgb(103 217 188 / 0.09), transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .tool::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(240px circle at var(--x) var(--y), rgb(103 217 188 / 0.6), transparent 60%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  dt {
    margin-bottom: 10px;
  }

  dt a {
    color: var(--paper);
    font: 600 0.95rem / 1.3 var(--mono);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  dt a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .tool:hover dt a {
    color: var(--client);
  }

  dd {
    margin: 0;
    color: var(--mist);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .tool:nth-child(-n + 2) dd {
    max-width: 52ch;
    font-size: 0.85rem;
  }

  @media (max-width: 1000px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .tools {
      grid-template-columns: 1fr;
    }

    .tool:nth-child(1),
    .tool:nth-child(2),
    .tool:last-child {
      grid-column: auto;
    }
  }
</style>
