---
import { doc } from "../lib/links";

const ways = [
  {
    command: "airtty ./my-app",
    where: "here",
    what: "Builds the folder and opens it. Client and Server talk over a private Unix socket: no port to pick, nothing else can connect.",
  },
  {
    command: "airtty build --compile",
    where: "here",
    what: "One executable per OS and architecture, Bun runtime and OpenTUI inside. The machine that runs it needs neither Bun nor node_modules. Signed and notarized for macOS on request.",
  },
  {
    command: "notes --on build-box",
    where: "build-box",
    what: "Installs the Server on the host over SSH if it is missing, detaches it, and tunnels back. A dropped connection comes back on its own; the Server waits for you.",
    replay: true,
  },
  {
    command: "notes --url ssh://alice@notes.example.com",
    where: "notes.example.com",
    what: "Joins a Server that already runs elsewhere. OpenSSH handles the login: your keys, your agent, your ProxyJump.",
  },
  {
    command: "airtty github:ada/tools#v1/apps/notes",
    where: "here",
    what: "Fetches a git source, asks you to trust it once, installs and builds it, then launches from cache.",
  },
  {
    command: "airtty https://notes.example.com",
    where: "notes.example.com",
    what: "Opens an app by URL in the generic Client, in tabs: a signed bundle, the publisher's key pinned on first use, sandboxed by default.",
  },
];

// What a dropped connection looks like from the terminal (docs/DISTRIBUTION.md): pings
// fail, the Client says Disconnected, the tunnel is relaunched after 1 s, 2 s, 4 s… until
// it holds, and the same Server answers again. Played once when it comes into view.
const dropped = [
  { text: "── the network drops ──", tone: "dim" },
  { text: "TERMINAL / NOTES · Disconnected", tone: "fault" },
  { text: "ssh tunnel relaunched after 1 s, 2 s, 4 s…", tone: "", wait: 2400 },
  { text: "TERMINAL / NOTES · Connected", tone: "client", note: "same Server, route and named fields kept" },
];
---

<section class="section" id="ship" aria-labelledby="ship-title">
  <div class="wrap grid">
    <div class="section-head">
      <p class="label">distribution</p>
      <h2 id="ship-title">One build. Every way to open it.</h2>
      <p class="lede">
        A terminal app should start like any command: on your laptop, on a machine you reach over SSH,
        or from a URL. Both halves always come from the same build.
      </p>
      <p class="more">
        Server lifetime, reconnection and the registry: <a href={doc("DISTRIBUTION.md")}
          >DISTRIBUTION.md</a
        >
      </p>
    </div>

    <div class="shell">
      <p class="chrome" aria-hidden="true"><span><b>┤</b> ~/my-app <b>├</b></span></p>
      <ul class="ways">
        {
          ways.map((way) => (
            <li>
              <p class="line">
                <code>
                  <span class="prompt" aria-hidden="true">$ </span>
                  {way.command}
                </code>
                <span class:list={["where", { remote: way.where !== "here" }]}>
                  <span class="visually-hidden">Server runs on </span>
                  <span aria-hidden="true"># </span>
                  {way.where === "here" ? "server: here" : `server: ${way.where}`}
                </span>
              </p>
              <p class="what">{way.what}</p>
              {way.replay && (
                <figure class="replay" data-replay>
                  <figcaption>simulated</figcaption>
                  <ol>
                    {dropped.map((line) => (
                      <li class={line.tone} data-wait={line.wait}>
                        <span class="spin" aria-hidden="true" />
                        {line.text}
                        {line.note && <span class="note"> # {line.note}</span>}
                      </li>
                    ))}
                  </ol>
                  <button type="button" data-replay-again hidden>
                    replay
                  </button>
                </figure>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // The dropped connection plays line by line the first time it is in view; its last
  // state is what the page shows without scripts or with reduced motion.
  const BRAILLE = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏";
  const LINE_MS = 700;
  const SPIN_MS = 80;
  const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));
  const replay = document.querySelector<HTMLElement>("[data-replay]");
  const again = replay?.querySelector<HTMLButtonElement>("[data-replay-again]");
  if (replay && again && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const lines = [...replay.querySelectorAll<HTMLElement>("li")];
    let playing = false;
    const play = async () => {
      if (playing) return;
      playing = true;
      again.hidden = true;
      for (const line of lines) line.classList.add("off");
      for (const line of lines) {
        await sleep(LINE_MS);
        line.classList.remove("off");
        const wait = Number(line.dataset.wait ?? 0);
        const spin = line.querySelector<HTMLElement>(".spin");
        if (!wait || !spin) continue;
        line.classList.add("waiting");
        for (let t = 0; t < wait; t += SPIN_MS) {
          spin.textContent = BRAILLE[Math.floor(t / SPIN_MS) % BRAILLE.length] ?? "";
          await sleep(SPIN_MS);
        }
        spin.textContent = "";
        line.classList.remove("waiting");
      }
      playing = false;
      again.hidden = false;
    };
    again.addEventListener("click", () => void play());
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        seen.disconnect();
        void play();
      },
      { threshold: 0.8 },
    );
    seen.observe(replay);
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: start;
  }

  .section-head {
    position: sticky;
    top: 100px;
    margin: 0;
  }

  .more {
    color: var(--mist);
    font-size: 0.88rem;
  }

  .shell {
    position: relative;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--panel);
  }

  .chrome {
    position: absolute;
    top: -0.75em;
    left: 14px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .chrome span {
    padding: 0 0.5ch;
    background: var(--night);
  }

  .chrome b {
    color: var(--rule-strong);
    font-weight: 400;
  }

  .ways {
    margin: 0;
    padding: 14px 0 8px;
    list-style: none;
  }

  li {
    padding: 14px 22px;
  }

  li + li {
    border-top: 1px dashed var(--rule);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }

  .line code {
    padding: 0;
    background: none;
    color: var(--paper);
    font: 500 0.88rem / 1.5 var(--mono);
    overflow-wrap: anywhere;
  }

  .prompt {
    color: var(--dim);
  }

  /* Where the Server runs: beside the Client, or away on a host. */
  .where {
    color: var(--client);
    font: 400 0.78rem / 1.5 var(--mono);
    white-space: nowrap;
  }

  .where.remote {
    color: var(--server);
  }

  .what {
    margin-top: 6px;
    color: var(--mist);
    font-size: 0.9rem;
  }

  .replay {
    position: relative;
    margin: 12px 0 2px;
    padding: 10px 14px;
    border-left: 1px solid var(--rule-strong);
    font: 400 0.8rem / 1.7 var(--mono);
  }

  .replay figcaption {
    position: absolute;
    top: 10px;
    right: 0;
    color: var(--dim);
    font-size: 0.72rem;
  }

  .replay ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .replay li {
    padding: 0;
    border: 0;
    color: var(--mist);
  }

  /* Hidden while it plays, without moving what comes after. */
  .replay li.off {
    visibility: hidden;
  }

  .replay .dim {
    color: var(--dim);
  }

  .replay .fault {
    color: var(--fault);
  }

  .replay .client {
    color: var(--client);
  }

  .replay .note {
    color: var(--dim);
  }

  .spin:not(:empty) {
    margin-right: 1ch;
    color: var(--paper);
  }

  .replay button {
    margin-top: 6px;
    padding: 2px 8px;
    border: 1px solid var(--rule-strong);
    background: none;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
    cursor: pointer;
  }

  .replay button::before {
    content: "↻ " / "";
  }

  .replay button:hover {
    border-color: var(--mist);
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      position: static;
    }
  }
</style>
