---
// Three kinds of aside, always titled the same way so the reader learns to spot them.
interface Props {
  kind: "retenir" | "piege" | "essaie";
  title?: string;
}

const { kind, title } = Astro.props;
const heading = { retenir: "À retenir", piege: "Piège", essaie: "Essaie" }[kind];
---

<aside class={`callout ${kind}`}>
  <p class="title">{heading}{title && <span> · {title}</span>}</p>
  <div class="content"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.8em 0 !important;
    padding: 14px 18px 16px;
    border: 1px solid;
    border-radius: 4px;
    font-size: 0.94rem;
  }

  .title {
    margin-bottom: 6px;
    font: 600 0.75rem / 1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .title span {
    color: var(--paper);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .content > :global(* + *) {
    margin-top: 0.6em;
  }

  .content :global(ul) {
    margin: 0;
  }

  .retenir {
    border-color: var(--rule-strong);
    background: var(--night-raised);
  }

  .retenir .title {
    color: var(--paper);
  }

  .piege {
    border-color: color-mix(in srgb, var(--fault) 30%, transparent);
    background: color-mix(in srgb, var(--fault) 5%, transparent);
  }

  .piege .title {
    color: var(--fault);
  }

  .essaie {
    border-color: color-mix(in srgb, var(--wire) 30%, transparent);
    background: color-mix(in srgb, var(--wire) 5%, transparent);
  }

  .essaie .title {
    color: var(--wire);
  }
</style>
