---
// Retrieval, not rereading: answer first, then open.
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<section class="quiz">
  <h2>Vérifie-toi</h2>
  <p class="how">Réponds de tête, à voix haute ou par écrit, avant d'ouvrir la réponse. Une réponse qui ne vient pas indique la section à relire.</p>
  {
    items.map((item, i) => (
      <details>
        <summary>
          <span class="n">{i + 1}</span>
          <span set:html={item.q} />
        </summary>
        <div class="answer" set:html={item.a} />
      </details>
    ))
  }
</section>

<style>
  .how {
    color: var(--mist);
    font-size: 0.92rem;
  }

  details {
    margin-top: 10px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: rgb(255 255 255 / 0.015);
  }

  details[open] {
    border-color: var(--rule-strong);
  }

  summary {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 10px;
    padding: 12px 16px;
    color: var(--paper);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .n {
    color: var(--mist);
    font: 600 0.8rem / 1.8 var(--mono);
  }

  .answer {
    padding: 0 16px 14px 52px;
    color: #cbc4b1;
    font-size: 0.94rem;
  }

  .answer :global(* + *) {
    margin-top: 0.5em;
  }
</style>
