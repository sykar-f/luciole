---
// Output observed by running the code (a build, a request), not a file of the checkout.
import { Code } from "astro:components";
import type { BundledLanguage, SpecialLanguage } from "shiki";
import { night } from "../../lib/codeTheme";

interface Props {
  code: string;
  label: string;
  lang?: BundledLanguage | SpecialLanguage;
}

const { code, label, lang = "text" } = Astro.props;
---

<figure class="sample">
  <p class="bar"><span>observé</span>{label}</p>
  <Code code={code.trim()} lang={lang} theme={night} />
</figure>

<style>
  .sample {
    margin: 1.4em 0;
  }

  .bar {
    display: flex;
    gap: 10px;
    padding: 7px 14px;
    border: 1px solid var(--rule);
    border-bottom: 0;
    border-radius: 4px 10px 0 0;
    background: rgb(255 255 255 / 0.03);
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .bar span {
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sample :global(pre) {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--rule);
    border-radius: 0 0 10px 10px;
    background: #070604 !important;
    overflow-x: auto;
    font: 400 0.78rem / 1.65 var(--term);
    font-variant-ligatures: none;
    scrollbar-width: thin;
  }
</style>
