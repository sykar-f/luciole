---
// One step of a walkthrough, numbered as in its diagram, coloured by where it runs.
import { toneLabel, type Tone } from "../../lib/guide/tones";

interface Props {
  n: number | string;
  tone: Tone;
  title: string;
  /** Who acts, when the tone alone does not say it (a CLI, a supervisor, the user). */
  where?: string;
}

const { n, tone, title, where } = Astro.props;
---

<section class={`step tone-${tone}`}>
  <div class="marker" aria-hidden="true"><span>{n}</span></div>
  <div class="body">
    <p class="where">{where ?? toneLabel[tone]}</p>
    <h3>{title}</h3>
    <slot />
  </div>
</section>

<style>
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 16px;
    margin-top: 0 !important;
    padding-bottom: 26px;
  }

  /* A thread from one step to the next. */
  .step::before {
    content: "";
    position: absolute;
    top: 34px;
    bottom: 0;
    left: 16.5px;
    width: 1px;
    background: var(--rule-strong);
  }

  .step:has(+ :not(.step))::before,
  .step:last-child::before {
    display: none;
  }

  .marker span {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1.5px solid var(--tone);
    border-radius: 50%;
    background: var(--night);
    color: var(--paper);
    font: 600 0.8rem / 1 var(--mono);
  }

  .where {
    color: var(--tone);
    font: 400 0.7rem / 1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    margin: 3px 0 8px !important;
  }

  .body > :global(* + *) {
    margin-top: 0.7em;
  }

  .tone-client { --tone: var(--client); }
  .tone-server { --tone: var(--server); }
  .tone-wire { --tone: var(--wire); }
  .tone-build { --tone: var(--build); }
  .tone-neutral { --tone: var(--mist); }
</style>
