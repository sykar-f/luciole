---
interface Props {
  lines: string[];
  label?: string;
  /** Without its own box: a few lines of a longer transcript. */
  plain?: boolean;
}

const { lines, label, plain = false } = Astro.props;
---

<div class:list={["command", { plain }]} data-copy={lines.join("\n")}>
  <div class:list={["head", { bare: !label }]}>
    {label && <span>{label}</span>}
    <button type="button" data-copy-button>Copy</button>
  </div>
  <pre><code>{lines.map((line) => <span class="line"><span class="prompt" aria-hidden="true">$ </span>{line}</span>)}</code></pre>
</div>

<script>
  const CONFIRMATION_MS = 1800;
  for (const box of document.querySelectorAll<HTMLElement>("[data-copy]")) {
    const button = box.querySelector<HTMLButtonElement>("[data-copy-button]");
    button?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), CONFIRMATION_MS);
    });
  }
</script>

<style>
  .command {
    position: relative;
    border: 1px solid var(--rule-strong);
    background: var(--night-deep);
    overflow: hidden;
  }

  .command.plain {
    border: 0;
    background: none;
    overflow: visible;
  }

  .plain .head.bare {
    top: 50%;
    right: 0;
    transform: translateY(-50%);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 14px;
    border-bottom: 1px solid var(--rule);
    color: var(--mist);
    font: 400 0.85rem / 1.5 var(--mono);
  }

  .head.bare {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 0;
    border: 0;
  }

  .head.bare + pre {
    padding-right: 90px;
  }

  button {
    padding: 4px 8px;
    border: 1px solid var(--rule-strong);
    background: var(--night);
    color: var(--mist);
    font: 500 0.78rem / 1.4 var(--mono);
    cursor: pointer;
  }

  button:hover {
    border-color: var(--mist);
    color: var(--paper);
  }

  pre {
    margin: 0;
    padding: 14px;
    overflow-x: auto;
    font: 400 0.86rem / 1.7 var(--mono);
  }

  .plain pre {
    padding: 2px 0;
  }

  .line {
    display: block;
  }

  .prompt {
    color: var(--dim);
    user-select: none;
  }
</style>
