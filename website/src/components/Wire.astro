---
// Notes, running in this page (LiveTerminal.astro), behind a network the reader controls:
// the round trip and the next request's fault are the runtime's own (docs/WEB.md, "Page
// embarquée"), the timeline is what its transport reported, request by request. Keys
// never reach it: they are counted here, in the terminal, where they were handled.
import LiveTerminal from "./LiveTerminal.astro";
import { frame } from "../lib/frames";

const DEFAULT_RTT_MS = 500;
const faults = [
  { id: "", label: "Deliver" },
  { id: "refuse", label: "Lose the request" },
  { id: "drop", label: "Lose the response" },
  { id: "cut", label: "Cut the reply" },
];
---

<section class="section" id="wire" aria-labelledby="wire-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">latency</p>
      <h2 id="wire-title">The Server is 500 ms away. Your keyboard isn't.</h2>
      <p class="lede">
        Notes, the example app, running in this page with its Server half a second away. Move
        through the list, open a note, type, press <kbd>Enter</kbd> to save. On the right, every
        request that crossed the wire, as the transport reported it.
      </p>
    </div>

    <div class="demo" data-wire>
      <div class="side">
        <p class="side-label"><span class="client">Client</span> in your terminal</p>
        <LiveTerminal demo="notes" frame={frame("notes")} />
        <figure class="scope">
          <div class="scope-screen">
            <canvas data-scope aria-hidden="true"></canvas>
          </div>
          <figcaption>
            <span class="client">CH1</span> keys, handled in the terminal · <span class="server"
              >CH2</span
            > requests, open until the Server answers
          </figcaption>
        </figure>
      </div>

      <div class="side">
        <p class="side-label"><span class="server">The wire</span>, as the transport saw it</p>
        <div class="panel wire">
          <p class="tally">
            <span class="client" data-local>0</span> keys handled in the terminal ·{" "}
            <span class="server" data-remote>0</span> requests
          </p>
          <ol class="timeline" data-timeline aria-live="polite">
            <li class="empty">Nothing has crossed yet. Open a note with Enter.</li>
          </ol>
        </div>
      </div>
    </div>

    <div class="controls">
      <label class="rtt">
        <span>Round trip <output data-rtt-value>{DEFAULT_RTT_MS} ms</output></span>
        <input data-rtt type="range" min="0" max="1500" step="50" value={DEFAULT_RTT_MS} />
      </label>
      <fieldset class="faults">
        <legend>Next request</legend>
        {
          faults.map((fault, i) => (
            <label>
              <input type="radio" name="fault" value={fault.id} checked={i === 0} />
              <span>{fault.label}</span>
            </label>
          ))
        }
      </fieldset>
    </div>

    <p class="repro">
      The same on your machine: <code>AIRTTY_LATENCY_MS=500 AIRTTY_FAULT=drop:0.2 bun run dev</code>
    </p>

    <dl class="outcomes">
      <div>
        <dt><code>not-sent</code></dt>
        <dd>The request never left the terminal. Nothing happened on the Server; retrying is safe.</dd>
      </div>
      <div>
        <dt><code>rejected</code></dt>
        <dd>The Server answered and said no. Your Draft is still in the field.</dd>
      </div>
      <div>
        <dt><code>unknown</code></dt>
        <dd>
          The Server may have committed it. airtty never replays it behind your back: the app decides,
          here by asking the Server what became of the operation.
        </dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import * as z from "zod/mini";

  const TIMELINE_ROWS = 12;
  const KB = 1024;

  /** How much time the scope shows, and how long a key's tick and a torn frame last. */
  const SCOPE_MS = 8000;
  const TICK_MS = 60;
  const TEAR_MS = 160;

  /**
   * Two channels, as on an oscilloscope: a tick on CH1 for each key, handled at once in the
   * terminal; on CH2, a pulse from each request to its answer, as long as the round trip.
   * Time runs right to left. It moves only while something is on it; with reduced motion,
   * it is drawn again only when something happens.
   */
  function scope(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    const style = getComputedStyle(document.documentElement);
    const color = (name: string) => style.getPropertyValue(name).trim();
    const client = color("--client");
    const server = color("--server");
    const fault = color("--fault");
    const grid = color("--rule");
    const keys: number[] = [];
    const requests = new Map<number, { from: number; to?: number; failed?: boolean }>();
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let running = false;

    const draw = (now: number) => {
      if (!context) return;
      const ratio = devicePixelRatio || 1;
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      if (canvas.width !== Math.round(width * ratio)) canvas.width = Math.round(width * ratio);
      if (canvas.height !== Math.round(height * ratio)) canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);
      const x = (t: number) => width - ((now - t) / SCOPE_MS) * width;
      const one = height * 0.3;
      const two = height * 0.8;
      const rise = height * 0.2;

      // A division a second, and each channel's baseline.
      context.strokeStyle = grid;
      context.lineWidth = 1;
      context.setLineDash([2, 4]);
      context.beginPath();
      for (let second = 1; second < SCOPE_MS / 1000; second++) {
        const at = Math.round((second / (SCOPE_MS / 1000)) * width) + 0.5;
        context.moveTo(at, 0);
        context.lineTo(at, height);
      }
      context.stroke();
      context.setLineDash([]);

      const trace = (stroke: string, path: () => void) => {
        context.strokeStyle = stroke;
        context.shadowColor = stroke;
        context.shadowBlur = 6;
        context.lineWidth = 1.5;
        context.beginPath();
        path();
        context.stroke();
        context.shadowBlur = 0;
      };

      trace(client, () => {
        context.moveTo(0, one);
        for (const t of keys) {
          const at = x(t);
          if (at < -4) continue;
          context.lineTo(at, one);
          context.lineTo(at + 1, one - rise);
          context.lineTo(at + Math.max(2, (TICK_MS / SCOPE_MS) * width), one);
        }
        context.lineTo(width, one);
      });

      const pulses = [...requests.values()].sort((a, b) => a.from - b.from);
      trace(server, () => {
        context.moveTo(0, two);
        for (const pulse of pulses) {
          const start = Math.max(0, x(pulse.from));
          const end = x(pulse.to ?? now);
          if (end < 0) continue;
          context.lineTo(start, two);
          context.lineTo(start, two - rise);
          context.lineTo(end, two - rise);
          context.lineTo(end, two);
        }
        context.lineTo(width, two);
      });
      // A lost or cut answer: its pulse ends torn, in the fault's colour.
      for (const pulse of pulses) {
        if (!pulse.failed || pulse.to === undefined) continue;
        const end = x(pulse.to);
        if (end < 0) continue;
        trace(fault, () => {
          context.moveTo(end - 10, two - rise);
          context.lineTo(end - 6, two - rise * 0.4);
          context.lineTo(end - 3, two - rise * 0.9);
          context.lineTo(end, two);
        });
      }

      // Drop what has left the screen.
      while (keys.length && x(keys[0]!) < -4) keys.shift();
      for (const [id, pulse] of requests) if (pulse.to !== undefined && x(pulse.to) < 0) requests.delete(id);
      return keys.length > 0 || requests.size > 0;
    };

    const frame = (now: number) => {
      running = draw(now) ?? false;
      if (running) requestAnimationFrame(frame);
    };
    const wake = () => {
      if (still) return void draw(performance.now());
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    };
    new ResizeObserver(() => draw(performance.now())).observe(canvas);
    return {
      key: () => {
        keys.push(performance.now());
        wake();
      },
      request: (id: number) => {
        requests.set(id, { from: performance.now() });
        wake();
      },
      answer: (id: number, failed: boolean) => {
        const pulse = requests.get(id);
        if (pulse) Object.assign(pulse, { to: performance.now(), failed });
        wake();
      },
    };
  }

  const Event = z.object({
    source: z.literal("airtty"),
    type: z.literal("event"),
    event: z.object({
      type: z.string(),
      id: z.optional(z.number()),
      kind: z.optional(z.enum(["render", "action"])),
      target: z.optional(z.string()),
      cause: z.optional(z.string()),
      ms: z.optional(z.number()),
      bytes: z.optional(z.number()),
      outcome: z.optional(z.string()),
      paths: z.optional(z.array(z.string())),
      tags: z.optional(z.array(z.string())),
    }),
  });
  type Reported = z.infer<typeof Event>["event"];
  const Drawn = z.object({ source: z.literal("airtty"), type: z.literal("stage"), stage: z.literal("drawn") });

  const section = document.querySelector<HTMLElement>("[data-wire]");
  const timeline = document.querySelector<HTMLOListElement>("[data-timeline]");
  const rtt = document.querySelector<HTMLInputElement>("[data-rtt]");
  const rttValue = document.querySelector<HTMLOutputElement>("[data-rtt-value]");
  const local = document.querySelector<HTMLElement>("[data-local]");
  const remote = document.querySelector<HTMLElement>("[data-remote]");
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="fault"]')];
  const canvas = document.querySelector<HTMLCanvasElement>("[data-scope]");

  if (section && timeline && rtt && rttValue && local && remote) {
    const channels = canvas ? scope(canvas) : undefined;
    // An injected fault, and only that, tears the terminal's picture for a moment.
    const tear = () => {
      const live = section.querySelector<HTMLElement>("[data-live]");
      if (!live) return;
      live.classList.remove("torn");
      void live.offsetWidth;
      live.classList.add("torn");
      setTimeout(() => live.classList.remove("torn"), TEAR_MS);
    };
    const frame = () => section.querySelector("iframe");
    let keys = 0;
    let requests = 0;
    let armed = false;
    let keysRow: HTMLLIElement | undefined;
    // Keys since the last request: one row per stretch of local work.
    let stretch = 0;
    const rows = new Map<number, { row: HTMLLIElement; cause: string }>();

    const fault = () => radios.find((radio) => radio.checked)?.value || undefined;
    const send = () => {
      armed = fault() !== undefined;
      frame()?.contentWindow?.postMessage(
        { source: "airtty", type: "network", latencyMs: Number(rtt.value), fault: fault() },
        location.origin,
      );
    };
    rtt.addEventListener("input", () => {
      rttValue.value = `${rtt.value} ms`;
      send();
    });
    for (const radio of radios) radio.addEventListener("change", send);

    const add = (className: string, text: string) => {
      timeline.querySelector(".empty")?.remove();
      const row = document.createElement("li");
      row.className = className;
      row.textContent = text;
      timeline.prepend(row);
      while (timeline.children.length > TIMELINE_ROWS) timeline.lastElementChild?.remove();
      return row;
    };
    // Routes and Server Functions by their last name: /notes/$id, saveNote.
    const name = (event: Reported) =>
      event.kind === "action" ? `${event.target?.split(/[#/]/).at(-1)}()` : `render ${event.target}`;
    const size = (bytes = 0) => (bytes < KB ? `${bytes} B` : `${(bytes / KB).toFixed(1)} kB`);

    const report = (event: Reported) => {
      if (event.type === "invalidate") {
        keysRow = undefined;
        const what = [...(event.tags ?? []), ...(event.paths ?? [])].join(", ");
        add("server", `↺ the Server invalidated ${what || "its cached reads"}`);
        return;
      }
      if (event.id === undefined) return;
      if (event.type === "request") {
        keysRow = undefined;
        remote.textContent = String(++requests);
        const cause = event.cause ?? "unknown";
        rows.set(event.id, { row: add("pending", `→ ${name(event)} · ${cause} · waiting`), cause });
        channels?.request(event.id);
        // The fault the page armed went with this request: back to delivering.
        if (armed) {
          armed = false;
          const deliver = radios[0];
          if (deliver) deliver.checked = true;
        }
        return;
      }
      const { row, cause } = rows.get(event.id) ?? { row: add("pending", ""), cause: "unknown" };
      const ms = `${Math.round(event.ms ?? 0)} ms`;
      if (event.type === "end") {
        row.className = "done";
        row.textContent = `✓ ${name(event)} · ${cause} · ${ms} · ${size(event.bytes)}`;
        channels?.answer(event.id, false);
      } else if (event.type === "error") {
        row.className = "failed";
        row.textContent = `✗ ${name(event)} · ${cause} · ${event.outcome} after ${ms}`;
        channels?.answer(event.id, true);
        tear();
      }
    };

    addEventListener("message", (event) => {
      const source = frame();
      if (!source || event.source !== source.contentWindow || event.origin !== location.origin)
        return;
      const reported = Event.safeParse(event.data);
      if (reported.success) return report(reported.data.event);
      // Once drawn, the Server moves half a second away, and keys start being counted.
      if (Drawn.safeParse(event.data).success) {
        send();
        // Capture: xterm.js stops the keys it handles from bubbling.
        source.contentDocument?.addEventListener("keydown", () => {
          local.textContent = String(++keys);
          channels?.key();
          if (!keysRow) {
            keysRow = add("local", "");
            stretch = 0;
          }
          stretch++;
          keysRow.textContent = `⌨ ${stretch} ${stretch === 1 ? "key" : "keys"} handled in the terminal`;
        }, { capture: true });
      }
    });
  }
</script>

<style>
  kbd {
    white-space: nowrap;
  }

  /* The instrument of the page: it gets the room. */
  .section {
    padding-block: clamp(80px, 11vw, 160px);
  }

  .demo {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 24px;
    align-items: start;
  }

  .side {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .side-label {
    color: var(--mist);
    font: 400 var(--step--1) / 1.5 var(--mono);
  }

  /* A picture torn for a moment, only when a fault was really injected. */
  .side :global(.torn .screen) {
    animation: tear 160ms steps(3) both;
  }

  @keyframes tear {
    0% {
      clip-path: inset(0 0 55% 0);
      transform: translateX(6px);
    }
    50% {
      clip-path: inset(40% 0 0 0);
      transform: translateX(-4px);
    }
    100% {
      clip-path: none;
      transform: none;
    }
  }

  .scope {
    margin: 0;
  }

  .scope-screen {
    position: relative;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--screen);
    overflow: hidden;
  }

  .scope-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 140% at 50% 50%, transparent 60%, rgb(0 0 0 / 0.45)),
      repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.16) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }

  canvas {
    display: block;
    width: 100%;
    height: 132px;
  }

  .scope figcaption {
    margin-top: 8px;
    color: var(--mist);
    font: 400 0.75rem / 1.5 var(--mono);
  }

  .wire {
    display: grid;
    gap: 12px;
    padding: 16px 18px;
    min-height: 100%;
  }

  .tally {
    color: var(--mist);
    font: 400 0.8rem / 1.5 var(--mono);
  }

  .timeline {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 0.78rem / 1.5 var(--mono);
  }

  .timeline :global(li) {
    padding: 5px 10px;
    border-left: 2px solid var(--rule-strong);
    color: var(--mist);
    overflow-wrap: anywhere;
    animation: arrive 0.2s steps(2) both;
  }

  .timeline :global(.empty) {
    border-left-color: transparent;
    color: var(--mist);
  }

  .timeline :global(.local) {
    border-left-color: var(--client);
    color: var(--client);
  }

  .timeline :global(.pending) {
    border-left-color: var(--server);
    color: var(--paper);
  }

  .timeline :global(.done),
  .timeline :global(.server) {
    border-left-color: var(--server);
    color: var(--server);
  }

  .timeline :global(.failed) {
    border-left-color: var(--fault);
    color: var(--fault);
  }

  /* The line of a failed request ends torn. */
  .timeline :global(.failed)::after {
    content: " ▒▒░" / "";
  }

  @keyframes arrive {
    from {
      opacity: 0;
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 20px;
    padding: 14px 18px;
    border: 1px solid var(--rule);
    font: 400 0.82rem / 1.5 var(--mono);
  }

  .rtt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    color: var(--mist);
  }

  .rtt output {
    color: var(--server);
    font-variant-numeric: tabular-nums;
  }

  .rtt input {
    accent-color: var(--server);
  }

  .faults {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .faults legend {
    float: left;
    margin-right: 4px;
    color: var(--mist);
  }

  .faults label span {
    display: inline-block;
    padding: 4px 0;
    color: var(--mist);
    cursor: pointer;
  }

  /* Radio buttons as a terminal draws them. */
  .faults label span::before {
    content: "( ) " / "";
    color: var(--dim);
    white-space: pre;
  }

  .faults input {
    position: absolute;
    opacity: 0;
  }

  .faults input:checked + span {
    color: var(--paper);
  }

  .faults input:checked + span::before {
    content: "(•) " / "";
    color: var(--paper);
  }

  .faults input:focus-visible + span {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }

  .repro {
    margin-top: 14px;
    color: var(--mist);
    font-size: 0.85rem;
  }

  .outcomes {
    display: grid;
    margin: 44px 0 0;
    border-top: 1px solid var(--rule);
  }

  .outcomes div {
    display: grid;
    grid-template-columns: 14ch minmax(0, 1fr);
    gap: 8px 32px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .outcomes dt code {
    padding: 0;
    background: none;
    color: var(--paper);
    font-weight: 600;
  }

  .outcomes dd {
    margin: 0;
    max-width: 72ch;
    color: var(--mist);
    font-size: 0.92rem;
  }

  @media (max-width: 960px) {
    .demo {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .outcomes div {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side :global(.torn .screen),
    .timeline :global(li) {
      animation: none;
    }
  }
</style>
