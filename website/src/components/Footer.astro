---
import Wordmark from "./Wordmark.astro";
import { repo, source } from "../lib/links";

const links = [
  ["/examples/", "Examples"],
  ["/docs/", "Docs"],
  ["/status/", "Status"],
  [repo, "GitHub"],
  [source("CHANGELOG.md"), "Changelog"],
  [source("SECURITY.md"), "Security"],
  [source("LICENSE"), "License"],
  [source("CONTRIBUTING.md"), "Contributing"],
];
---

<footer class="footer">
  <div class="wrap inner">
    <a class="mark" href="/" aria-label="luciole, home"><Wordmark /></a>
    <nav aria-label="Site">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <p class="name">
      Luciole means firefly. Interaction stays in your terminal; Server Components stay next to
      your data.
    </p>
    <p class="note">
      Developed in the open, on React, OpenTUI, TanStack Router and Bun. This site is built with
      Astro; its terminal screens come from <a href={source("website/scripts/capture.py")}
        >a capture script</a
      >, not a design tool.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: 36px 0 56px;
    border-top: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 40px;
    color: var(--mist);
    font-size: 0.9rem;
  }

  .mark {
    color: var(--paper);
    font: 700 1.1rem / 1 var(--mono);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font: 400 0.85rem / 1.5 var(--mono);
  }

  nav a {
    color: var(--mist);
  }

  nav a:hover {
    color: var(--paper);
  }

  .name {
    flex: 1 1 100%;
    color: var(--paper);
  }

  .note {
    flex: 1 1 100%;
    max-width: 80ch;
  }
</style>
