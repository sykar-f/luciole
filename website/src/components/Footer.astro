---
import { repo, source } from "../lib/links";
---

<section class="cta" aria-labelledby="cta-title">
  <div class="wrap">
    <h2 id="cta-title">Clone it. Slow the network down.<br />Keep typing.</h2>
    <div class="actions">
      <a class="button primary" href="#start">Get started</a>
      <a class="button" href={repo}>Star on GitHub</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap inner">
    <p class="mark">air<span>tty</span></p>
    <p class="note">
      Open source and developed in the open, on React, OpenTUI, TanStack Router and Bun. This page is
      built with Astro; its terminal screens come from <a href={source("website/scripts/capture.py")}
        >a capture script</a
      >, not a design tool.
    </p>
    <a href={repo}>Source on GitHub</a>
  </div>
</footer>

<style>
  .cta {
    position: relative;
    padding: clamp(90px, 12vw, 160px) 0;
    overflow: hidden;
    text-align: center;
  }

  .cta::before {
    content: "";
    position: absolute;
    bottom: -60%;
    left: 50%;
    width: 1000px;
    height: 600px;
    background:
      radial-gradient(closest-side at 35% 50%, rgb(103 217 188 / 0.18), transparent),
      radial-gradient(closest-side at 65% 50%, rgb(255 188 102 / 0.14), transparent);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .cta h2 {
    position: relative;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.8rem);
    background: linear-gradient(180deg, #fff 30%, #9fb0c6);
    background-clip: text;
    color: transparent;
  }

  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .footer {
    padding: 40px 0 56px;
    border-top: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 40px;
    color: var(--dim);
    font-size: 0.88rem;
  }

  .mark {
    color: var(--paper);
    font: 700 1.1rem / 1 var(--mono);
    letter-spacing: -0.04em;
  }

  .mark span {
    color: var(--client);
  }

  .note {
    flex: 1;
    min-width: 260px;
    max-width: 70ch;
  }
</style>
