---
import { repo, source } from "../lib/links";
---

<section class="cta" aria-labelledby="cta-title">
  <div class="wrap">
    <h2 id="cta-title">
      <span class="prompt" aria-hidden="true">&gt; </span>Clone it. Slow the network down.<br />Keep
      typing.<span class="cursor" aria-hidden="true"></span>
    </h2>
    <div class="actions">
      <a class="button primary" href="#start">Get started</a>
      <a class="button" href={repo}>Star on GitHub</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap inner">
    <p class="mark">air<span>tty</span></p>
    <p class="note">
      Open source and developed in the open, on React, OpenTUI, TanStack Router and Bun. This page is
      built with Astro; its terminal screens come from <a href={source("website/scripts/capture.py")}
        >a capture script</a
      >, not a design tool.
    </p>
    <a href={repo}>Source on GitHub</a>
  </div>
</footer>

<style>
  .cta {
    padding: clamp(72px, 10vw, 136px) 0;
    border-top: 1px solid var(--rule);
  }

  .cta h2 {
    font-size: clamp(1.7rem, 1.1rem + 2.6vw, 3.2rem);
    letter-spacing: 0;
  }

  .prompt {
    color: var(--dim);
  }

  /* The prompt waits, as a shell does. */
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 0.15em;
    background: var(--paper);
    vertical-align: -0.12em;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .footer {
    padding: 36px 0 56px;
    border-top: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 40px;
    color: var(--mist);
    font-size: 0.9rem;
  }

  .mark {
    color: var(--paper);
    font: 700 1.1rem / 1 var(--mono);
  }

  .mark span {
    color: var(--mist);
  }

  .note {
    flex: 1;
    min-width: 260px;
    max-width: 70ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
