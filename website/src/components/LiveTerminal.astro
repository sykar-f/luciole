---
// An example application running in this page (scripts/demo.ts, docs/WEB.md "Page
// embarquée"), over its own captured screen. The capture is written into an xterm.js of
// the page's, set up exactly as the runtime sets up its own (font, colours, grid), so
// once the application shows the capture's screen, one terminal replaces the other cell
// for cell and the reader sees no change. A script may walk it to that screen (sign in,
// open a pull request); a screen that never comes to match is shown after a while
// anyway. The reader takes the keyboard by clicking it: until then, the page scrolls over
// it as over a picture. The capture's HTML drawing stays for narrow screens, where
// nothing starts, and for readers without scripts.
import Screen from "./Screen.astro";
import { ansi, lines, SCREEN_BACKGROUND, SCREEN_FOREGROUND, type Frame } from "../lib/frames";

/**
 * Wait until the screen shows `wait`, then type `type` into it as a keyboard would, then
 * let `pause` milliseconds pass: what a key changed (a focused field) is not always text.
 */
export type Step = { wait: string; type: string; pause?: number };

interface Props {
  /** The demo's directory under public/demo/. */
  demo: string;
  /** Its captured screen: the poster, and the grid the live terminal keeps. */
  frame: Frame;
  script?: Step[];
  /**
   * `eager` starts with the page; `visible`, when the window comes near the viewport;
   * `manual`, when its container sends it `live:start` (and `live:stop` puts it back).
   */
  boot?: "eager" | "visible" | "manual";
  /**
   * Reopen the demo where the reader left it. Off by default: a visitor comes back to the
   * screen the capture shows, not to a note they opened last time.
   */
  restore?: boolean;
  glow?: boolean;
  tilt?: boolean;
  printed?: boolean;
}

const {
  demo,
  frame,
  script = [],
  boot = "visible",
  restore = false,
  glow = false,
  tilt = false,
  printed = false,
} = Astro.props;

// The capture's own colours (--screen, --screen-fg): both terminals take them.
const look = new URLSearchParams({
  columns: String(frame.cols),
  rows: String(frame.rows),
  background: SCREEN_BACKGROUND.slice(1),
  foreground: SCREEN_FOREGROUND.slice(1),
  ...(restore ? {} : { restore: "off" }),
});
// index.html by name: Astro's dev server serves no directory index from public/.
const src = `/demo/${demo}/index.html?${look}`;

// Inline JSON: `<` escaped, so no captured text can close its script element. `lines`: the
// text the live screen must show before it replaces the capture.
const stand = JSON.stringify({
  ansi: ansi(frame),
  lines: lines(frame),
  columns: frame.cols,
  rows: frame.rows,
  background: SCREEN_BACKGROUND,
  foreground: SCREEN_FOREGROUND,
}).replaceAll("<", "\\u003c");
---

<div
  class="live"
  data-live
  data-src={src}
  data-boot={boot}
  data-script={JSON.stringify(script)}
>
  <Screen frame={frame} glow={glow} tilt={tilt} printed={printed}>
    <div slot="live" class="layer">
      <span class="take" data-take hidden>Live · click to use the keyboard</span>
    </div>
  </Screen>
  <script type="application/json" data-stand set:html={stand} />
  <script is:inline>
    // Before the first paint: where the demo will run, the HTML drawing gives way to the
    // terminal that stands in for it, not to a font change a moment later.
    {
      const root = document.currentScript.parentElement;
      const narrow = matchMedia("(max-width: 760px)").matches;
      if (!narrow && navigator.connection?.saveData !== true) root.classList.add("standing");
    }
  </script>
  <p class="fallback" data-fallback hidden>
    Too narrow to run here: <a href={src}>open {demo} in its own page</a>.
  </p>
</div>

<script>
  import * as z from "zod/mini";
  import { Terminal } from "@xterm/xterm";
  import { FitAddon } from "@xterm/addon-fit";
  import "@xterm/xterm/css/xterm.css";

  const Stage = z.object({ source: z.literal("airtty"), type: z.literal("stage"), stage: z.string() });
  const Script = z.array(
    z.object({ wait: z.string(), type: z.string(), pause: z.optional(z.number()) }),
  );
  const Connection = z.object({ saveData: z.optional(z.boolean()) });
  const Stand = z.object({
    ansi: z.string(),
    lines: z.array(z.string()),
    columns: z.number(),
    rows: z.number(),
    background: z.string(),
    foreground: z.string(),
  });

  const DRAWN_TIMEOUT_MS = 20_000;
  const STEP_TIMEOUT_MS = 8_000;
  /** How long the capture stays up for a live screen that does not come to match it. */
  const MATCH_TIMEOUT_MS = 8_000;
  /**
   * The share of rows that must read as the capture's: a duration measured again (Chat), a
   * date in the reader's language (mdreader) may differ, not a screen still loading.
   */
  const MATCHING_ROWS = 0.95;
  const POLL_MS = 80;
  /** Below this width a wide terminal's cells are too small to read: no start. */
  const NARROW = "(max-width: 760px)";

  /** The reader asked the browser to spare data: nothing starts by itself. */
  const saving = () => Connection.safeParse(Reflect.get(navigator, "connection")).data?.saveData === true;

  const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));

  // As the runtime sets up its terminal (packages/airtty/src/web/platform/run.tsx): the same
  // fonts, and the largest size at which the grid fits, so both draw every cell alike.
  const FONTS =
    'ui-monospace, "SF Mono", Menlo, "Cascadia Mono", Consolas, "DejaVu Sans Mono", monospace';
  const LARGEST_FONT = 24;
  const SMALLEST_FONT = 4;
  const FONT_STEP = 0.25;

  /**
   * The terminal that stands in for the application until it has drawn: the capture,
   * written once, never focused. It stays under the application's, and shows again when
   * a gallery stops the demo.
   */
  /** Resolves once a stand-in has drawn its capture: only then may the application load. */
  const standing = new WeakMap<HTMLElement, Promise<void>>();

  const standOf = (root: HTMLElement) =>
    Stand.safeParse(JSON.parse(root.querySelector("[data-stand]")?.textContent ?? "null"));

  function stand(root: HTMLElement) {
    let drawn = () => {};
    standing.set(
      root,
      new Promise<void>((resolve) => (drawn = resolve)).then(() => {
        // Told to the container too: a gallery unloads its other demos only then.
        root.dataset.stood = "";
        root.dispatchEvent(new Event("live:stood"));
      }),
    );
    const layer = root.querySelector<HTMLElement>(".layer");
    const parsed = standOf(root);
    if (!layer || !parsed.success) return;
    const { ansi, columns, rows, background, foreground } = parsed.data;
    const holder = document.createElement("div");
    holder.className = "stand";
    holder.setAttribute("aria-hidden", "true");
    layer.prepend(holder);
    const terminal = new Terminal({
      fontFamily: FONTS,
      theme: { background, foreground },
      disableStdin: true,
      cursorInactiveStyle: "none",
    });
    const fit = new FitAddon();
    terminal.loadAddon(fit);
    terminal.open(holder);
    let written = false;
    const layout = () => {
      // A hidden gallery panel has no size yet: laid out, then written, once it is shown,
      // at its grid; written earlier, the capture would be cut to xterm's 80x24.
      if (!holder.clientWidth) return;
      // As the runtime (fitGrid): the largest size on FONT_STEP steps at which the grid
      // fits, by bisection; the same size, so the same cells.
      const fits = (size: number) => {
        terminal.options.fontSize = size;
        const room = fit.proposeDimensions();
        return room !== undefined && room.cols >= columns && room.rows >= rows;
      };
      let low = 0;
      let high = (LARGEST_FONT - SMALLEST_FONT) / FONT_STEP;
      while (low < high) {
        const middle = Math.ceil((low + high) / 2);
        if (fits(SMALLEST_FONT + middle * FONT_STEP)) low = middle;
        else high = middle - 1;
      }
      terminal.options.fontSize = SMALLEST_FONT + low * FONT_STEP;
      terminal.resize(columns, rows);
      if (written) return;
      written = true;
      // Written, then painted: the next frame shows it.
      terminal.write(ansi, () => requestAnimationFrame(() => drawn()));
    };
    layout();
    new ResizeObserver(layout).observe(holder);
  }

  /** The rows xterm.js draws into the frame's DOM (same origin), as the capture's `lines`. */
  const rowsOf = (frame: HTMLIFrameElement) =>
    [...(frame.contentDocument?.querySelectorAll(".xterm-rows > div") ?? [])].map((row) =>
      (row.textContent ?? "").replaceAll("\u00a0", " ").trimEnd(),
    );
  const screenOf = (frame: HTMLIFrameElement) => rowsOf(frame).join("\n");

  /**
   * Waits until the live screen reads as the capture, twice in a row: the application may
   * show the text a script waits for, or draw its first frame, before the rest of its
   * screen has come (a description streamed later, a list read from the Server). Returns
   * the rows that still differ when it gives up, none once it matches.
   */
  async function settle(frame: HTMLIFrameElement, capture: string[], signal: AbortSignal) {
    const deadline = performance.now() + MATCH_TIMEOUT_MS;
    const allowed = Math.floor(capture.length * (1 - MATCHING_ROWS));
    let previous = "";
    for (;;) {
      const rows = rowsOf(frame);
      const differing = capture.flatMap((line, i) => (rows[i] === line ? [] : [i]));
      const screen = rows.join("\n");
      if (differing.length <= allowed && screen === previous) return [];
      if (signal.aborted || performance.now() > deadline)
        return differing.map((i) => ({ row: i, capture: capture[i], live: rows[i] }));
      previous = screen;
      await sleep(POLL_MS);
    }
  }

  type Step = z.infer<typeof Script>[number];

  /**
   * Plays `steps` in order. When the screen shows a later step's text and not the current
   * one's, the steps between are skipped: a restored session may start past the sign-in.
   * Gives up quietly when nothing it waits for shows in time, or when the demo stops.
   */
  async function play(frame: HTMLIFrameElement, steps: Step[], signal: AbortSignal) {
    let next = 0;
    while (next < steps.length) {
      const deadline = performance.now() + STEP_TIMEOUT_MS;
      let found = -1;
      while (found < 0) {
        if (signal.aborted || performance.now() > deadline) return;
        const screen = screenOf(frame);
        // The current step first: two in a row may wait for the same screen.
        found = screen.includes(steps[next]?.wait ?? "")
          ? next
          : steps.findLastIndex((step, i) => i > next && screen.includes(step.wait));
        if (found < 0) await sleep(POLL_MS);
      }
      const step = steps[found];
      if (step?.type) type(frame, step.type);
      if (step?.pause) await sleep(step.pause);
      next = found + 1;
    }
  }

  const type = (frame: HTMLIFrameElement, data: string) =>
    frame.contentWindow?.postMessage({ source: "airtty", type: "input", data }, location.origin);

  /** How to stop each started demo: its frame removed, its capture back. */
  const stops = new WeakMap<HTMLElement, () => void>();

  function start(root: HTMLElement) {
    const layer = root.querySelector<HTMLElement>(".layer");
    const take = root.querySelector<HTMLElement>("[data-take]");
    if (!layer || !take || stops.has(root)) return;
    const alive = new AbortController();
    const { signal } = alive;
    // A same-origin frame shares this thread: its start would hold the stand-in's paint.
    const ready = standing.get(root) ?? Promise.resolve();
    const script = Script.safeParse(JSON.parse(root.dataset.script ?? "[]"));
    const capture = standOf(root).data?.lines ?? [];

    const frame = document.createElement("iframe");
    frame.title = "An airtty application running in this page";
    frame.src = root.dataset.src ?? "";
    frame.allow = "clipboard-write";
    frame.tabIndex = -1;
    void ready.then(() => signal.aborted || layer.insertBefore(frame, take));

    let drawn = false;
    const reveal = () => {
      if (signal.aborted) return;
      root.classList.add("on");
      take.hidden = false;
      layer.setAttribute("role", "button");
      layer.setAttribute("aria-label", "Use the live application with the keyboard");
      layer.tabIndex = 0;
    };
    const stop = () => {
      alive.abort();
      stops.delete(root);
      frame.remove();
      root.classList.remove("on", "held");
      take.hidden = true;
      layer.removeAttribute("role");
      layer.removeAttribute("aria-label");
      layer.removeAttribute("tabindex");
    };
    stops.set(root, stop);
    setTimeout(() => drawn || stop(), DRAWN_TIMEOUT_MS);

    addEventListener(
      "message",
      async (event) => {
        if (event.source !== frame.contentWindow || event.origin !== location.origin) return;
        const message = Stage.safeParse(event.data);
        if (!message.success) return;
        if (message.data.stage !== "drawn") return;
        drawn = true;
        await play(frame, script.success ? script.data : [], signal);
        const differing = await settle(frame, capture, signal);
        // Shown anyway, the application being the point; the capture is then out of date
        // (scripts/capture.py) or the script no longer reaches its screen.
        if (import.meta.env.DEV && differing.length && !signal.aborted)
          console.warn(`${root.dataset.src} does not show its capture:`, differing);
        reveal();
      },
      { signal },
    );

    // The reader takes the keyboard; a click anywhere else gives the page back.
    const keyboard = () => {
      frame.focus();
      frame.contentDocument?.querySelector<HTMLElement>(".xterm-helper-textarea")?.focus();
    };
    const hold = (held: boolean) => {
      root.classList.toggle("held", held);
      take.hidden = held || !root.classList.contains("on");
      frame.tabIndex = held ? 0 : -1;
      if (held) keyboard();
    };
    // Held, the screen's own focus belongs to the terminal: keys typed there must not fall
    // on the wrapper.
    layer.addEventListener("focus", () => root.classList.contains("held") && keyboard(), {
      signal,
    });
    // The whole screen takes the keyboard: a hint in a corner is easy to miss on 40 rows.
    const takeIfLive = () =>
      root.classList.contains("on") && !root.classList.contains("held") && hold(true);
    layer.addEventListener("click", takeIfLive, { signal });
    layer.addEventListener(
      "keydown",
      (event) => {
        if (event.target !== layer || (event.key !== "Enter" && event.key !== " ")) return;
        event.preventDefault();
        takeIfLive();
      },
      { signal },
    );
    document.addEventListener(
      "pointerdown",
      (event) => {
        if (event.target instanceof Node && !root.contains(event.target)) hold(false);
      },
      { signal },
    );
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-live]")) {
    if (matchMedia(NARROW).matches || saving()) {
      root.classList.remove("standing");
      root.querySelector<HTMLElement>("[data-fallback]")?.removeAttribute("hidden");
      continue;
    }
    stand(root);
    // `manual`: a gallery starts and stops its demos as the reader picks one.
    root.addEventListener("live:start", () => start(root));
    root.addEventListener("live:stop", () => stops.get(root)?.());
    if (root.dataset.boot === "manual") continue;
    if (root.dataset.boot === "eager") {
      start(root);
      continue;
    }
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        start(root);
      },
      { rootMargin: "400px 0px" },
    );
    near.observe(root);
  }
</script>

<style>
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .layer :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--screen);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .on .layer :global(iframe) {
    opacity: 1;
  }

  /* Live and not held: the screen is one button; the wheel still scrolls the page. */
  .on .layer {
    pointer-events: auto;
    cursor: pointer;
  }

  .held .layer {
    cursor: auto;
  }

  .held .layer :global(iframe) {
    pointer-events: auto;
  }

  /* Where a demo runs, the HTML drawing keeps the window's size; terminals draw in it. */
  .standing :global(.grid) {
    visibility: hidden;
  }

  /* As the runtime's page lays out #airtty: the same box, so the same cells. Created by
     the script: outside the component's scoped styles. */
  .layer :global(.stand) {
    position: absolute;
    inset: 0;
    padding: 8px;
    box-sizing: border-box;
    background: var(--screen);
    pointer-events: none;
  }

  .take {
    position: absolute;
    top: 10px;
    right: 14px;
    padding: 6px 12px;
    border: 1px solid rgb(103 217 188 / 0.45);
    border-radius: 999px;
    background: rgb(7 11 18 / 0.85);
    color: var(--client);
    font: 500 0.75rem / 1.2 var(--mono);
    backdrop-filter: blur(6px);
    transition: border-color 0.2s;
  }

  .on:not(.held) .layer:hover .take {
    border-color: var(--client);
  }

  .fallback {
    margin-top: 14px;
    color: var(--dim);
    font-size: var(--step--1);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .layer :global(iframe) {
      transition: none;
    }
  }
</style>
