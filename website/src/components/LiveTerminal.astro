---
// An example application running in this page (scripts/demo.ts, docs/WEB.md "Page
// embarquée"), over its own captured screen. The capture is written into an xterm.js of
// the page's, set up exactly as the runtime sets up its own (font, colours, grid), so
// once the application shows the capture's screen, one terminal replaces the other cell
// for cell and the reader sees no change. A script may walk it to that screen (sign in,
// open a pull request); a screen that never comes to match is shown after a while
// anyway. The reader takes the keyboard by clicking it: until then, the page scrolls over
// it as over a picture. The capture's HTML drawing stays for narrow screens, where
// nothing starts, and for readers without scripts.
import Screen from "./Screen.astro";
import { ansi, GLOW_HOT, GLOW_WARM, lines, patch, type Frame } from "../lib/frames";

/**
 * Wait until the screen shows `wait`, then type `type` into it as a keyboard would, then
 * let `pause` milliseconds pass: what a key changed (a focused field) is not always text.
 * `timeout`: how long `wait` may take, 8 s unless the application needs longer (a
 * scripted agent streams its answer).
 */
export type Step = { wait: string; type: string; pause?: number; timeout?: number };

interface Props {
  /** The demo's directory under public/demo/. */
  demo: string;
  /** Its captured screen: the poster, and the grid the live terminal keeps. */
  frame: Frame;
  script?: Step[];
  /**
   * `eager` starts with the page; `visible`, when the window comes near the viewport;
   * `manual`, when its container sends it `live:start` (and `live:stop` puts it back).
   * Any of them starts on `live:take`, which also hands it the keyboard.
   */
  boot?: "eager" | "visible" | "manual";
  /**
   * Reopen the demo where the reader left it. Off by default: a visitor comes back to the
   * screen the capture shows, not to a note they opened last time.
   */
  restore?: boolean;
  printed?: boolean;
  /**
   * Screens drawn before the capture, as a terminal renderer would: from an empty screen,
   * each writes only the cells that differ from the one before, and those glow a moment.
   * The screen switches on first. A counter under it says how many cells each wrote.
   */
  intro?: Frame[];
  /** Once live, make each cell the application rewrites glow a moment. */
  afterglow?: boolean;
}

const {
  demo,
  frame,
  script = [],
  boot = "visible",
  restore = false,
  printed = false,
  intro = [],
  afterglow = false,
} = Astro.props;

// The screen's colours (--screen, --screen-fg) are the palette's: added when it starts.
const look = new URLSearchParams({
  columns: String(frame.cols),
  rows: String(frame.rows),
  ...(restore ? {} : { restore: "off" }),
});
// index.html by name: Astro's dev server serves no directory index from public/.
const src = `/demo/${demo}/index.html?${look}`;

// Each written cell glows, hot then warm: the palette's --afterglow, put in by `recolor`
// and dimmed there by the share of cells the screen rewrites (lib/afterglow.ts).
const sequence = [...intro, frame];
const total = frame.cols * frame.rows;
const frames = sequence.map((next, i) => {
  const before = sequence[i - 1] ?? null;
  const { ansi, cells } = patch(before, next);
  const glow = [GLOW_HOT, GLOW_WARM].map((tint) => patch(before, next, tint).ansi);
  return { glow, ansi, cells };
});
const count = (cells: number) =>
  `${cells.toLocaleString("en")} of ${total.toLocaleString("en")} cells written`;
// Without the intro, the counter shows what the last frame wrote.
const lastCells = frames.at(-1)?.cells ?? 0;

// Inline JSON: `<` escaped, so no captured text can close its script element. `lines`: the
// text the live screen must show before it replaces the capture.
const stand = JSON.stringify({
  ansi: ansi(frame),
  lines: lines(frame),
  columns: frame.cols,
  rows: frame.rows,
  intro: intro.length ? frames : [],
  total,
}).replaceAll("<", "\\u003c");
---

<div
  class="live"
  data-live
  data-src={src}
  data-boot={boot}
  data-script={JSON.stringify(script)}
  data-afterglow={afterglow ? "" : undefined}
>
  <Screen frame={frame} printed={printed} poweron={intro.length > 0}>
    <div slot="live" class="layer">
      <div class="glows" data-glows aria-hidden="true"></div>
      <span class="take" data-take hidden>Live · click to use the keyboard</span>
    </div>
  </Screen>
  <p class="missed" data-missed role="status" hidden></p>
  {
    intro.length > 0 && (
      <p class="hud" aria-hidden="true">
        <span data-hud-frame>
          frame {frames.length}/{frames.length}
        </span>
        <span data-hud-cells>{count(lastCells)}</span>
      </p>
    )
  }
  <script type="application/json" data-stand set:html={stand} />
  <script is:inline>
    // Before the first paint: where the demo will run, the HTML drawing gives way to the
    // terminal that stands in for it, not to a font change a moment later.
    {
      const root = document.currentScript.parentElement;
      const narrow = matchMedia("(max-width: 760px)").matches;
      if (!narrow && navigator.connection?.saveData !== true) root.classList.add("standing");
    }
  </script>
  <p class="fallback" data-fallback hidden>
    Too narrow to run here: <a href={src}>open {demo} in its own page</a>.
  </p>
</div>

<script>
  import * as z from "zod/mini";
  import { glowWrites } from "../lib/glow";
  import { overscroll } from "../lib/overscroll";
  import { recolor, screenColours } from "../lib/recolor";
  // As the runtime sets up its terminal: the same fonts, and the largest size at which the
  // grid fits, so both draw every cell alike.
  import { FONTS, FONT_STEP, LARGEST_FONT, SMALLEST_FONT } from "../lib/cells";
  import { drawOnGpu } from "../lib/gpu";
  import { Terminal } from "@xterm/xterm";
  import { FitAddon } from "@xterm/addon-fit";
  import "@xterm/xterm/css/xterm.css";

  const Stage = z.object({ source: z.literal("luciole"), type: z.literal("stage"), stage: z.string() });
  const Script = z.array(
    z.object({
      wait: z.string(),
      type: z.string(),
      pause: z.optional(z.number()),
      timeout: z.optional(z.number()),
    }),
  );
  const Connection = z.object({ saveData: z.optional(z.boolean()) });
  const Stand = z.object({
    ansi: z.string(),
    lines: z.array(z.string()),
    columns: z.number(),
    rows: z.number(),
    intro: z.array(z.object({ glow: z.array(z.string()), ansi: z.string(), cells: z.number() })),
    total: z.number(),
  });

  const DRAWN_TIMEOUT_MS = 20_000;
  const STEP_TIMEOUT_MS = 8_000;
  /** How long the capture stays up for a live screen that does not come to match it. */
  const MATCH_TIMEOUT_MS = 8_000;
  /**
   * The share of rows that must read as the capture's: a duration measured again (Chat), a
   * date in the reader's language (mdreader) may differ, not a screen still loading.
   */
  const MATCHING_ROWS = 0.95;
  const POLL_MS = 80;
  /** Below this width a wide terminal's cells are too small to read: no start. */
  const NARROW = "(max-width: 760px)";

  /** The reader asked the browser to spare data: nothing starts by itself. */
  const saving = () => Connection.safeParse(Reflect.get(navigator, "connection")).data?.saveData === true;
  const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** How long a written cell glows, hot then warm, and how long each intro screen holds. */
  const HOT_MS = 70;
  const WARM_MS = 120;
  const HOLD_MS = 700;

  const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));


  /**
   * The terminal that stands in for the application until it has drawn: the capture,
   * written once, never focused. It stays under the application's, and shows again when
   * a gallery stops the demo.
   */
  /** Resolves once a stand-in has drawn its capture: only then may the application load. */
  const standing = new WeakMap<HTMLElement, Promise<void>>();
  /** Resolves once a stand-in has played its intro: the application shows only then. */
  const introduced = new WeakMap<HTMLElement, Promise<void>>();

  const count = (cells: number, total: number) =>
    `${cells.toLocaleString("en")} of ${total.toLocaleString("en")} cells written`;

  /** The counter under the screen, where there is one. */
  function hud(root: HTMLElement, frame: string, cells: string) {
    const frameText = root.querySelector("[data-hud-frame]");
    const cellsText = root.querySelector("[data-hud-cells]");
    if (frameText) frameText.textContent = frame;
    if (cellsText) cellsText.textContent = cells;
  }

  /**
   * The intro: the screen switches on (CSS), then each screen is written as a renderer
   * writes it, only the cells that changed, first glowing, then in their own colours.
   */
  async function introduce(root: HTMLElement, terminal: Terminal, steps: z.infer<typeof Stand>["intro"], total: number) {
    const write = (data: string) => new Promise<void>((done) => terminal.write(data, done));
    const screen = root.querySelector<HTMLElement>(".screen");
    hud(root, `frame 0/${steps.length}`, count(0, total));
    await Promise.all(screen?.getAnimations().map((animation) => animation.finished) ?? []);
    for (const [i, step] of steps.entries()) {
      hud(root, `frame ${i + 1}/${steps.length}`, count(step.cells, total));
      await write(recolor(step.glow[0] ?? "", step.cells, total));
      await sleep(HOT_MS);
      await write(recolor(step.glow[1] ?? "", step.cells, total));
      await sleep(WARM_MS);
      await write(recolor(step.ansi));
      if (i < steps.length - 1) await sleep(HOLD_MS);
    }
  }

  const standOf = (root: HTMLElement) =>
    Stand.safeParse(JSON.parse(root.querySelector("[data-stand]")?.textContent ?? "null"));

  function stand(root: HTMLElement) {
    let drawn = () => {};
    standing.set(
      root,
      new Promise<void>((resolve) => (drawn = resolve)).then(() => {
        // Told to the container too: a gallery unloads its other demos only then.
        root.dataset.stood = "";
        root.dispatchEvent(new Event("live:stood"));
      }),
    );
    const layer = root.querySelector<HTMLElement>(".layer");
    const parsed = standOf(root);
    if (!layer || !parsed.success) return;
    const { ansi, columns, rows, intro, total } = parsed.data;
    const theme = () => {
      const { background, foreground } = screenColours();
      return { background, foreground };
    };
    const holder = document.createElement("div");
    holder.className = "stand";
    holder.setAttribute("aria-hidden", "true");
    layer.prepend(holder);
    const terminal = new Terminal({
      fontFamily: FONTS,
      theme: theme(),
      disableStdin: true,
      cursorInactiveStyle: "none",
    });
    const fit = new FitAddon();
    terminal.loadAddon(fit);
    terminal.open(holder);
    // As the runtime draws: the GPU, before the font is sized, so the same cells.
    drawOnGpu(terminal);
    // The capture as the stand-in shows it, as the runtime tells its own screen
    // (`lucioleScreen`): what the landing's journey compares, the canvas saying nothing.
    const buffer = terminal.buffer.active;
    Reflect.set(holder, "lucioleScreen", () =>
      Array.from({ length: terminal.rows }, (_, y) => buffer.getLine(buffer.viewportY + y)?.translateToString(true) ?? ""),
    );
    let written = false;
    const layout = () => {
      // A hidden gallery panel has no size yet: laid out, then written, once it is shown,
      // at its grid; written earlier, the capture would be cut to xterm's 80x24.
      if (!holder.clientWidth) return;
      // As the runtime (fitGrid): the largest size on FONT_STEP steps at which the grid
      // fits, by bisection; the same size, so the same cells.
      const fits = (size: number) => {
        terminal.options.fontSize = size;
        const room = fit.proposeDimensions();
        return room !== undefined && room.cols >= columns && room.rows >= rows;
      };
      let low = 0;
      let high = (LARGEST_FONT - SMALLEST_FONT) / FONT_STEP;
      while (low < high) {
        const middle = Math.ceil((low + high) / 2);
        if (fits(SMALLEST_FONT + middle * FONT_STEP)) low = middle;
        else high = middle - 1;
      }
      terminal.options.fontSize = SMALLEST_FONT + low * FONT_STEP;
      terminal.resize(columns, rows);
      if (written) return;
      written = true;
      if (intro.length && !still()) {
        // Blank until the intro draws it; the application may load meanwhile.
        requestAnimationFrame(() => drawn());
        introduced.set(root, introduce(root, terminal, intro, total));
        return;
      }
      // Written, then painted: the next frame shows it.
      terminal.write(recolor(ansi), () => requestAnimationFrame(() => drawn()));
    };
    layout();
    new ResizeObserver(layout).observe(holder);
    // Another palette: the stand-in takes its screen colours and draws the capture again.
    // A running application keeps the ones it started with.
    document.addEventListener("palette", async () => {
      await introduced.get(root);
      terminal.options.theme = theme();
      if (written) terminal.write(recolor(ansi));
    });
  }

  const Lines = z.array(z.string());
  /**
   * The live screen's rows as text: from the runtime's buffer (docs/WEB.md, "Page
   * embarquée", `lucioleScreen`), which a frame out of view keeps up to date. The DOM says
   * nothing of it: the runtime draws in a canvas. None until the runtime runs.
   */
  const rowsOf = (frame: HTMLIFrameElement) => {
    const read: unknown = frame.contentWindow ? Reflect.get(frame.contentWindow, "lucioleScreen") : undefined;
    const value: unknown = typeof read === "function" ? Reflect.apply(read, frame.contentWindow, []) : undefined;
    const lines = value === undefined ? undefined : Lines.safeParse(value);
    return lines?.success ? lines.data.map((line) => line.trimEnd()) : [];
  };
  const screenOf = (frame: HTMLIFrameElement) => rowsOf(frame).join("\n");

  /**
   * Waits until the live screen reads as the capture, twice in a row: the application may
   * show the text a script waits for, or draw its first frame, before the rest of its
   * screen has come (a description streamed later, a list read from the Server). Returns
   * the rows that still differ when it gives up, none once it matches.
   */
  async function settle(frame: HTMLIFrameElement, capture: string[], signal: AbortSignal) {
    const deadline = performance.now() + MATCH_TIMEOUT_MS;
    const allowed = Math.floor(capture.length * (1 - MATCHING_ROWS));
    let previous = "";
    for (;;) {
      const rows = rowsOf(frame);
      const differing = capture.flatMap((line, i) => (rows[i] === line ? [] : [i]));
      const screen = rows.join("\n");
      if (differing.length <= allowed && screen === previous) return [];
      if (signal.aborted || performance.now() > deadline)
        return differing.map((i) => ({ row: i, capture: capture[i], live: rows[i] }));
      previous = screen;
      await sleep(POLL_MS);
    }
  }

  type Step = z.infer<typeof Script>[number];

  /**
   * Plays `steps` in order. When the screen shows a later step's text and not the current
   * one's, the steps between are skipped: a restored session may start past the sign-in.
   * Stops when the demo stops, or when nothing it waits for shows in time: then returns
   * the step it waited on, whose keys were never typed.
   */
  async function play(frame: HTMLIFrameElement, steps: Step[], signal: AbortSignal) {
    let next = 0;
    while (next < steps.length) {
      const deadline = performance.now() + (steps[next]?.timeout ?? STEP_TIMEOUT_MS);
      let found = -1;
      while (found < 0) {
        if (signal.aborted) return;
        if (performance.now() > deadline) return steps[next];
        const screen = screenOf(frame);
        // The current step first: two in a row may wait for the same screen.
        found = screen.includes(steps[next]?.wait ?? "")
          ? next
          : steps.findLastIndex((step, i) => i > next && screen.includes(step.wait));
        if (found < 0) await sleep(POLL_MS);
      }
      const step = steps[found];
      if (step?.type) type(frame, step.type);
      if (step?.pause) await sleep(step.pause);
      next = found + 1;
    }
  }

  /**
   * The live application's wheel and what it rewrites. Held, the wheel goes to the app
   * while it has something to scroll under the pointer, and on to the page once it has not
   * (lib/overscroll.ts). With the afterglow, each cell it rewrites glows a moment, as in
   * the intro (lib/glow.ts), and the counter under the screen says how many cells each
   * change wrote.
   */
  function watch(root: HTMLElement, frame: HTMLIFrameElement, signal: AbortSignal) {
    const layer = root.querySelector<HTMLElement>("[data-glows]");
    const stand = standOf(root).data;
    if (!layer || !stand) return;
    const { columns, rows, total } = stand;
    const glowing = root.dataset.afterglow !== undefined && !still();
    if (glowing) hud(root, "live", count(0, total));
    overscroll({ frame, signal });
    glowWrites({
      frame,
      layer: glowing ? layer : document.createElement("div"),
      columns,
      rows,
      signal,
      onWritten: (cells) => {
        if (glowing) hud(root, "live", count(cells, total));
      },
    });
  }

  const type = (frame: HTMLIFrameElement, data: string) =>
    frame.contentWindow?.postMessage({ source: "luciole", type: "input", data }, location.origin);

  /** How to stop each started demo: its frame removed, its capture back. */
  const stops = new WeakMap<HTMLElement, () => void>();

  function start(root: HTMLElement) {
    const layer = root.querySelector<HTMLElement>(".layer");
    const take = root.querySelector<HTMLElement>("[data-take]");
    const missed = root.querySelector<HTMLElement>("[data-missed]");
    if (!layer || !take || !missed || stops.has(root)) return;
    const alive = new AbortController();
    const { signal } = alive;
    // A same-origin frame shares this thread: its start would hold the stand-in's paint.
    const ready = standing.get(root) ?? Promise.resolve();
    const script = Script.safeParse(JSON.parse(root.dataset.script ?? "[]"));
    const capture = standOf(root).data?.lines ?? [];

    const frame = document.createElement("iframe");
    frame.title = "A luciole application running in this page";
    // The screen's colours of the palette in use, as the stand-in took them.
    const src = new URL(root.dataset.src ?? "", location.href);
    const { background, foreground } = screenColours();
    src.searchParams.set("background", background.slice(1));
    src.searchParams.set("foreground", foreground.slice(1));
    frame.src = src.href;
    frame.allow = "clipboard-write";
    frame.tabIndex = -1;
    void ready.then(() => signal.aborted || layer.insertBefore(frame, take));

    let drawn = false;
    const reveal = async () => {
      await introduced.get(root);
      if (signal.aborted) return;
      root.classList.add("on");
      watch(root, frame, signal);
      take.hidden = false;
      layer.setAttribute("role", "button");
      layer.setAttribute("aria-label", "Use the live application with the keyboard");
      layer.tabIndex = 0;
      // Asked for the keyboard before it was ready (live:take): it gets it now.
      if (root.dataset.want !== undefined) {
        delete root.dataset.want;
        hold(true);
      }
    };
    const stop = () => {
      alive.abort();
      stops.delete(root);
      frame.remove();
      root.classList.remove("on", "held");
      take.hidden = true;
      missed.hidden = true;
      layer.removeAttribute("role");
      layer.removeAttribute("aria-label");
      layer.removeAttribute("tabindex");
    };
    stops.set(root, stop);
    setTimeout(() => drawn || stop(), DRAWN_TIMEOUT_MS);

    addEventListener(
      "message",
      async (event) => {
        if (event.source !== frame.contentWindow || event.origin !== location.origin) return;
        const message = Stage.safeParse(event.data);
        if (!message.success) return;
        if (message.data.stage !== "drawn") return;
        drawn = true;
        const stuck = await play(frame, script.success ? script.data : [], signal);
        // The script stopped half way: the application is shown as it is, and the reader
        // told what the page did not do, rather than left before a capture it never reaches.
        if (stuck) {
          if (signal.aborted) return;
          missed.textContent = `The scripted walk-through stopped: “${stuck.wait}” did not show in time. The app is live as it is: click it to go on.`;
          missed.hidden = false;
          await reveal();
          return;
        }
        const differing = await settle(frame, capture, signal);
        // Shown anyway, the application being the point; the capture is then out of date
        // (scripts/capture.py) or the script no longer reaches its screen.
        if (import.meta.env.DEV && differing.length && !signal.aborted)
          console.warn(`${root.dataset.src} does not show its capture:`, differing);
        await reveal();
      },
      { signal },
    );

    // The reader takes the keyboard; a click anywhere else gives the page back.
    const keyboard = () => {
      frame.focus();
      frame.contentDocument?.querySelector<HTMLElement>(".xterm-helper-textarea")?.focus();
    };
    const hold = (held: boolean) => {
      root.classList.toggle("held", held);
      take.hidden = held || !root.classList.contains("on");
      frame.tabIndex = held ? 0 : -1;
      if (held) keyboard();
    };
    // Held, the screen's own focus belongs to the terminal: keys typed there must not fall
    // on the wrapper.
    layer.addEventListener("focus", () => root.classList.contains("held") && keyboard(), {
      signal,
    });
    // A button of the page gives it the keyboard (live:take): at once once it is live.
    root.addEventListener(
      "live:take",
      () => root.classList.contains("on") && !root.classList.contains("held") && hold(true),
      { signal },
    );
    // The whole screen takes the keyboard: a hint in a corner is easy to miss on 40 rows.
    const takeIfLive = () =>
      root.classList.contains("on") && !root.classList.contains("held") && hold(true);
    layer.addEventListener("click", takeIfLive, { signal });
    layer.addEventListener(
      "keydown",
      (event) => {
        if (event.target !== layer || (event.key !== "Enter" && event.key !== " ")) return;
        event.preventDefault();
        takeIfLive();
      },
      { signal },
    );
    document.addEventListener(
      "pointerdown",
      (event) => {
        if (event.target instanceof Node && !root.contains(event.target)) hold(false);
      },
      { signal },
    );
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-live]")) {
    if (matchMedia(NARROW).matches || saving()) {
      root.classList.remove("standing");
      root.querySelector<HTMLElement>("[data-fallback]")?.removeAttribute("hidden");
      continue;
    }
    stand(root);
    // `manual`: a gallery starts and stops its demos as the reader picks one.
    root.addEventListener("live:start", () => start(root));
    root.addEventListener("live:stop", () => stops.get(root)?.());
    // `live:take`: started if it is not, and handed the keyboard once live.
    root.addEventListener("live:take", () => {
      if (!root.classList.contains("on")) root.dataset.want = "";
      start(root);
    });
    if (root.dataset.boot === "manual") continue;
    if (root.dataset.boot === "eager") {
      start(root);
      continue;
    }
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        start(root);
      },
      { rootMargin: "400px 0px" },
    );
    near.observe(root);
  }
</script>

<style>
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .layer :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--screen);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .on .layer :global(iframe) {
    opacity: 1;
  }

  /* Live and not held: the screen is one button; the wheel still scrolls the page. The
     frame inherits pointer-events: it must not take the click, or the page never hears
     that the reader took the keyboard. */
  .on .layer {
    pointer-events: auto;
    cursor: pointer;
  }

  .on:not(.held) .layer :global(iframe) {
    pointer-events: none;
  }

  .held .layer {
    cursor: auto;
  }

  .held .layer :global(iframe) {
    pointer-events: auto;
  }

  /* Where a demo runs, the HTML drawing keeps the window's size; terminals draw in it. */
  .standing :global(.grid) {
    visibility: hidden;
  }

  /* As the runtime's page lays out #luciole: the same box, so the same cells. Created by
     the script: outside the component's scoped styles. */
  .layer :global(.stand) {
    position: absolute;
    inset: 0;
    padding: 8px;
    box-sizing: border-box;
    background: var(--screen);
    pointer-events: none;
  }

  /* Over the application: the cells it just rewrote, glowing out. Drawn by the script. */
  .glows {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .glows :global(i) {
