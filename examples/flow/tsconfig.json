{
  "extends": "@luciole-sh/core/tsconfig",
  // Workspace packages export their sources under the `bun` condition, as Bun resolves
  // them at run and build time; TypeScript needs to be told.
  "compilerOptions": { "customConditions": ["bun"] },
  "include": ["app", "components", "actions", "server"],
  "exclude": ["**/node_modules", "**/.luciole"]
}
