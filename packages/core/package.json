    "./sandbox": {
      "types": "./dts/packages/core/src/sandbox/index.d.ts",
      "bun": "./src/sandbox/index.ts",
      "default": "./src/sandbox/index.ts"
    },
    "./metadata": {
      "types": "./dts/packages/core/src/app-metadata.d.ts",
      "bun": "./src/app-metadata.ts",
      "default": "./src/app-metadata.ts"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./grammars": {
      "types": "./dts/packages/core/src/grammars.d.ts",
      "bun": "./src/grammars.ts",
      "default": "./src/grammars.ts"
    },
    "./math": {
      "types": "./dts/packages/core/src/math.d.ts",
      "bun": "./src/math.ts",
      "default": "./src/math.ts"
    },
    "./package.json": "./package.json"
  },
