{
  "name": "@luciole-sh/core",
  "version": "0.5.1",
  "private": false,
  "description": "luciole: React Server Components for the terminal. The framework, its luciole and luciolex CLIs, and its runtime.",
  "keywords": [
    "luciole",
    "tui",
    "terminal",
    "react",
    "rsc",
    "server-components",
    "opentui",
    "framework"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sykar-f/luciole.git",
    "directory": "packages/core"
  },
  "homepage": "https://luciole.sh",
  "engines": {
    "bun": ">=1.4.1"
  },
  "type": "module",
  "files": [
    "src",
    "docs",
    "skills",
    "agents-block.md",
    "web",
    "native/luciole-sandbox/dist",
    "native/luciole-pty/dist",
    "tsconfig.base.json",
    "types.d.ts",
    "dts"
  ],
  "bin": {
    "luciole": "./src/cli.ts",
    "luciolex": "./src/luciolex.ts"
  },
  "scripts": {
    "prepack": "bun scripts/declarations.ts && cd ../.. && bun scripts/pack-docs.ts",
    "postpack": "bun scripts/declarations.ts --clean"
  },
  "exports": {
    "./client": {
      "types": "./dts/packages/core/src/client.d.ts",
      "bun": "./src/client.tsx",
      "default": "./src/client.tsx"
    },
    "./server": {
      "types": "./dts/packages/core/src/server.d.ts",
      "bun": "./src/server.ts",
      "default": "./src/server.ts"
