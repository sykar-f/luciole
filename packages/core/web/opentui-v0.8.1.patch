--- /dev/null
+++ b/packages/native/src/wasm-video.zig
@@ -0,0 +1,35 @@
+//! Video needs decoder and device worker threads, which the browser port does not supply.
+//! Preserve the node and ABI, but reject opening a player explicitly.
+const std = @import("std");
+const video = @import("video.zig");
+const image = @import("image.zig");
+pub const Player = struct {
+    video: struct {
+        info: video.Info = .{},
+        published: u64 = 0,
+        pub fn observeOutput(_: *@This(), _: u64, _: u32) void {}
+    } = .{},
+    quality: struct {
+        pub fn scale(_: @This()) f64 { return 1; }
+    } = .{},
+    cost_frame: ?u64 = null,
+    pub fn open(_: std.mem.Allocator, _: []const u8, _: bool, detail: []u8) error{UnsupportedResource}!*Player {
+        const message = "Video has no browser backend";
+        @memcpy(detail[0..message.len], message);
+        detail[message.len] = 0;
+        return error.UnsupportedResource;
+    }
+    pub fn deinit(_: *Player) void {}
+    pub fn snapshot(_: *Player) video.PlayerState { return std.mem.zeroes(video.PlayerState); }
+    pub fn play(_: *Player) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn pause(_: *Player) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn seek(_: *Player, _: i64) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn setLoop(_: *Player, _: bool) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn setMuted(_: *Player, _: bool) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn setVolume(_: *Player, _: f32) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn setAvSyncOffset(_: *Player, _: i64) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn setMaxFps(_: *Player, _: u32) error{UnsupportedResource}!void { return error.UnsupportedResource; }
+    pub fn observeFrameCost(_: *Player, _: u64, _: u32) void {}
+    pub fn frame(_: *Player, _: u32, _: u32, _: bool, _: ?image.Region) ?*image.Image { return null; }
+    pub fn lastError(_: *const Player) []const u8 { return "Video has no browser backend"; }
+};
