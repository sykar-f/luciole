diff --git a/packages/native/src/wasm-host.zig b/packages/native/src/wasm-host.zig
new file mode 100644
index 0000000..d111a5a
--- /dev/null
+++ b/packages/native/src/wasm-host.zig
@@ -0,0 +1,12 @@
+//! What a WebAssembly host needs beyond OpenTUI's own exports: memory it can copy
+//! JavaScript buffers into before a call (the host has no address for its own memory).
+const std = @import("std");
+
+export fn opentuiWasmAlloc(len: usize) ?[*]u8 {
+    const p = std.c.malloc(if (len == 0) 1 else len) orelse return null;
+    return @ptrCast(p);
+}
+
+export fn opentuiWasmFree(ptr: ?[*]u8) void {
+    std.c.free(ptr);
+}
