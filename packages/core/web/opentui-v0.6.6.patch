+//! Audio in a browser: no sound device. context.zig keeps the object kind; creating one fails.
+const std = @import("std");
+
+pub const audio = struct {
+    pub const Engine = opaque {};
+    pub const CreateOptions = extern struct { reserved: u32 };
+    pub fn create(_: std.mem.Allocator, _: ?*const CreateOptions) ?*Engine {
+        return null;
+    }
+    pub fn destroy(_: *Engine) void {}
+};
