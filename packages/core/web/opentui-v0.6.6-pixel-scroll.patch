+    const status = sessionContextStatus(context);
+    if (status != c.OT_OK) return status;
+    const owner = context.?;
+    const id = session_ptr orelse return sessionError(owner, error.InvalidOptions);
+    if (flags > 3) return sessionError(owner, error.InvalidOptions);
+    owner.core.sessionSetFrameSync(handleFromC(id.*), flags & 1 != 0, flags & 2 != 0) catch |err| return sessionError(owner, err);
+    return c.OT_OK;
