+test "Pixel frame sync flags leave one host envelope and reset for ordinary frames" {
+    const f = try Fixture.init(testing.allocator, 4, 1, .{});
+    defer f.deinit();
+    for ([_]bool{ true, false }) |external| {
+        try f.owner.sessionSetFrameSync(f.id, external, false);
+        try @import("scene_fixture_test.zig").repaint(f.owner, f.id, options.background, true, 0);
+        _ = try @import("scene_fixture_test.zig").present(f.owner, f.id, true);
+        var bytes: [4096]u8 = undefined;
+        var count: usize = 0;
+        while (try f.owner.readOutput(f.id, bytes[count..])) |ticket| {
+            count += ticket.len;
+            try f.owner.completeOutput(f.id, ticket, .written);
+        }
+        try testing.expectEqual(!external, std.mem.indexOf(u8, bytes[0..count], "\x1b[?2026h") != null);
+        try testing.expectEqual(!external, std.mem.indexOf(u8, bytes[0..count], "\x1b[?2026l") != null);
+    }
+}
