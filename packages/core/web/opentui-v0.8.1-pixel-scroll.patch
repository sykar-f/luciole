+test "Pixel hit copy separates published draft and drop maps and rejects stale nodes" {
+    const f = try Fixture.init(testing.allocator, 4, 2, .{});
+    defer f.deinit();
+    const under = try f.owner.sceneCreateNode(f.id, 1, 7);
+    try f.owner.sceneSetStyle(under, 4, 0, 0, 1, 4, 1);
+    try f.owner.sceneSetStyle(under, 4, 1, 0, 1, 2, 1);
+    try f.owner.sceneMoveNode(under, f.root, 0);
+    const child = try f.owner.sceneCreateNode(f.id, 1, 42);
+    try f.owner.sceneSetStyle(child, 4, 0, 0, 1, 2, 1);
+    try f.owner.sceneSetStyle(child, 4, 1, 0, 1, 1, 1);
+    try f.owner.sceneMoveNode(child, under, 0);
+    var published: [8]u32 = undefined;
+    var draft: [8]u32 = undefined;
+    var drop: [8]u32 = undefined;
+    try @import("scene_fixture_test.zig").repaint(f.owner, f.id, options.background, true, 42);
+    try f.owner.sceneCopyHits(f.id, 0, &published);
+    try f.owner.sceneCopyHits(f.id, 1, &draft);
+    try f.owner.sceneCopyHits(f.id, 3, &drop);
+    try testing.expectEqual(@as(u32, 0), published[0]);
+    try testing.expectEqual(@as(u32, 42), draft[0]);
+    try testing.expectEqual(@as(u32, 7), drop[0]);
+    try testing.expectError(error.InvalidOptions, f.owner.sceneCopyHits(f.id, 1, draft[0..7]));
+    try testing.expectError(error.InvalidOptions, f.owner.sceneCopyHits(f.id, 4, &draft));
+    _ = try @import("scene_fixture_test.zig").present(f.owner, f.id, true);
+    try drain(f.owner, f.id);
+    try f.owner.sceneCopyHits(f.id, 0, &published);
+    try testing.expectEqualSlices(u32, &draft, &published);
+    // Native direct callers retain capture exclusion; sceneCopyHits exposes the full JS snapshot.
+    try testing.expectEqual(@as(u32, 7), try f.owner.sceneHitTest(f.id, 0, 0));
+    try f.owner.sceneSetPaint(child, .{ .translateX = 1 });
+    try @import("scene_fixture_test.zig").repaint(f.owner, f.id, options.background, true, 0);
+    try f.owner.sceneCopyHits(f.id, 1, &draft);
+    try testing.expectEqual(@as(u32, 7), draft[0]);
+    try testing.expectEqual(@as(u32, 42), draft[1]);
+    try f.owner.sessionSetFrameSync(f.id, true, true);
+    _ = try @import("scene_fixture_test.zig").present(f.owner, f.id, true);
+    try drain(f.owner, f.id);
+    try f.owner.sceneCopyHits(f.id, 0, &draft);
+    try testing.expectEqualSlices(u32, &published, &draft);
+    try f.owner.sceneCopyHits(f.id, 2, &drop);
+    try testing.expectEqual(@as(u32, 7), drop[0]);
+    try @import("scene_fixture_test.zig").repaint(f.owner, f.id, options.background, true, 0);
+    try f.owner.sceneFrameCancel(f.id, f.state.painted.?.ticket.frame_id);
