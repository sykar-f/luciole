+    await session.beginFrameOutput()
+    expect(session.write(bytes("discarded"))).toBe(true)
+    const control = session.writeControl(bytes("first"))
+    await session.endFrameOutput(false)
+    const frame = session.beginFrameOutput()
+    await control
+    await frame
+    expect(session.write(bytes("frame"))).toBe(true)
+    const after = session.writeControl(bytes("last"))
+    await session.endFrameOutput(true)
+    await after
+    expect(Buffer.concat(chunks).toString()).toBe("firstframelast")
+    await session.close()
+    await expect(session.writeControl(bytes("closed"))).rejects.toThrow()
