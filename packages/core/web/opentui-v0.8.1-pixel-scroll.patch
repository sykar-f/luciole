+    const stdout = createTestStdout(8, 2)
+    const chunks: Buffer[] = []
+    stdout._write = (chunk, _encoding, done) => {
+      chunks.push(Buffer.from(chunk))
+      done()
+    }
+    const f = await createTestRenderer({ width: 8, height: 2, stdout, bufferedOutput: "stdout", synchronizedOutput })
+    try {
+      f.renderer.root.add(new TextRenderable(f.renderer, { content: "POLICY", width: 8, height: 1 }))
+      f.renderer.setFramePlan(() => ({ before: bytes("before"), after: bytes("after") }))
+      await f.renderOnce()
+      await f.renderer.idle()
+      const wire = Buffer.concat(chunks).toString()
+      expect(wire).toContain("before")
+      expect(wire).toContain("after")
+      expect(wire.split(start)).toHaveLength(synchronizedOutput === "never" ? 1 : 2)
+      expect(wire.split(end)).toHaveLength(synchronizedOutput === "never" ? 1 : 2)
+    } finally {
+      await f.dispose()
+    }
+  })
+}
