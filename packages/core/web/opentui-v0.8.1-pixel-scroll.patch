+test("Pixel staging collects the stdout writer copy before taking output ownership", async () => {
+  await withStdoutWriter([20], 100, async (driver, scheduler, posts, counts) => {
+    expect(driver.write(new TextEncoder().encode("earlier"))).toBe(true)
+    await scheduler.run(0)
+    expect(counts.copies).toBe(1)
+    let acquired = false
+    const frame = driver.beginFrameOutput().then(() => {
+      acquired = true
+    })
+    await scheduler.run(10)
+    expect(acquired).toBe(false)
+    for (let ms = 11; ms <= 25; ms++) await scheduler.run(ms)
+    await frame
+    expect(acquired).toBe(true)
+    const before = posts.length
+    const drains = counts.drains
+    expect(driver.write(new TextEncoder().encode("staged"))).toBe(true)
+    const idle = driver.idle()
+    await scheduler.run(26)
+    await idle
+    expect(posts).toHaveLength(before)
+    expect(counts.drains).toBe(drains)
+    const ending = driver.endFrameOutput(false)
+    await scheduler.run(27)
+    await ending
+    const control = driver.writeControl(new TextEncoder().encode("after"))
+    for (let ms = 28; ms <= 32; ms++) await scheduler.run(ms)
+    await control
+    expect(posts).toHaveLength(before)
+    expect(counts.drains).toBe(drains)
+  })
+})
