+for (const segment of [1, 2]) {
+  test(`a dropped planned segment ${segment} discards every byte and resets sync`, async () => {
+    const { r, renderOnce, chunks, dispose } = await setup()
+    const content = new TextRenderable(r, { content: "CANONICAL", width: 12, height: 2 })
+    r.root.add(content)
+    await renderOnce()
+    chunks.length = 0
+    const target = r as unknown as { presentNativeScene(): Promise<"rendered" | "dropped"> }
+    const present = target.presentNativeScene.bind(r)
+    let calls = 0
+    const dropped = spyOn(target, "presentNativeScene").mockImplementation(() =>
+      ++calls === segment ? Promise.resolve("dropped") : present(),
+    )
+    try {
+      r.setFramePlan(() => ({
+        before: bytes("DISCARDED"),
+        projection: { renderable: content, translateX: 0, translateY: -1 },
+      }))
+      await renderOnce()
+      await r.idle()
+      expect(calls).toBe(segment)
+      expect(chunks).toEqual([])
+      expect(r.isFramePlanPass).toBe(false)
