+test("precise row deltas bypass acceleration and bubble only the remainder; chain ownership rounds the previous surface", async () => {
+  const { r, parent, child, outer, inner } = await scrollScene()
+  try {
+    let ticks = 0
+    for (const box of [parent, child])
+      box.scrollAcceleration = {
+        tick() {
+          ticks++
+          return 100
+        },
+        reset() {},
+      }
+    const precise = (delta: number) => {
+      const attributes: RawMouseEvent & { scroll: NonNullable<RawMouseEvent["scroll"]> & { precise: true } } = {
+        ...input("scroll"),
+        scroll: { direction: delta < 0 ? "up" : "down", delta: Math.abs(delta), precise: true },
+      }
+      const event = new MouseEvent(child, attributes)
+      child.processMouseEvent(event)
+      return event
+    }
+    precise(0.375)
+    expect(inner.position).toBe(0.375)
+    expect(outer.position).toBe(0)
+    outer.set(1.625)
+    expect(inner.position).toBe(0)
+    precise(0.25)
+    expect(outer.position).toBe(2)
+    expect(inner.position).toBe(0.25)
+    inner.set(inner.max - 0.25)
+    precise(0.625)
+    expect(inner.position).toBe(inner.max)
+    expect(outer.position).toBe(2.375)
+    precise(0.25)
+    expect(inner.position).toBe(inner.max)
+    expect(outer.position).toBe(2.625)
+    precise(-0.5)
+    expect(outer.position).toBe(3)
+    expect(inner.position).toBe(inner.max - 0.5)
+    expect(ticks).toBe(0)
+    inner.set(0)
+    outer.set(1.625)
+    precise(1)
+    expect(outer.position).toBe(2)
+    expect(inner.position).toBe(1)
+    inner.set(0)
+    outer.set(0)
+    const exhausted = precise(-0.25)
+    expect(exhausted.propagationStopped).toBe(false)
+    expect(exhausted.scroll?.delta).toBe(0.25)
+    expect(inner.scroll(-0.5)).toBe(-0.5)
+    // Existing discrete wheel keeps the configured acceleration and integer origin.
+    child.processMouseEvent(new MouseEvent(child, input("scroll")))
+    expect(ticks).toBeGreaterThan(0)
+    expect(Number.isInteger(child.scrollTop)).toBe(true)
+    expect(inner.position).toBe(inner.origin)
+  } finally {
+    r.destroy()
+    await r.closed
+  }
+})
+
+test("projected nested culled ScrollBoxes retain fixed chrome, canonical input and verified repaint", async () => {
+  const f = await setup(30, 16)
+  const { r, renderOnce } = f
+  const { ScrollBoxRenderable } = await import("../renderables/ScrollBox.js")
+  const outer = new ScrollBoxRenderable(r, { width: 24, height: 12, viewportCulling: true })
+  const inner = new ScrollBoxRenderable(r, { width: 18, height: 6, flexShrink: 0, viewportCulling: true })
+  const rows = Array.from(
+    { length: 20 },
+    (_, i) => new TextRenderable(r, { content: `ROW ${i}`, height: 1, flexShrink: 0 }),
+  )
+  for (const row of rows) inner.add(row)
+  outer.add(inner)
+  outer.add(new TextRenderable(r, { content: "tail", height: 20, flexShrink: 0 }))
+  r.root.add(outer)
+  const errors: string[] = []
+  r.on(CliRenderEvents.ERROR, (e: CliRendererErrorEvent) => errors.push(e.error.message))
+  try {
+    await renderOnce()
+    await renderOnce()
+    inner.scrollableViewport.set(1.625)
+    await renderOnce()
+    const canonical = {
+      x: inner.x,
+      y: inner.y,
+      contentY: inner.content.y,
+      viewport: { ...inner.scrollableViewport.rect },
+    }
+    let main!: RenderHitMap
+    let projected!: RenderHitMap
+    let clicks = 0
+    rows[2]!.onMouseDown = () => clicks++
+    r.setFramePlan(() => ({
+      onHitMap: (map) => {
+        main = map
+      },
+      projection: {
+        ...inner.scrollableViewport.project(2),
+        onHitMap: (map) => {
+          projected = map
+        },
+      },
+    }))
+    await renderOnce()
+    await r.idle()
+    const { x, y, width, height } = canonical.viewport
+    expect(main.hitTest(x, y)).toBe(rows[1]!.num)
+    expect(projected.hitTest(x, y)).toBe(rows[2]!.num)
+    expect(projected.origin(rows[2]!.num)).toEqual({ x, y })
+    expect(projected.origin(inner.num)).toEqual({ x: canonical.x, y: canonical.y })
+    expect(projected.hitTest(inner.verticalScrollBar.x, inner.verticalScrollBar.y)).toBe(inner.num)
+    expect(projected.hitTest(x, y + height)).not.toBe(rows[2]!.num)
+    expect(projected.hitTest(x + width, y)).toBe(inner.num)
+    expect(r.hitTest(x, y)).toBe(rows[1]!.num)
+    r.dispatchMouseEventFromHitMap(input("down", x, y), projected)
+    expect(clicks).toBe(1)
+    expect(inner.scrollableViewport.position).toBe(1.625)
+    expect(inner.scrollTop).toBe(1)
+    expect(inner.content.y).toBe(canonical.contentY)
+    expect(inner.scrollableViewport.rect).toEqual(canonical.viewport)
+    // Repeat the pair, then restore canonical retained and banded repaint paths.
+    await renderOnce()
+    r.setFramePlan(null)
+    await renderOnce()
+    await renderOnce()
+    rows[2]!.content = "changed"
+    await renderOnce()
+    expect(r.hitTest(x, y)).toBe(rows[1]!.num)
+    // Project an ancestor so the nested viewport and newly visible descendants move together.
+    r.setFramePlan(() => ({
+      projection: {
+        ...outer.scrollableViewport.project(2),
+        onHitMap: (map) => {
+          projected = map
+        },
+      },
+    }))
+    await renderOnce()
+    expect(projected.origin(inner.num)?.y).toBe(canonical.y - 2)
+    expect(outer.scrollTop).toBe(0)
+    r.setFramePlan(null)
+    await renderOnce()
+    await renderOnce()
+    expect(inner.y).toBe(canonical.y)
+    expect(errors).toEqual([])
+  } finally {
+    await f.dispose()
+  }
+})
