+  r.root.add(view)
+  view.add(content)
+  rows.forEach((row) => content.add(row))
+  let normal: RenderHitMap | undefined, projected: RenderHitMap | undefined
+  let logicalPasses = 0
+  r.setFramePlan(() => {
