+test("control writes wait for every split frame chunk and retry admission pressure", async () => {
+  const chunks: Buffer[] = []
+  let resume!: () => void
+  let reached!: () => void
+  const firstChunk = new Promise<void>((resolve) => {
+    reached = resolve
+  })
+  let held = false
+  const sink = new Writable({
+    highWaterMark: 1,
+    write(chunk, _encoding, done) {
+      chunks.push(Buffer.from(chunk))
+      if (!held) {
+        held = true
+        resume = () => {
+          resume = () => {}
+          done()
+        }
+        reached()
+      } else setImmediate(done)
+    },
+  })
+  const session = new NativeSession(sink, {
+    output: { chunkSize: 256, spanCapacity: 32, maxBytes: 8192n, controlCapacity: 128 },
+    outputBufferSize: 17,
+  })
+  const accept = session.write.bind(session)
+  let attempts = 0
+  const admission = spyOn(session, "write").mockImplementation((batch) =>
+    ++attempts === 2 || attempts === 5 ? false : accept(batch),
+  )
+  try {
+    const limit = Number(session.maxAtomicWriteBytes)
+    const parts = ["\x1b[?2026h", "A".repeat(limit), "B".repeat(limit), "\x1b[?2026l"]
+    await session.beginFrameOutput()
+    // Staging uses ordinary admission; drain each part so the frame exceeds the queue.
+    for (const part of parts) {
+      while (!session.write(bytes(part))) await session.idle()
+      await session.idle()
+    }
+    // Force the rejection inside the commit drain, not while staging.
+    attempts = 0
+    const frame = session.endFrameOutput(true)
+    await firstChunk
+    const command = Buffer.from("CONTROL".repeat(limit))
+    const expected = new TextDecoder().decode(command)
+    const control = session.writeControl(command)
+    command.fill(0)
+    const next = session.writeControl(bytes("NEXT"))
+    expect(chunks.every((chunk) => !chunk.includes("CONTROL"))).toBe(true)
+    resume()
+    await Promise.all([frame, control, next])
+    expect(Buffer.concat(chunks).toString()).toBe(parts.join("") + expected + "NEXT")
+    expect(attempts).toBeGreaterThan(3)
+  } finally {
+    admission.mockRestore()
+    resume?.()
+    await session.close()
+    sink.destroy()
+  }
+})
