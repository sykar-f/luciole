{
  "name": "airtty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "airtty": "./src/cli.ts",
    "airttyx": "./src/airttyx.ts"
  },
  "exports": {
    "./client": "./src/client.tsx",
    "./server": "./src/server.ts",
    "./route-tree": "./src/route-tree.tsx",
    "./build": "./src/build.ts",
    "./tsconfig": "./tsconfig.base.json"
  },
  "scripts": {
    "test": "bun test --timeout 20000",
    "probes": "cd probes/rsc && bun install --frozen-lockfile && bun probe.tsx && cd ../rpc && bun install --frozen-lockfile && bun probe.tsx",
    "build": "bun src/cli.ts build",
    "dev": "bun src/cli.ts dev",
    "forge": "FORGE_GIT_REPO=. bun src/cli.ts dev --app examples/forge",
    "forge:operator": "bun examples/forge/scripts/operator.ts",
    "files": "bun src/cli.ts dev --app examples/files",
    "mdreader": "bun src/cli.ts dev --app examples/mdreader",
    "chat": "bun src/cli.ts dev --app examples/chat",
    "agent": "bun src/cli.ts dev --app examples/agent",
    "check": "tsc --noEmit && tsc --noEmit -p examples/notes && tsc --noEmit -p examples/latency && tsc --noEmit -p examples/forge && tsc --noEmit -p examples/files && tsc --noEmit -p examples/mdreader && tsc --noEmit -p examples/chat && tsc --noEmit -p examples/agent",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:pty": "python3 scripts/pty-smoke.py",
    "test:pty:forge": "python3 scripts/pty-forge.py",
    "test:pty:restore": "python3 scripts/pty-restore.py",
    "test:pty:files": "python3 scripts/pty-files.py",
    "test:pty:mdreader": "python3 scripts/pty-mdreader.py",
    "test:pty:chat": "python3 scripts/pty-chat.py",
    "test:pty:agent": "python3 scripts/pty-agent.py",
    "test:linux": "bun scripts/linux-client.ts",
    "verify": "bun run check && bun run lint && bun run format:check && bun test --timeout 20000 && bun run build",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/react": "0.5.12",
    "@tanstack/react-router": "1.170.38",
    "@typescript/typescript6": "6.0.2",
    "marked": "17.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-reconciler": "0.33.0",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tanstack/react-form": "1.33.5",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002"
  }
}
