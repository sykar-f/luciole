{
  "name": "@terminal/framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "terminal": "./src/cli.ts"
  },
  "exports": {
    "./client": "./src/client.tsx",
    "./server": "./src/server.ts",
    "./build": "./src/build.ts",
    "./tsconfig": "./tsconfig.base.json"
  },
  "scripts": {
    "test": "bun test --timeout 20000",
    "probes": "cd probes/rsc && bun install --frozen-lockfile && bun probe.tsx && cd ../rpc && bun install --frozen-lockfile && bun probe.tsx",
    "build": "bun src/cli.ts build",
    "dev": "bun src/cli.ts dev",
    "check": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:pty": "python3 scripts/pty-smoke.py",
    "verify": "bun run check && bun run lint && bun run format:check && bun test --timeout 20000 && bun run build",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "@typescript/typescript6": "6.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-reconciler": "0.34.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0"
  },
  "overrides": {
    "react-reconciler": "0.34.0"
  }
}
